    # ------------- catalogs -------------
    def _populate_catalogs(self) -> None:
        catalogs = getattr(self.ctx, "catalogs", None)

        mats: List[str] = []
        edges: List[str] = []

        try:
            if catalogs and hasattr(catalogs, "get_materials"):
                mats = [getattr(x, "name", str(x)) for x in catalogs.get_materials()]
        except Exception:
            mats = []

        try:
            if catalogs and hasattr(catalogs, "get_edges"):
                edges = [getattr(x, "name", str(x)) for x in catalogs.get_edges()]
        except Exception:
            edges = []

        def fill(cb: QtWidgets.QComboBox, placeholder: str, items: List[str]):
            cur = cb.currentText()
            cb.blockSignals(True)
            try:
                cb.clear()
                cb.addItem(placeholder)
                for it in items:
                    cb.addItem(it)
                idx = cb.findText(cur)
                if idx >= 0:
                    cb.setCurrentIndex(idx)
            finally:
                cb.blockSignals(False)

        fill(self.cb_mat_carcass, "Płyta wiórowa 18 mm (domyślnie)", mats)
        fill(self.cb_front_mat, "MDF 18 mm (domyślnie)", mats)
        fill(self.cb_back_mat, "HDF 3 mm (domyślnie)", mats)
        fill(self.cb_q_material, "— wybierz materiał —", mats)
        fill(self.cb_q_edge, "ABS 0.8 (domyślnie)", edges)

    # ---------------- state ----------------
    def _load_state(self) -> None:
        s = self.settings
        s.beginGroup("module")
        try:
            self.in_W.setValue(float(s.value("W", 600.0)))
            self.in_H.setValue(float(s.value("H", 720.0)))
            self.in_D.setValue(float(s.value("D", 560.0)))

            anc = str(s.value("anchor", "None"))
            idx = self.cb_anchor.findText(anc)
            if idx >= 0:
                self.cb_anchor.setCurrentIndex(idx)

            self.in_offx.setValue(float(s.value("offx", 0.0)))
            self.in_offy.setValue(float(s.value("offy", 0.0)))

            fm = str(s.value("front_mode", "Drzwi"))
            idx = self.cb_front_mode.findText(fm)
            if idx >= 0:
                self.cb_front_mode.setCurrentIndex(idx)

            self.in_front_count.setValue(int(s.value("front_count", 2)))
            self.in_front_gap.setValue(float(s.value("front_gap", 2.0)))
            self.in_front_side.setValue(float(s.value("front_side_offset", 2.0)))

            hm = str(s.value("front_hmode", "Na całą wysokość"))
            idx = self.cb_front_hmode.findText(hm)
            if idx >= 0:
                self.cb_front_hmode.setCurrentIndex(idx)

            self.in_thick.setValue(float(s.value("thick", 18.0)))
            self.ck_back.setChecked(str(s.value("back_enabled", "true")).lower() in ("1", "true", "tak", "yes"))
            self.in_back_thick.setValue(float(s.value("back_thick", 3.0)))

            self.ck_middle.setChecked(str(s.value("middle_wall", "false")).lower() in ("1", "true", "tak", "yes"))
            self.in_shelves.setValue(int(s.value("shelves_count", 0)))
            self.ck_split_shelves.setChecked(str(s.value("shelves_split", "true")).lower() in ("1", "true", "tak", "yes"))

            self.in_qty.setValue(int(s.value("qty", 1)))

            sel = str(s.value("selected_key", "side_left"))
            self.selected_key = sel
        finally:
            s.endGroup()

    def _save_state(self) -> None:
        s = self.settings
        s.beginGroup("module")
        try:
            s.setValue("W", self.in_W.value())
            s.setValue("H", self.in_H.value())
            s.setValue("D", self.in_D.value())
            s.setValue("anchor", self.cb_anchor.currentText())
            s.setValue("offx", self.in_offx.value())
            s.setValue("offy", self.in_offy.value())

            s.setValue("front_mode", self.cb_front_mode.currentText())
            s.setValue("front_count", self.in_front_count.value())
            s.setValue("front_gap", self.in_front_gap.value())
            s.setValue("front_side_offset", self.in_front_side.value())
            s.setValue("front_hmode", self.cb_front_hmode.currentText())

            s.setValue("thick", self.in_thick.value())
            s.setValue("back_enabled", "true" if self.ck_back.isChecked() else "false")
            s.setValue("back_thick", self.in_back_thick.value())
            s.setValue("middle_wall", "true" if self.ck_middle.isChecked() else "false")
            s.setValue("shelves_count", self.in_shelves.value())
            s.setValue("shelves_split", "true" if self.ck_split_shelves.isChecked() else "false")
            s.setValue("qty", self.in_qty.value())

            s.setValue("selected_key", self.selected_key)
        finally:
            s.endGroup()

    def closeEvent(self, e) -> None:
        try:
            self._save_state()
        except Exception:
            pass
        super().closeEvent(e)

    # ---------------- rebuild parts ----------------
    def _rebuild_parts(self) -> None:
        W = float(self.in_W.value())
        H = float(self.in_H.value())
        D = float(self.in_D.value())
        t = float(self.in_thick.value())
        back_on = bool(self.ck_back.isChecked())
        mw_on = bool(self.ck_middle.isChecked())
        shelves = int(self.in_shelves.value())
        split = bool(self.ck_split_shelves.isChecked())

        carcass_mat = self.cb_mat_carcass.currentText().strip()
        if self.cb_mat_carcass.currentIndex() == 0:
            carcass_mat = "Płyta wiórowa 18 mm"
        back_mat = self.cb_back_mat.currentText().strip()
        if self.cb_back_mat.currentIndex() == 0:
            back_mat = "HDF 3 mm"
        front_mat = self.cb_front_mat.currentText().strip()
        if self.cb_front_mat.currentIndex() == 0:
            front_mat = "MDF 18 mm"

        # internal dims
        iW = max(0.0, W - 2 * t)
        iH = max(0.0, H - 2 * t)

        parts: Dict[str, Part] = {}

        parts["side_left"] = self.parts.get("side_left", Part("side_left", "Bok lewy", D, H, carcass_mat))
        parts["side_right"] = self.parts.get("side_right", Part("side_right", "Bok prawy", D, H, carcass_mat))
        parts["top"] = self.parts.get("top", Part("top", "Wieniec góra", iW, D, carcass_mat))
        parts["bottom"] = self.parts.get("bottom", Part("bottom", "Wieniec dół", iW, D, carcass_mat))

        if back_on:
            parts["back"] = self.parts.get("back", Part("back", "Plecy", W, H, back_mat))
        if mw_on:
            parts["middle"] = self.parts.get("middle", Part("middle", "Przegroda", D, iH, carcass_mat))

        if shelves > 0:
            for i in range(1, shelves + 1):
                key = f"shelf_{i}"
                if mw_on and split:
                    keyL = f"{key}_L"
                    keyR = f"{key}_R"
                    w_half = max(0.0, (iW - t) / 2.0)
                    parts[keyL] = self.parts.get(keyL, Part(keyL, f"Półka {i} (lewa)", w_half, D, carcass_mat))
                    parts[keyR] = self.parts.get(keyR, Part(keyR, f"Półka {i} (prawa)", w_half, D, carcass_mat))
                else:
                    parts[key] = self.parts.get(key, Part(key, f"Półka {i}", iW, D, carcass_mat))

        # front panels -> only for BOM and clickable rectangles in Front view
        mode = self.cb_front_mode.currentText()
        n = int(self.in_front_count.value())
        gap = float(self.in_front_gap.value())
        side_off = float(self.in_front_side.value())
        hmode = self.cb_front_hmode.currentText()

        if mode != "Brak":
            openH = H if hmode == "Na całą wysokość" else max(0.0, H - 2 * t)
            if mode == "Drzwi":
                availW = max(0.0, W - 2 * side_off)
                panelW = max(0.0, (availW - gap * (n - 1)) / max(1, n))
                for i in range(1, n + 1):
                    k = f"front_{i}"
                    parts[k] = self.parts.get(k, Part(k, f"Front {i}", panelW, openH, front_mat))
            else:
                availW = max(0.0, W - 2 * side_off)
                availH = max(0.0, openH)
                panelH = max(0.0, (availH - gap * (n - 1)) / max(1, n))
                for i in range(1, n + 1):
                    k = f"front_{i}"
                    parts[k] = self.parts.get(k, Part(k, f"Front {i}", availW, panelH, front_mat))

        # Update dims for stable parts while keeping edges/material
        for p in parts.values():
            if p.key in ("side_left", "side_right"):
                p.w_mm, p.h_mm = D, H
                if not p.material:
                    p.material = carcass_mat
            elif p.key in ("top", "bottom"):
                p.w_mm, p.h_mm = iW, D
                if not p.material:
                    p.material = carcass_mat
            elif p.key == "back":
                p.w_mm, p.h_mm = W, H
                if not p.material:
                    p.material = back_mat
            elif p.key == "middle":
                p.w_mm, p.h_mm = D, iH
                if not p.material:
                    p.material = carcass_mat
            elif p.key.startswith("shelf_"):
                if not p.material:
                    p.material = carcass_mat
            elif p.key.startswith("front_"):
                if not p.material:
                    p.material = front_mat

        self.parts = parts

        if self.selected_key not in self.parts:
            self.selected_key = "side_left" if "side_left" in self.parts else next(iter(self.parts.keys()))

    # ---------------- Scene + selection ----------------
    def _scene_selection_changed(self):
        sel = self.scene.selectedItems()
        if not sel:
            return
        it = sel[0]
        if isinstance(it, PartRectItem):
            self._select_part(it.part_key)

    def _select_part(self, key: str) -> None:
        if key not in self.parts:
            return
        self.selected_key = key
        self._refresh_scene()
        self._refresh_quick_panel()
        self._save_state()

    def _refresh_scene(self) -> None:
        self.scene.clear()

        W = float(self.in_W.value())
        H = float(self.in_H.value())
        D = float(self.in_D.value())
        t = float(self.in_thick.value())

        mw_on = bool(self.ck_middle.isChecked())
        shelves = int(self.in_shelves.value())
        split = bool(self.ck_split_shelves.isChecked())

        # Layout: Front view on top, Top view below, same scale s
        # We fit BOTH into a virtual canvas
        canvas_w = 780.0
        canvas_h = 720.0
        pad = 28.0
        gap_y = 60.0

        # compute scale based on maximum extents among (W,H) and (W,D)
        # total height needed in scene units: H + D + gap_y_mm_equiv (we use pixels so gap_y is px)
        # We'll scale mm -> px with s
        # Choose s to fit width and height.
        avail_w = canvas_w - 2 * pad
        avail_h = canvas_h - 2 * pad - gap_y

        # s limited by width: W must fit
        s_w = avail_w / max(1.0, W)
        # s limited by height: H + D must fit
        s_h = avail_h / max(1.0, (H + D))

        s = min(s_w, s_h)

        # Positions
        front_x = pad
        front_y = pad
        top_x = pad
        top_y = pad + H * s + gap_y

        # Scene rect
        self.scene.setSceneRect(0, 0, canvas_w, canvas_h)

        # Titles
        self._add_text(front_x, front_y - 10, "Front view", 12, bold=True)
        self._add_text(top_x, top_y - 10, "Top view", 12, bold=True)

        # Front outline (W x H)
        self._add_outline(front_x, front_y, W * s, H * s)

        # Top outline (W x D)
        self._add_outline(top_x, top_y, W * s, D * s)

        # carcass strips in FRONT
        strip = max(2.0, t * s)
        self._add_part_rect("side_left", front_x, front_y, strip, H * s)
        self._add_part_rect("side_right", front_x + W * s - strip, front_y, strip, H * s)
        self._add_part_rect("top", front_x + strip, front_y, W * s - 2 * strip, strip)
        self._add_part_rect("bottom", front_x + strip, front_y + H * s - strip, W * s - 2 * strip, strip)

        # middle wall in FRONT
        if mw_on and "middle" in self.parts:
            xmid = front_x + (W * s) / 2.0 - (strip / 2.0)
            self._add_part_rect("middle", xmid, front_y + strip, strip, H * s - 2 * strip)

        # shelves in FRONT
        if shelves > 0:
            shelf_h = max(2.0, strip * 0.55)
            for i in range(1, shelves + 1):
                y = front_y + (H * s) * (i / (shelves + 1))
                if mw_on and split:
                    xmid = front_x + (W * s) / 2.0
                    kL = f"shelf_{i}_L"
                    kR = f"shelf_{i}_R"
                    self._add_part_rect(kL, front_x + strip, y - shelf_h / 2, (xmid - (front_x + strip)) - strip / 2, shelf_h)
                    self._add_part_rect(kR, xmid + strip / 2, y - shelf_h / 2, (front_x + W * s - strip) - (xmid + strip / 2), shelf_h)
                else:
                    k = f"shelf_{i}"
                    self._add_part_rect(k, front_x + strip, y - shelf_h / 2, W * s - 2 * strip, shelf_h)

        # front panels (rects) in FRONT
        mode = self.cb_front_mode.currentText()
        n = int(self.in_front_count.value())
        gap = float(self.in_front_gap.value())
        side_off = float(self.in_front_side.value())
        hmode = self.cb_front_hmode.currentText()
        openH = H if hmode == "Na całą wysokość" else max(0.0, H - 2 * t)

        if mode != "Brak":
            xF = front_x + side_off * s
            yF = front_y + (0 if hmode == "Na całą wysokość" else t * s)
            wF = max(0.0, (W - 2 * side_off) * s)
            hF = max(0.0, openH * s)

            if mode == "Drzwi":
                pw = (wF - gap * s * (n - 1)) / max(1, n)
                x = xF
                for i in range(1, n + 1):
                    k = f"front_{i}"
                    self._add_part_rect(k, x, yF, max(0.0, pw), hF, radius=6)
                    x += pw + gap * s
            else:
                ph = (hF - gap * s * (n - 1)) / max(1, n)
                y = yF
                for i in range(1, n + 1):
                    k = f"front_{i}"
                    self._add_part_rect(k, xF, y, wF, max(0.0, ph), radius=6)
                    y += ph + gap * s

        # TOP view - show middle wall as strip
        strip2 = max(2.0, t * s)
        if mw_on and "middle" in self.parts:
            xmid = top_x + (W * s) / 2.0 - (strip2 / 2.0)
            self._add_part_rect("middle", xmid, top_y, strip2, D * s)

        # ---- Dimensioning (jak chciałeś) ----
        # Front: W (bottom) and H (right)
        self._dim_horizontal(front_x, front_y + H * s + 18, front_x + W * s, front_y + H * s + 18, f"W {W:.0f} mm")
        self._dim_vertical(front_x + W * s + 18, front_y, front_x + W * s + 18, front_y + H * s, f"H {H:.0f} mm")

        # Top: D only (right side)
        self._dim_vertical(top_x + W * s + 18, top_y, top_x + W * s + 18, top_y + D * s, f"D {D:.0f} mm")

        # Fit in view
        self.view.fitInView(self.scene.sceneRect(), QtCore.Qt.AspectRatioMode.KeepAspectRatio)

    def _add_outline(self, x: float, y: float, w: float, h: float) -> None:
        it = QtWidgets.QGraphicsRectItem(x, y, w, h)
        it.setPen(QtGui.QPen(QtGui.QColor("#111827"), 1.2))
        self.scene.addItem(it)

    def _add_text(self, x: float, y: float, text: str, size: int = 12, bold: bool = False) -> None:
        t = self.scene.addText(text, QtGui.QFont("Segoe UI", size, QtGui.QFont.Weight.Bold if bold else QtGui.QFont.Weight.Normal))
        t.setDefaultTextColor(QtGui.QColor("#111827"))
        t.setPos(x, y)

    def _add_part_rect(self, key: str, x: float, y: float, w: float, h: float, radius: int = 8):
        if key not in self.parts:
            return
        item = PartRectItem(key, x, y, w, h)
        item.setToolTip(self.parts[key].name_pl)
        item.set_selected(key == self.selected_key)
        self.scene.addItem(item)

    def _dim_horizontal(self, x1: float, y1: float, x2: float, y2: float, label: str) -> None:
        # extension lines
        pen = QtGui.QPen(QtGui.QColor("#334155"), 1.2)
        self.scene.addLine(x1, y1 - 6, x1, y1 + 6, pen)
        self.scene.addLine(x2, y2 - 6, x2, y2 + 6, pen)
        # main line
        self.scene.addLine(x1, y1, x2, y2, pen)
        # arrows
        self._arrow_head(x1, y1, "L")
        self._arrow_head(x2, y2, "R")
        # label
        self._add_text((x1 + x2) / 2 - 28, y1 + 4, label, 11, bold=False)

    def _dim_vertical(self, x1: float, y1: float, x2: float, y2: float, label: str) -> None:
        pen = QtGui.QPen(QtGui.QColor("#334155"), 1.2)
        self.scene.addLine(x1 - 6, y1, x1 + 6, y1, pen)
        self.scene.addLine(x2 - 6, y2, x2 + 6, y2, pen)
        self.scene.addLine(x1, y1, x2, y2, pen)
        self._arrow_head(x1, y1, "U")
        self._arrow_head(x2, y2, "D")
        self._add_text(x1 + 6, (y1 + y2) / 2 - 8, label, 11, bold=False)

    def _arrow_head(self, x: float, y: float, dir_: str) -> None:
        # simple small "V" arrow head
        pen = QtGui.QPen(QtGui.QColor("#334155"), 1.2)
        a = 6.0
        if dir_ == "L":
            self.scene.addLine(x, y, x + a, y - a / 2, pen)
            self.scene.addLine(x, y, x + a, y + a / 2, pen)
        elif dir_ == "R":
            self.scene.addLine(x, y, x - a, y - a / 2, pen)
            self.scene.addLine(x, y, x - a, y + a / 2, pen)
        elif dir_ == "U":
            self.scene.addLine(x, y, x - a / 2, y + a, pen)
            self.scene.addLine(x, y, x + a / 2, y + a, pen)
        elif dir_ == "D":
            self.scene.addLine(x, y, x - a / 2, y - a, pen)
            self.scene.addLine(x, y, x + a / 2, y - a, pen)

    # ---------------- Quick panel ----------------
    def _get_selected_part(self) -> Optional[Part]:
        return self.parts.get(self.selected_key)

    def _refresh_quick_panel(self) -> None:
        p = self._get_selected_part()
        if not p:
            self.lbl_selected.setText("Selected: —")
            return

        self.lbl_selected.setText(f"Selected: {p.name_pl}")

        cur_mat = p.material or ""
        idx = self.cb_q_material.findText(cur_mat)
        if idx >= 0:
            self.cb_q_material.blockSignals(True)
            self.cb_q_material.setCurrentIndex(idx)
            self.cb_q_material.blockSignals(False)

        self.val_L.setText(p.edges.L or "—")
        self.val_P.setText(p.edges.P or "—")
        self.val_G.setText(p.edges.G or "—")
        self.val_D.setText(p.edges.D or "—")

    def _apply_quick_material(self) -> None:
        p = self._get_selected_part()
        if not p:
            return
        if self.cb_q_material.currentIndex() <= 0:
            return
        p.material = self.cb_q_material.currentText()
        self._refresh_bom()

    def _current_edge_type(self) -> str:
        if self.cb_q_edge.currentIndex() <= 0:
            return ""
        return self.cb_q_edge.currentText()

    def _set_edge_side(self, side: str) -> None:
        p = self._get_selected_part()
        if not p:
            return
        typ = self._current_edge_type()
        if side == "L":
            p.edges.L = typ
        elif side == "P":
            p.edges.P = typ
        elif side == "G":
            p.edges.G = typ
        elif side == "D":
            p.edges.D = typ
        self._refresh_quick_panel()
        self._refresh_bom()

    def _clear_edges_selected(self) -> None:
        p = self._get_selected_part()
        if not p:
            return
        p.edges = EdgeMap()
        self._refresh_quick_panel()
        self._refresh_bom()

    def _apply_edge_to_all_sides_selected(self) -> None:
        p = self._get_selected_part()
        if not p:
            return
        typ = self._current_edge_type()
        p.edges = EdgeMap(L=typ, P=typ, G=typ, D=typ)
        self._refresh_quick_panel()
        self._refresh_bom()

    def _apply_preset_edge(self, needle: str) -> None:
        p = self._get_selected_part()
        if not p:
            return
        target = ""
        for i in range(1, self.cb_q_edge.count()):
            t = self.cb_q_edge.itemText(i)
            if needle in t:
                target = t
                break
        if not target and self.cb_q_edge.count() > 1:
            target = self.cb_q_edge.itemText(1)
        p.edges = EdgeMap(L=target, P=target, G=target, D=target)
        self._refresh_quick_panel()
        self._refresh_bom()

    # ---------------- BOM ----------------
    def _refresh_bom(self) -> None:
        mats: Dict[str, float] = {}
        edges: Dict[str, float] = {}

        for part in self.parts.values():
            mat = (part.material or "").strip() or "— (brak materiału)"
            area = mm2_to_m2(part.w_mm * part.h_mm)
            mats[mat] = mats.get(mat, 0.0) + area

            # edges by type
            if part.edges.L:
                edges[part.edges.L] = edges.get(part.edges.L, 0.0) + mm_to_m(part.h_mm)
            if part.edges.P:
                edges[part.edges.P] = edges.get(part.edges.P, 0.0) + mm_to_m(part.h_mm)
            if part.edges.G:
                edges[part.edges.G] = edges.get(part.edges.G, 0.0) + mm_to_m(part.w_mm)
            if part.edges.D:
                edges[part.edges.D] = edges.get(part.edges.D, 0.0) + mm_to_m(part.w_mm)

        qty = int(self.in_qty.value())
        self.lbl_parts.setText(f"parts: {len(self.parts)}   |   qty: {qty}")

        lines: List[str] = []
        lines.append("Materiały (m²) — na 1 moduł")
        for k in sorted(mats.keys()):
            lines.append(f"- {k}: {mats[k]:.3f} m²")
        lines.append("")
        lines.append("Okleina (m) — na 1 moduł")
        if edges:
            for k in sorted(edges.keys()):
                lines.append(f"- {k}: {edges[k]:.3f} m")
        else:
            lines.append("- (brak)")
        lines.append("")
        lines.append(f"RAZEM x{qty}")
        for k in sorted(mats.keys()):
            lines.append(f"- {k}: {mats[k] * qty:.3f} m²")
        if edges:
            for k in sorted(edges.keys()):
                lines.append(f"- {k}: {edges[k] * qty:.3f} m")

        self.txt_bom.setPlainText("\n".join(lines))

    # ---------------- actions ----------------
    def _on_reset(self) -> None:
        self.in_W.setValue(600.0)
        self.in_H.setValue(720.0)
        self.in_D.setValue(560.0)
        self.cb_anchor.setCurrentIndex(0)
        self.in_offx.setValue(0.0)
        self.in_offy.setValue(0.0)

        self.cb_front_mode.setCurrentIndex(0)
        self.in_front_count.setValue(2)
        self.in_front_gap.setValue(2.0)
        self.in_front_side.setValue(2.0)
        self.cb_front_hmode.setCurrentIndex(0)

        self.in_thick.setValue(18.0)
        self.ck_back.setChecked(True)
        self.in_back_thick.setValue(3.0)
        self.ck_middle.setChecked(False)
        self.in_shelves.setValue(0)
        self.ck_split_shelves.setChecked(True)
        self.in_qty.setValue(1)

        self.parts = {}
        self.selected_key = "side_left"
        self._on_recalc()

    def _on_recalc(self) -> None:
        self._rebuild_parts()
        self._refresh_scene()
        self._refresh_quick_panel()
        self._refresh_bom()
        try:
            self._save_state()
        except Exception:
            pass
