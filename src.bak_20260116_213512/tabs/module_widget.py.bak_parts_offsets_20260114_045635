        super().__init__(parent)
        self.ctx = ctx
        self.settings: QSettings = getattr(ctx, "settings", QSettings("TECH_modul", "TECH_modul_qt"))

        self.parts: Dict[str, Part] = {}
        self.selected_key: str = "side_left"

        self._build_ui()
        self._populate_catalogs()
        self._load_state()

        self._rebuild_parts()
        self._refresh_scene()
        self._refresh_quick_panel()
        self._refresh_bom()

        # refresh after catalogs update
        bus = getattr(self.ctx, "bus", None)
        sig = getattr(bus, "data_changed", None)
        if sig is not None and hasattr(sig, "connect"):
            try:
                sig.connect(self._on_data_changed)
            except Exception:
                pass

    @QtCore.Slot(object)
    def _on_data_changed(self, key: object) -> None:
        if str(key) == "catalogs":
            self._populate_catalogs()

