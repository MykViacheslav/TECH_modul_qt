    # ------------- vertical length helpers -------------
    def _vertical_len_and_y(self, H: float, L: float, pos_text: str) -> Tuple[float, float]:
        """
        Zwraca (len_mm, start_y_mm) dla pionu.
        L==0 -> pełna wysokość.
        pos: "Od góry"/"Od dołu"
        """
        if L <= 0:
            return H, 0.0
        L = min(L, H)
        if pos_text == "Od dołu":
            return L, H - L
        return L, 0.0

    # ---------------- rebuild parts ----------------
    def _rebuild_parts(self) -> None:
        W = float(self.in_W.value())
        H = float(self.in_H.value())
        D = float(self.in_D.value())
        t = float(self.in_thick.value())

        has_L = bool(self.ck_side_left.isChecked())
        has_R = bool(self.ck_side_right.isChecked())
        has_T = bool(self.ck_top.isChecked())
        has_B = bool(self.ck_bottom.isChecked())

        front_enabled = bool(self.ck_front.isChecked())
        back_on = bool(self.ck_back.isChecked())
        mw_on = bool(self.ck_middle.isChecked())
        shelves_enabled = bool(self.ck_shelves.isChecked())
        shelves = int(self.in_shelves.value()) if shelves_enabled else 0
        split = bool(self.ck_split_shelves.isChecked())

        carcass_mat = self.cb_mat_carcass.currentText().strip()
        if self.cb_mat_carcass.currentIndex() == 0:
            carcass_mat = "Płyta wiórowa 18 mm"
        back_mat = self.cb_back_mat.currentText().strip()
        if self.cb_back_mat.currentIndex() == 0:
            back_mat = "HDF 3 mm"
        front_mat = self.cb_front_mat.currentText().strip()
        if self.cb_front_mat.currentIndex() == 0:
            front_mat = "MDF 18 mm"

        iW = W - (t if has_L else 0.0) - (t if has_R else 0.0)
        iH = H - (t if has_T else 0.0) - (t if has_B else 0.0)
        iW = max(0.0, iW)
        iH = max(0.0, iH)

        parts: Dict[str, Part] = {}

        def ensure_part(key: str, name: str, wmm: float, hmm: float, default_mat: str):
            old = self.parts.get(key)
            if old is None:
                parts[key] = Part(key, name, wmm, hmm, default_mat)
            else:
                old.name_pl = name
                old.w_mm, old.h_mm = wmm, hmm
                if not old.material:
                    old.material = default_mat
                parts[key] = old

        # długości pionów
        L_left, _ = self._vertical_len_and_y(H, float(self.in_len_side_left.value()), self.cb_len_side_left_pos.currentText())
        L_right, _ = self._vertical_len_and_y(H, float(self.in_len_side_right.value()), self.cb_len_side_right_pos.currentText())
        L_mid, _ = self._vertical_len_and_y(iH, float(self.in_len_middle.value()) if mw_on else 0.0, self.cb_len_middle_pos.currentText())

        if has_L:
            ensure_part("side_left", "Bok lewy", D, L_left, carcass_mat)
        if has_R:
            ensure_part("side_right", "Bok prawy", D, L_right, carcass_mat)
        if has_T:
            ensure_part("top", "Wieniec góra", iW, D, carcass_mat)
        if has_B:
            ensure_part("bottom", "Wieniec dół", iW, D, carcass_mat)

        if back_on:
            ensure_part("back", "Plecy", W, H, back_mat)

        if mw_on:
            ensure_part("middle", "Środkowa ścianka", D, L_mid, carcass_mat)

        if shelves > 0:
            for i in range(1, shelves + 1):
                if mw_on and split:
                    w_half = max(0.0, (iW - t) / 2.0)
                    ensure_part(f"shelf_{i}_L", f"Półka {i} (lewa)", w_half, D, carcass_mat)
                    ensure_part(f"shelf_{i}_R", f"Półka {i} (prawa)", w_half, D, carcass_mat)
                else:
                    ensure_part(f"shelf_{i}", f"Półka {i}", iW, D, carcass_mat)

        # front panels
        if front_enabled:
            mode = self.cb_front_mode.currentText()
            n = int(self.in_front_count.value())
            gap = float(self.in_front_gap.value())
            side_off = float(self.in_front_side.value())
            hmode = self.cb_front_hmode.currentText()

            if mode != "Brak":
                openH = H if hmode == "Na całą wysokość" else max(0.0, H - (t if has_T else 0.0) - (t if has_B else 0.0))

                if mode == "Drzwi":
                    availW = max(0.0, W - 2 * side_off)
                    panelW = max(0.0, (availW - gap * (n - 1)) / max(1, n))
                    for i in range(1, n + 1):
                        ensure_part(f"front_{i}", f"Front {i}", panelW, openH, front_mat)
                else:
                    availW = max(0.0, W - 2 * side_off)
                    availH = max(0.0, openH)
                    panelH = max(0.0, (availH - gap * (n - 1)) / max(1, n))
                    for i in range(1, n + 1):
                        ensure_part(f"front_{i}", f"Front {i}", availW, panelH, front_mat)

        self.parts = parts
        if self.selected_key not in self.parts:
            self.selected_key = next(iter(self.parts.keys()), "side_left")

    # ---------------- drawing ----------------
    def _refresh_scene(self) -> None:
        self.scene.clear()

        W = float(self.in_W.value())
        H = float(self.in_H.value())
        D = float(self.in_D.value())
        t = float(self.in_thick.value())
        back_t = float(self.in_back_thick.value())

        has_L = bool(self.ck_side_left.isChecked())
        has_R = bool(self.ck_side_right.isChecked())
        has_T = bool(self.ck_top.isChecked())
        has_B = bool(self.ck_bottom.isChecked())

        front_enabled = bool(self.ck_front.isChecked())
        back_on = bool(self.ck_back.isChecked())

        mw_on = bool(self.ck_middle.isChecked())
        shelves_enabled = bool(self.ck_shelves.isChecked())
        shelves = int(self.in_shelves.value()) if shelves_enabled else 0
        split = bool(self.ck_split_shelves.isChecked())

        # offsets in mm
        off_mm = {
            "side_left": (float(self.off_side_left_x.value()), float(self.off_side_left_y.value())),
            "side_right": (float(self.off_side_right_x.value()), float(self.off_side_right_y.value())),
            "top": (float(self.off_top_x.value()), float(self.off_top_y.value())),
            "bottom": (float(self.off_bottom_x.value()), float(self.off_bottom_y.value())),
            "front": (float(self.off_front_x.value()), float(self.off_front_y.value())),
            "back": (float(self.off_back_x.value()), float(self.off_back_y.value())),
            "middle": (float(self.off_middle_x.value()), float(self.off_middle_y.value())),
            "shelves": (float(self.off_shelves_x.value()), float(self.off_shelves_y.value())),
        }

        canvas_w = 780.0
        canvas_h = 720.0
        pad = 28.0
        gap_y = 60.0

        avail_w = canvas_w - 2 * pad
        avail_h = canvas_h - 2 * pad - gap_y

        s_w = avail_w / max(1.0, W)
        s_h = avail_h / max(1.0, (H + D))
        s = min(s_w, s_h)

        front_x = pad
        front_y = pad
        top_x = pad
        top_y = pad + H * s + gap_y

        self.scene.setSceneRect(0, 0, canvas_w, canvas_h)

        self._add_outline(front_x, front_y, W * s, H * s)
        self._add_outline(top_x, top_y, W * s, D * s)

        strip = max(2.0, t * s)
        strip_back = max(2.0, back_t * s)

        def off_px(key: str):
            dx_mm, dy_mm = off_mm[key]
            return dx_mm * s, dy_mm * s

        # piony length + start
        L_left, y_left_mm = self._vertical_len_and_y(H, float(self.in_len_side_left.value()), self.cb_len_side_left_pos.currentText())
        L_right, y_right_mm = self._vertical_len_and_y(H, float(self.in_len_side_right.value()), self.cb_len_side_right_pos.currentText())

        # left side
        if has_L and "side_left" in self.parts:
            dx, dy = off_px("side_left")
            self._add_part_rect("side_left", front_x + dx, front_y + (y_left_mm * s) + dy, strip, L_left * s)

        # right side
        if has_R and "side_right" in self.parts:
            dx, dy = off_px("side_right")
            self._add_part_rect("side_right", front_x + W * s - strip + dx, front_y + (y_right_mm * s) + dy, strip, L_right * s)

        # top
        if has_T and "top" in self.parts:
            dx, dy = off_px("top")
            left_in = strip if has_L else 0.0
            right_in = strip if has_R else 0.0
            self._add_part_rect("top", front_x + left_in + dx, front_y + dy, W * s - left_in - right_in, strip)

        # bottom
        if has_B and "bottom" in self.parts:
            dx, dy = off_px("bottom")
            left_in = strip if has_L else 0.0
            right_in = strip if has_R else 0.0
            self._add_part_rect("bottom", front_x + left_in + dx, front_y + H * s - strip + dy, W * s - left_in - right_in, strip)

        # middle wall length + start (wewnętrzna wysokość)
        if mw_on and "middle" in self.parts:
            top_in = strip if has_T else 0.0
            bot_in = strip if has_B else 0.0
            innerH_mm = max(0.0, H - (t if has_T else 0.0) - (t if has_B else 0.0))
            L_mid, y_mid_mm = self._vertical_len_and_y(innerH_mm, float(self.in_len_middle.value()), self.cb_len_middle_pos.currentText())
            dxm, dym = off_px("middle")
            xmid = front_x + (W * s) / 2.0 - (strip / 2.0) + dxm
            self._add_part_rect("middle", xmid, front_y + top_in + (y_mid_mm * s) + dym, strip, max(0.0, L_mid * s))

        # shelves
        if shelves > 0:
            dxs, dys = off_px("shelves")
            shelf_h = max(2.0, strip * 0.55)
            for i in range(1, shelves + 1):
                y = front_y + (H * s) * (i / (shelves + 1)) + dys
                left_in = strip if has_L else 0.0
                right_in = strip if has_R else 0.0
                if mw_on and split:
                    xmid = front_x + (W * s) / 2.0 + dxs
                    kL = f"shelf_{i}_L"
                    kR = f"shelf_{i}_R"
                    if kL in self.parts:
                        self._add_part_rect(kL, front_x + left_in + dxs, y - shelf_h / 2, (xmid - (front_x + left_in)) - strip / 2, shelf_h)
                    if kR in self.parts:
                        self._add_part_rect(kR, xmid + strip / 2, y - shelf_h / 2, (front_x + W * s - right_in) - (xmid + strip / 2), shelf_h)
                else:
                    k = f"shelf_{i}"
                    if k in self.parts:
                        self._add_part_rect(k, front_x + left_in + dxs, y - shelf_h / 2, W * s - left_in - right_in, shelf_h)

        # front panels
        if front_enabled:
            mode = self.cb_front_mode.currentText()
            n = int(self.in_front_count.value())
            gap = float(self.in_front_gap.value())
            side_off = float(self.in_front_side.value())
            hmode = self.cb_front_hmode.currentText()
            dxf, dyf = off_px("front")

            if mode != "Brak":
                xF = front_x + side_off * s + dxf
                wF = max(0.0, (W - 2 * side_off) * s)

                if hmode == "Na całą wysokość":
                    yF = front_y + dyf
                    hF = max(0.0, H * s)
                else:
                    top_dy = off_px("top")[1] if has_T else 0.0
                    bot_dy = off_px("bottom")[1] if has_B else 0.0
                    top_inner_y = front_y + top_dy + (strip if has_T else 0.0)
                    bottom_inner_y = front_y + H * s + bot_dy - (strip if has_B else 0.0)
                    yF = top_inner_y + dyf
                    hF = max(0.0, bottom_inner_y - top_inner_y)

                if mode == "Drzwi":
                    pw = (wF - gap * s * (n - 1)) / max(1, n)
                    x = xF
                    for i in range(1, n + 1):
                        k = f"front_{i}"
                        if k in self.parts:
                            self._add_part_rect(k, x, yF, max(0.0, pw), hF, radius=6)
                        x += pw + gap * s
                else:
                    ph = (hF - gap * s * (n - 1)) / max(1, n)
                    y = yF
                    for i in range(1, n + 1):
                        k = f"front_{i}"
                        if k in self.parts:
                            self._add_part_rect(k, xF, y, wF, max(0.0, ph), radius=6)
                        y += ph + gap * s

        # back strip in top view
        if back_on and "back" in self.parts:
            dxb, dyb = off_px("back")
            self._add_part_rect("back", top_x + dxb, top_y + dyb, W * s, strip_back)

        # dimensions
        self._dim_horizontal(front_x, front_y + H * s + 18, front_x + W * s, front_y + H * s + 18, f"W {W:.0f} mm")
        self._dim_vertical(front_x + W * s + 18, front_y, front_x + W * s + 18, front_y + H * s, f"H {H:.0f} mm")
        self._dim_vertical(top_x + W * s + 18, top_y, top_x + W * s + 18, top_y + D * s, f"D {D:.0f} mm")

        self.view.fitInView(self.scene.sceneRect(), QtCore.Qt.AspectRatioMode.KeepAspectRatio)
        try:
            self.view.centerOn(self.scene.sceneRect().center())
        except Exception:
            pass

    def _add_outline(self, x: float, y: float, w: float, h: float) -> None:
        it = QtWidgets.QGraphicsRectItem(x, y, w, h)
        it.setPen(QtGui.QPen(QtGui.QColor("#111827"), 1.2))
        self.scene.addItem(it)

    def _add_part_rect(self, key: str, x: float, y: float, w: float, h: float, radius: int = 8):
        if key not in self.parts:
            return
        item = PartRectItem(key, x, y, w, h)
        item.setToolTip(self.parts[key].name_pl)
        item.set_selected(key == self.selected_key)
        self.scene.addItem(item)

    def _dim_horizontal(self, x1: float, y1: float, x2: float, y2: float, label: str) -> None:
        pen = QtGui.QPen(QtGui.QColor("#334155"), 1.2)
        self.scene.addLine(x1, y1 - 6, x1, y1 + 6, pen)
        self.scene.addLine(x2, y2 - 6, x2, y2 + 6, pen)
        self.scene.addLine(x1, y1, x2, y2, pen)

        t = self.scene.addText(label, QtGui.QFont("Segoe UI", 11))
        t.setDefaultTextColor(QtGui.QColor("#111827"))
        t.setPos((x1 + x2) / 2 - 34, y1 + 4)

    def _dim_vertical(self, x1: float, y1: float, x2: float, y2: float, label: str) -> None:
        pen = QtGui.QPen(QtGui.QColor("#334155"), 1.2)
        self.scene.addLine(x1 - 6, y1, x1 + 6, y1, pen)
        self.scene.addLine(x2 - 6, y2, x2 + 6, y2, pen)
        self.scene.addLine(x1, y1, x2, y2, pen)

        t = self.scene.addText(label, QtGui.QFont("Segoe UI", 11))
        t.setDefaultTextColor(QtGui.QColor("#111827"))
        t.setPos(x1 + 6, (y1 + y2) / 2 - 8)

    # ---------------- Quick panel ----------------
    def _get_selected_part(self) -> Optional[Part]:
        return self.parts.get(self.selected_key)

    def _refresh_quick_panel(self) -> None:
        p = self._get_selected_part()
        if not p:
            self.lbl_selected.setText("Selected: —")
            return
        self.lbl_selected.setText(f"Selected: {p.name_pl}")

        cur_mat = p.material or ""
        idx = self.cb_q_material.findText(cur_mat)
        if idx >= 0:
            self.cb_q_material.blockSignals(True)
            self.cb_q_material.setCurrentIndex(idx)
            self.cb_q_material.blockSignals(False)

        self.val_L.setText(p.edges.L or "—")
        self.val_P.setText(p.edges.P or "—")
        self.val_G.setText(p.edges.G or "—")
        self.val_D.setText(p.edges.D or "—")

    def _apply_quick_material(self) -> None:
        p = self._get_selected_part()
        if not p:
            return
        if self.cb_q_material.currentIndex() <= 0:
            return
        p.material = self.cb_q_material.currentText()
        self._refresh_bom()

    def _current_edge_type(self) -> str:
        if self.cb_q_edge.currentIndex() <= 0:
            return ""
        return self.cb_q_edge.currentText()

    def _set_edge_side(self, side: str) -> None:
        p = self._get_selected_part()
        if not p:
            return
        typ = self._current_edge_type()
        if side == "L":
            p.edges.L = typ
        elif side == "P":
            p.edges.P = typ
        elif side == "G":
            p.edges.G = typ
        elif side == "D":
            p.edges.D = typ
        self._refresh_quick_panel()
        self._refresh_bom()

    def _clear_edges_selected(self) -> None:
        p = self._get_selected_part()
        if not p:
            return
        p.edges = EdgeMap()
        self._refresh_quick_panel()
        self._refresh_bom()

    def _apply_edge_to_all_sides_selected(self) -> None:
        p = self._get_selected_part()
        if not p:
            return
        typ = self._current_edge_type()
        p.edges = EdgeMap(L=typ, P=typ, G=typ, D=typ)
        self._refresh_quick_panel()
        self._refresh_bom()

    def _apply_preset_edge(self, needle: str) -> None:
        p = self._get_selected_part()
        if not p:
            return
        target = ""
        for i in range(1, self.cb_q_edge.count()):
            t = self.cb_q_edge.itemText(i)
            if needle in t:
                target = t
                break
        if not target and self.cb_q_edge.count() > 1:
            target = self.cb_q_edge.itemText(1)
        p.edges = EdgeMap(L=target, P=target, G=target, D=target)
        self._refresh_quick_panel()
        self._refresh_bom()

    # ---------------- fittings logic ----------------
    def _calc_hinges_auto(self) -> int:
        """
        Prosta reguła:
        - do 900mm: 3 zawiasy
        - do 1600mm: 4 zawiasy
        - powyżej: 5 zawiasów
        liczymy per front_i
        """
        total = 0
        for k, p in self.parts.items():
            if k.startswith("front_"):
                h = float(p.h_mm)
                if h <= 900:
                    total += 3
                elif h <= 1600:
                    total += 4
                else:
                    total += 5
        return total

    def _calc_fittings(self) -> Dict[str, int]:
        shelves = int(self.in_shelves.value()) if self.ck_shelves.isChecked() else 0
        pins_per = int(self.in_shelf_pins_per_shelf.value())
        pins = max(0, shelves) * max(0, pins_per)

        hinges_override = int(self.in_hinges_override.value())
        if hinges_override > 0:
            hinges = hinges_override
        else:
            hinges = self._calc_hinges_auto() if self.ck_hinges_auto.isChecked() else 0

        return {
            "Zawiasy": max(0, hinges),
            "Nóżki": max(0, int(self.in_legs.value())),
            "Zawieszki": max(0, int(self.in_hangers.value())),
            "Podpórki półek": max(0, pins),
        }

    # ---------------- BOM ----------------
    def _refresh_bom(self) -> None:
        mats: Dict[str, float] = {}
        edges: Dict[str, float] = {}

        for part in self.parts.values():
            mat = (part.material or "").strip() or "— (brak materiału)"
            area = mm2_to_m2(part.w_mm * part.h_mm)
            mats[mat] = mats.get(mat, 0.0) + area

            if part.edges.L:
                edges[part.edges.L] = edges.get(part.edges.L, 0.0) + mm_to_m(part.h_mm)
            if part.edges.P:
                edges[part.edges.P] = edges.get(part.edges.P, 0.0) + mm_to_m(part.h_mm)
            if part.edges.G:
                edges[part.edges.G] = edges.get(part.edges.G, 0.0) + mm_to_m(part.w_mm)
            if part.edges.D:
                edges[part.edges.D] = edges.get(part.edges.D, 0.0) + mm_to_m(part.w_mm)

        fittings = self._calc_fittings()

        qty = int(self.in_qty.value())
        self.lbl_parts.setText(f"parts: {len(self.parts)}   |   qty: {qty}")

        lines: List[str] = []
        lines.append("Materiały (m²) — na 1 moduł")
        for k in sorted(mats.keys()):
            lines.append(f"- {k}: {mats[k]:.3f} m²")

        lines.append("")
        lines.append("Okleina (m) — na 1 moduł")
        if edges:
            for k in sorted(edges.keys()):
                lines.append(f"- {k}: {edges[k]:.3f} m")
        else:
            lines.append("- (brak)")

        lines.append("")
        lines.append("Okucia (szt) — na 1 moduł")
        for k in sorted(fittings.keys()):
            lines.append(f"- {k}: {fittings[k]} szt")

        lines.append("")
        lines.append(f"RAZEM x{qty}")
        for k in sorted(mats.keys()):
            lines.append(f"- {k}: {mats[k] * qty:.3f} m²")
        if edges:
            for k in sorted(edges.keys()):
                lines.append(f"- {k}: {edges[k] * qty:.3f} m")
        for k in sorted(fittings.keys()):
            lines.append(f"- {k}: {fittings[k] * qty} szt")

        self.txt_bom.setPlainText("\n".join(lines))

    def _current_bom_dict(self) -> Dict[str, Any]:
        # bardzo prosto: zbieramy z textu plus struktury
        mats: Dict[str, float] = {}
        edges: Dict[str, float] = {}
        for part in self.parts.values():
            mat = (part.material or "").strip() or "— (brak materiału)"
            area = mm2_to_m2(part.w_mm * part.h_mm)
            mats[mat] = mats.get(mat, 0.0) + area
            if part.edges.L:
                edges[part.edges.L] = edges.get(part.edges.L, 0.0) + mm_to_m(part.h_mm)
            if part.edges.P:
                edges[part.edges.P] = edges.get(part.edges.P, 0.0) + mm_to_m(part.h_mm)
            if part.edges.G:
                edges[part.edges.G] = edges.get(part.edges.G, 0.0) + mm_to_m(part.w_mm)
            if part.edges.D:
                edges[part.edges.D] = edges.get(part.edges.D, 0.0) + mm_to_m(part.w_mm)

        return {
            "materials_m2": mats,
            "edges_m": edges,
            "fittings": self._calc_fittings(),
            "qty": int(self.in_qty.value()),
        }

    # ---------------- DB actions ----------------
    def _save_to_db(self) -> None:
        name = (self.in_name.text() or "").strip()
        if not name:
            QtWidgets.QMessageBox.warning(self, "Błąd", "Podaj nazwę modułu.")
            return

        state = self._save_state()
        bom = self._current_bom_dict()

        try:
            self.library.upsert(ModuleRecord(name=name, state=state, bom=bom))
            QtWidgets.QMessageBox.information(self, "OK", "Zapisano moduł do bazy (data/modules.json).")
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Błąd", f"Nie udało się zapisać: {e}")

    def _load_from_db(self) -> None:
        names = self.library.list_names()
        if not names:
            QtWidgets.QMessageBox.information(self, "Info", "Baza jest pusta.")
            return

        name, ok = QtWidgets.QInputDialog.getItem(self, "Wczytaj moduł", "Wybierz moduł:", names, 0, False)
        if not ok or not name:
            return

        rec = self.library.get(name)
        if not rec:
            QtWidgets.QMessageBox.warning(self, "Błąd", "Nie znaleziono rekordu.")
            return

        st = rec.state or {}
        # minimalnie: wymiary + checkboxy + długości + okucia
        self.in_name.setText(str(st.get("name", name)))

        self.in_W.setValue(_safe_float(st.get("W", 600.0), 600.0))
        self.in_H.setValue(_safe_float(st.get("H", 720.0), 720.0))
        self.in_D.setValue(_safe_float(st.get("D", 560.0), 560.0))

        parts = (st.get("parts") or {})
        self.ck_side_left.setChecked(bool(parts.get("side_left", True)))
        self.ck_side_right.setChecked(bool(parts.get("side_right", True)))
        self.ck_top.setChecked(bool(parts.get("top", True)))
        self.ck_bottom.setChecked(bool(parts.get("bottom", True)))
        self.ck_front.setChecked(bool(parts.get("front", True)))
        self.ck_back.setChecked(bool(parts.get("back", True)))
        self.ck_middle.setChecked(bool(parts.get("middle", False)))
        self.ck_shelves.setChecked(bool(parts.get("shelves", True)))

        lengths = (st.get("lengths") or {})
        sl = lengths.get("side_left", {}) or {}
        sr = lengths.get("side_right", {}) or {}
        md = lengths.get("middle", {}) or {}

        self.cb_len_side_left_pos.setCurrentIndex(1 if str(sl.get("pos", "Od góry")) == "Od dołu" else 0)
        self.in_len_side_left.setValue(_safe_float(sl.get("L", 0.0)))
        self.cb_len_side_right_pos.setCurrentIndex(1 if str(sr.get("pos", "Od góry")) == "Od dołu" else 0)
        self.in_len_side_right.setValue(_safe_float(sr.get("L", 0.0)))
        self.cb_len_middle_pos.setCurrentIndex(1 if str(md.get("pos", "Od góry")) == "Od dołu" else 0)
        self.in_len_middle.setValue(_safe_float(md.get("L", 0.0)))

        fittings = (st.get("fittings") or {})
        self.ck_hinges_auto.setChecked(bool(fittings.get("hinges_auto", True)))
        self.in_hinges_override.setValue(_safe_int(fittings.get("hinges_override", 0), 0))
        self.in_legs.setValue(_safe_int(fittings.get("legs", 4), 4))
        self.in_hangers.setValue(_safe_int(fittings.get("hangers", 2), 2))
        self.in_shelf_pins_per_shelf.setValue(_safe_int(fittings.get("pins_per_shelf", 4), 4))

        self._on_recalc()
        QtWidgets.QMessageBox.information(self, "OK", "Wczytano moduł z bazy.")

    # ---------------- actions ----------------
