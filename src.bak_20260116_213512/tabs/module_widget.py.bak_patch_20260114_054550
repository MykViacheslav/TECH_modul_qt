    # Draw (Front + Top, one scene)
    # -----------------------------
    def _draw_dim(self, p: QtGui.QPainterPath, x1: float, y1: float, x2: float, y2: float, text: str) -> QtGui.QPainterPath:
        # simple dimension line with arrows (path only; text separately)
        p.moveTo(x1, y1)
        p.lineTo(x2, y2)
        return p

    def _refresh_scene(self) -> None:
        self.scene.blockSignals(True)
        try:
            self.scene.clear()

            W = float(self.in_W.value())
            H = float(self.in_H.value())
            D = float(self.in_D.value())
            t = float(self.in_thick.value())

            # layout: front view left, top view right
            gap = 80.0  # px-ish in scene units before scaling; we scale later via fitInView
            margin = 40.0

            # use mm as scene units; later fitInView will scale
            front_origin = QtCore.QPointF(0.0, 0.0)
            top_origin = QtCore.QPointF(W + gap, 0.0)

            # front outer
            front_rect = QtCore.QRectF(front_origin.x(), front_origin.y(), W, H)
            top_rect = QtCore.QRectF(top_origin.x(), top_origin.y(), W, D)

            # outer frames
            pen_outer = QtGui.QPen(QtGui.QColor("#0f172a"), 2.0)
            self.scene.addRect(front_rect, pen_outer)
            self.scene.addRect(top_rect, pen_outer)

            # helper draw part rect with selectable item
            def add_part(key: str, rect: QtCore.QRectF):
                if key not in self.parts:
                    return None
                it = PartRectItem(key, rect)
                it.set_selected(key == self.selected_key)
                self.scene.addItem(it)
                return it

            # offsets
            off = {
                "top": (self.off_top_x.value(), self.off_top_y.value()),
                "bottom": (self.off_bottom_x.value(), self.off_bottom_y.value()),
                "side_left": (self.off_side_left_x.value(), self.off_side_left_y.value()),
                "side_right": (self.off_side_right_x.value(), self.off_side_right_y.value()),
                "front": (self.off_front_x.value(), self.off_front_y.value()),
                "back": (self.off_back_x.value(), self.off_back_y.value()),
                "middle": (self.off_middle_x.value(), self.off_middle_y.value()),
                "shelves": (self.off_shelves_x.value(), self.off_shelves_y.value()),
            }

            has_L = self.ck_side_left.isChecked()
            has_R = self.ck_side_right.isChecked()
            has_T = self.ck_top.isChecked()
            has_B = self.ck_bottom.isChecked()
            middle_on = self.ck_middle.isChecked()

            # vertical len + y
            def vlen_and_y(totalH: float, L: float, pos_idx: int) -> Tuple[float, float]:
                if L <= 0:
                    return totalH, 0.0
                L = min(L, totalH)
                if pos_idx == 1:
                    return L, totalH - L
                return L, 0.0

            L_left, y_left = vlen_and_y(H, float(self.in_len_side_left.value()), self.cb_len_side_left_pos.currentIndex())
            L_right, y_right = vlen_and_y(H, float(self.in_len_side_right.value()), self.cb_len_side_right_pos.currentIndex())

            innerW = W - (t if has_L else 0) - (t if has_R else 0)
            innerH = H - (t if has_T else 0) - (t if has_B else 0)
            innerW = max(0.0, innerW)
            innerH = max(0.0, innerH)

            L_mid, y_mid = vlen_and_y(innerH, float(self.in_len_middle.value()), self.cb_len_middle_pos.currentIndex())

            # FRONT VIEW: parts projection
            # sides
            if has_L and "side_left" in self.parts:
                ox, oy = off["side_left"]
                r = QtCore.QRectF(front_origin.x() + 0 + ox, front_origin.y() + y_left + oy, t, L_left)
                add_part("side_left", r)
            if has_R and "side_right" in self.parts:
                ox, oy = off["side_right"]
                r = QtCore.QRectF(front_origin.x() + (W - t) + ox, front_origin.y() + y_right + oy, t, L_right)
                add_part("side_right", r)

            # top / bottom rails
            if has_T and "top" in self.parts:
                ox, oy = off["top"]
                x = (t if has_L else 0.0)
                r = QtCore.QRectF(front_origin.x() + x + ox, front_origin.y() + 0 + oy, innerW, t)
                add_part("top", r)
            if has_B and "bottom" in self.parts:
                ox, oy = off["bottom"]
                x = (t if has_L else 0.0)
                r = QtCore.QRectF(front_origin.x() + x + ox, front_origin.y() + (H - t) + oy, innerW, t)
                add_part("bottom", r)

            # middle wall (front projection)
            if middle_on and "middle" in self.parts:
                ox, oy = off["middle"]
                x = (t if has_L else 0.0) + (innerW - t) / 2.0
                y0 = (t if has_T else 0.0) + y_mid
                r = QtCore.QRectF(front_origin.x() + x + ox, front_origin.y() + y0 + oy, t, L_mid)
                add_part("middle", r)

            # shelves (draw as thin lines)
            shelves_cnt = int(self.in_shelves.value()) if (self.ck_shelves.isChecked() and self.in_shelves.value() > 0) else 0
            if shelves_cnt > 0:
                # evenly distribute inside (rough)
                y0 = (t if has_T else 0.0)
                y1 = H - (t if has_B else 0.0)
                span = max(0.0, y1 - y0)
                step = span / (shelves_cnt + 1)

                for i in range(1, shelves_cnt + 1):
                    y = y0 + step * i
                    ox, oy = off["shelves"]
                    if middle_on and self.ck_split_shelves.isChecked():
                        left_w = max(0.0, (innerW - t) / 2.0)
                        xL = (t if has_L else 0.0)
                        xR = (t if has_L else 0.0) + left_w + t
                        rL = QtCore.QRectF(front_origin.x() + xL + ox, front_origin.y() + y + oy, left_w, t)
                        rR = QtCore.QRectF(front_origin.x() + xR + ox, front_origin.y() + y + oy, left_w, t)
                        add_part(f"shelf_{i}_L", rL)
                        add_part(f"shelf_{i}_R", rR)
                    else:
                        x = (t if has_L else 0.0)
                        r = QtCore.QRectF(front_origin.x() + x + ox, front_origin.y() + y + oy, innerW, t)
                        add_part(f"shelf_{i}", r)

            # FRONT panels (as overlay rectangles)
            if self.ck_front.isChecked():
                mode = self.cb_front_mode.currentText()
                if mode != "Brak":
                    n = int(self.in_front_count.value())
                    gapF = float(self.in_front_gap.value())
                    side_off = float(self.in_front_side.value())
                    hmode = self.cb_front_hmode.currentText()
                    openH = H if hmode == "Na całą wysokość" else max(0.0, H - (t if has_T else 0.0) - (t if has_B else 0.0))
                    baseY = 0.0 if hmode == "Na całą wysokość" else (t if has_T else 0.0)
                    ox, oy = off["front"]

                    if mode == "Drzwi":
                        availW = max(0.0, W - 2 * side_off)
                        panelW = max(0.0, (availW - gapF * (n - 1)) / max(1, n))
                        for i in range(1, n + 1):
                            x = side_off + (i - 1) * (panelW + gapF)
                            r = QtCore.QRectF(front_origin.x() + x + ox, front_origin.y() + baseY + oy, panelW, openH)
                            add_part(f"front_{i}", r)
                    else:
                        availW = max(0.0, W - 2 * side_off)
                        availH = max(0.0, openH)
                        panelH = max(0.0, (availH - gapF * (n - 1)) / max(1, n))
                        for i in range(1, n + 1):
                            y = baseY + (i - 1) * (panelH + gapF)
                            r = QtCore.QRectF(front_origin.x() + side_off + ox, front_origin.y() + y + oy, availW, panelH)
                            add_part(f"front_{i}", r)

            # TOP VIEW: show carcass footprint + middle wall
            # outline already drawn; draw side thickness stripes etc.
            # sides top view
            if has_L and "side_left" in self.parts:
                r = QtCore.QRectF(top_origin.x() + 0, top_origin.y() + 0, t, D)
                self.scene.addRect(r, QtGui.QPen(QtGui.QColor("#334155"), 1.2))
            if has_R and "side_right" in self.parts:
                r = QtCore.QRectF(top_origin.x() + (W - t), top_origin.y() + 0, t, D)
                self.scene.addRect(r, QtGui.QPen(QtGui.QColor("#334155"), 1.2))

            if middle_on and "middle" in self.parts:
                x = (t if has_L else 0.0) + (innerW - t) / 2.0
                r = QtCore.QRectF(top_origin.x() + x, top_origin.y() + 0, t, D)
                self.scene.addRect(r, QtGui.QPen(QtGui.QColor("#334155"), 1.2))

            # Dimension annotations (outside)
            # front: W and H
            dim_pen = QtGui.QPen(QtGui.QColor("#2563eb"), 1.6)
            dim_pen.setCosmetic(True)

            # W line above front
            y_dim = front_rect.top() - 20
            self.scene.addLine(front_rect.left(), y_dim, front_rect.right(), y_dim, dim_pen)
            self.scene.addText(f"W = {W:.0f} mm").setPos(front_rect.center().x() - 40, y_dim - 18)

            # H line left of front
            x_dim = front_rect.left() - 30
            self.scene.addLine(x_dim, front_rect.top(), x_dim, front_rect.bottom(), dim_pen)
            self.scene.addText(f"H = {H:.0f} mm").setPos(x_dim - 10, front_rect.center().y() - 10)

            # top: D only (left side)
            x_dim2 = top_rect.left() - 30
            self.scene.addLine(x_dim2, top_rect.top(), x_dim2, top_rect.bottom(), dim_pen)
            self.scene.addText(f"D = {D:.0f} mm").setPos(x_dim2 - 10, top_rect.center().y() - 10)

            # fit view with margins
            all_rect = front_rect.united(top_rect).adjusted(-margin, -margin, margin, margin)
            self.scene.setSceneRect(all_rect)
            self.view.fitInView(all_rect, QtCore.Qt.AspectRatioMode.KeepAspectRatio)

            # apply selection state on items
            for it in self.scene.items():
                if isinstance(it, PartRectItem):
                    it.set_selected(it.part_key == self.selected_key)
                    if it.part_key == self.selected_key:
                        it.setSelected(True)
        finally:
            self.scene.blockSignals(False)

    # -----------------------------
    # Quick panel updates
    # -----------------------------
    def _refresh_quick_panel(self) -> None:
        p = self.parts.get(self.selected_key)
        if not p:
            self.lbl_selected.setText("Wybrany: —")
            return
        self.lbl_selected.setText(f"Wybrany: {p.name_pl}  [{p.key}]")

        # edge labels
        self.val_L.setText(p.edges.L or "—")
        self.val_P.setText(p.edges.P or "—")
        self.val_G.setText(p.edges.G or "—")
        self.val_D.setText(p.edges.D or "—")

        # material selection
        # try set combo to existing material (if present)
        if p.material:
            idx = self.cb_q_material.findText(p.material)
            if idx >= 0:
                self.cb_q_material.blockSignals(True)
                self.cb_q_material.setCurrentIndex(idx)
                self.cb_q_material.blockSignals(False)

    def _apply_quick_material(self) -> None:
        p = self.parts.get(self.selected_key)
        if not p:
            return
        txt = self.cb_q_material.currentText().strip()
        if txt.startswith("—"):
            return
        p.material = txt
        self._refresh_bom()
        self._save_state()

    def _apply_preset_edge(self, thickness: str) -> None:
        # pick first matching edge name containing thickness
        idx = -1
        for i in range(self.cb_q_edge.count()):
            t = self.cb_q_edge.itemText(i)
            if thickness in t:
                idx = i
                break
        if idx >= 0:
            self.cb_q_edge.setCurrentIndex(idx)

    def _edge_type_current(self) -> str:
        t = self.cb_q_edge.currentText().strip()
        if t.startswith("ABS 0.8") or t.startswith("ABS 2.0"):
            return t
        if t.startswith("—"):
            return ""
        return t

    def _set_edge_side(self, side: str) -> None:
        p = self.parts.get(self.selected_key)
        if not p:
            return
        et = self._edge_type_current()
        if not et:
            return
        if side == "L":
            p.edges.L = et
        elif side == "P":
            p.edges.P = et
        elif side == "G":
            p.edges.G = et
        elif side == "D":
            p.edges.D = et
        self._refresh_quick_panel()
        self._refresh_bom()
        self._save_state()

    def _apply_edge_to_all_sides_selected(self) -> None:
        p = self.parts.get(self.selected_key)
        if not p:
            return
        et = self._edge_type_current()
        if not et:
            return
        p.edges.L = et
        p.edges.P = et
        p.edges.G = et
        p.edges.D = et
        self._refresh_quick_panel()
        self._refresh_bom()
        self._save_state()

    def _clear_edges_selected(self) -> None:
        p = self.parts.get(self.selected_key)
        if not p:
            return
        p.edges = EdgeMap()
        self._refresh_quick_panel()
        self._refresh_bom()
        self._save_state()

    # -----------------------------
    # BOM
    # -----------------------------
    def _hinges_for_height(self, h_mm: float) -> int:
        # prosta reguła (możemy później dopracować)
        if h_mm <= 900:
            return 3
        if h_mm <= 1600:
            return 4
        return 5

    def _refresh_bom(self) -> None:
        qty = int(self.in_qty.value())
        lines: List[str] = []
        lines.append(f"Moduł: {self.in_name.text().strip() or '—'}   x{qty}")
        lines.append("")

        # aggregate materials m2
        mats_m2: Dict[str, float] = {}
        edges_mb: Dict[str, float] = {}

        def add_area(mat: str, mm_w: float, mm_h: float):
            if not mat:
                mat = "—"
            mats_m2[mat] = mats_m2.get(mat, 0.0) + mm2_to_m2(mm_w * mm_h)

        def add_edge(et: str, mm_len: float):
            if not et:
                return
            edges_mb[et] = edges_mb.get(et, 0.0) + mm_to_m(mm_len)

        # list parts
        part_list = list(self.parts.values())
        self.lbl_parts.setText(f"parts: {len(part_list)}")

        for p in part_list:
            add_area(p.material or "—", p.w_mm, p.h_mm)

            # edges length (approx perimeter sides)
            # L/P use h; G/D use w
            add_edge(p.edges.L, p.h_mm)
            add_edge(p.edges.P, p.h_mm)
            add_edge(p.edges.G, p.w_mm)
            add_edge(p.edges.D, p.w_mm)

        lines.append("ELEMENTY:")
        for p in part_list:
            lines.append(f"- {p.name_pl:20s}  {p.w_mm:.0f} x {p.h_mm:.0f} mm   | mat: {p.material or '—'}")
        lines.append("")

        lines.append("MATERIAŁY (m²):")
        for k in sorted(mats_m2.keys()):
            lines.append(f"- {k}: {mats_m2[k] * qty:.3f} m²")
        lines.append("")

        lines.append("OKLEINA (mb):")
        for k in sorted(edges_mb.keys()):
            lines.append(f"- {k}: {edges_mb[k] * qty:.2f} mb")
        lines.append("")

        # fittings
        lines.append("OKUCIA (szkielet):")
        hinges_override = int(self.in_hinges_override.value())
        hinges_auto = bool(self.ck_hinges_auto.isChecked())

        hinges_total = 0
        # count doors fronts only (mode Drzwi)
        if self.ck_front.isChecked() and self.cb_front_mode.currentText() == "Drzwi":
            for p in part_list:
                if p.key.startswith("front_"):
                    if hinges_override > 0:
                        hinges_total += hinges_override
                    else:
                        hinges_total += self._hinges_for_height(p.h_mm) if hinges_auto else 0

        legs = int(self.in_legs.value())
        hangers = int(self.in_hangers.value())
        pins_per_shelf = int(self.in_pins_per_shelf.value())

        # shelf count (keys)
        shelf_count = 0
        for p in part_list:
            if p.key.startswith("shelf_"):
                shelf_count += 1

        if hinges_total:
            lines.append(f"- Zawiasy: {hinges_total * qty} szt")
        if legs:
            lines.append(f"- Nóżki: {legs * qty} szt")
        if hangers:
            lines.append(f"- Zawieszki: {hangers * qty} szt")
        if shelf_count and pins_per_shelf:
            lines.append(f"- Podpórki półek: {shelf_count * pins_per_shelf * qty} szt")

        self.txt_bom.setPlainText("\n".join(lines))

    # -----------------------------
    # Actions
    # -----------------------------
    def _on_recalc(self) -> None:
        self._rebuild_parts()
        self._refresh_scene()
        self._refresh_quick_panel()
        self._refresh_bom()
        self._save_state()

    def _on_reset(self) -> None:
        # soft reset: tylko podstawy
        self.in_W.setValue(600.0)
        self.in_H.setValue(720.0)
        self.in_D.setValue(560.0)
        self.in_thick.setValue(18.0)
        self.in_back_thick.setValue(3.0)
        self.in_shelves.setValue(0)
        self.in_qty.setValue(1)
        self.ck_middle.setChecked(False)
        self.ck_split_shelves.setChecked(True)
        self._on_recalc()

    # -----------------------------
    # DB: save/load module record
    # -----------------------------
    def _save_to_db(self) -> None:
        name = (self.in_name.text() or "").strip()
        if not name:
            QtWidgets.QMessageBox.warning(self, "Brak nazwy", "Podaj nazwę modułu przed zapisem.")
            return

        state = self._export_state()
        record = ModuleRecord(name=name, state=state)

        # check if exists
        exists = False
        try:
            _ = self.library.get(name)
            exists = True
        except Exception:
            exists = False

        if exists:
            res = QtWidgets.QMessageBox.question(
                self,
                "Nadpisać?",
                f"Moduł '{name}' już istnieje w bazie.\nCzy chcesz go NADPISAĆ?",
                QtWidgets.QMessageBox.StandardButton.Yes | QtWidgets.QMessageBox.StandardButton.No,
            )
            if res != QtWidgets.QMessageBox.StandardButton.Yes:
                return

        self.library.upsert(record)
        QtWidgets.QMessageBox.information(self, "Zapisano", f"Zapisano moduł do bazy: {name}")

    def _load_from_db(self) -> None:
        name = (self.in_name.text() or "").strip()
        if not name:
            QtWidgets.QMessageBox.warning(self, "Brak nazwy", "Wpisz nazwę modułu do wczytania.")
            return

        try:
            rec = self.library.get(name)
        except Exception:
            QtWidgets.QMessageBox.warning(self, "Nie znaleziono", f"Nie znaleziono modułu: {name}")
            return

        st = rec.state or {}
        # apply fields
        self.in_W.setValue(safe_float(st.get("W", 600.0), 600.0))
        self.in_H.setValue(safe_float(st.get("H", 720.0), 720.0))
        self.in_D.setValue(safe_float(st.get("D", 560.0), 560.0))

        pe = st.get("parts_enabled", {}) or {}
        self.ck_side_left.setChecked(bool(pe.get("side_left", True)))
        self.ck_side_right.setChecked(bool(pe.get("side_right", True)))
        self.ck_top.setChecked(bool(pe.get("top", True)))
        self.ck_bottom.setChecked(bool(pe.get("bottom", True)))
        self.ck_front.setChecked(bool(pe.get("front", True)))
        self.ck_back.setChecked(bool(pe.get("back", True)))
        self.ck_middle.setChecked(bool(pe.get("middle", False)))
        self.ck_shelves.setChecked(bool(pe.get("shelves", True)))

        offs = st.get("offsets", {}) or {}
        def set_off(key: str, spx, spy):
            v = offs.get(key, [0.0, 0.0])
            spx.setValue(safe_float(v[0], 0.0))
            spy.setValue(safe_float(v[1], 0.0))

        set_off("top", self.off_top_x, self.off_top_y)
        set_off("bottom", self.off_bottom_x, self.off_bottom_y)
        set_off("side_left", self.off_side_left_x, self.off_side_left_y)
        set_off("side_right", self.off_side_right_x, self.off_side_right_y)
        set_off("front", self.off_front_x, self.off_front_y)
        set_off("back", self.off_back_x, self.off_back_y)
        set_off("middle", self.off_middle_x, self.off_middle_y)
        set_off("shelves", self.off_shelves_x, self.off_shelves_y)

        ln = st.get("lengths", {}) or {}
        def set_len(key: str, cb, sp):
            v = ln.get(key, {}) or {}
            cb.setCurrentIndex(safe_int(v.get("pos", 0), 0))
            sp.setValue(safe_float(v.get("L", 0.0), 0.0))

        set_len("side_left", self.cb_len_side_left_pos, self.in_len_side_left)
        set_len("side_right", self.cb_len_side_right_pos, self.in_len_side_right)
        set_len("middle", self.cb_len_middle_pos, self.in_len_middle)

        fr = st.get("front", {}) or {}
        m = str(fr.get("mode", "Drzwi"))
        idx = self.cb_front_mode.findText(m)
        if idx >= 0:
            self.cb_front_mode.setCurrentIndex(idx)
        hm = str(fr.get("hmode", "Na całą wysokość"))
        idx = self.cb_front_hmode.findText(hm)
        if idx >= 0:
            self.cb_front_hmode.setCurrentIndex(idx)
        self.in_front_count.setValue(safe_int(fr.get("count", 2), 2))
        self.in_front_gap.setValue(safe_float(fr.get("gap", 2.0), 2.0))
        self.in_front_side.setValue(safe_float(fr.get("side_off", 2.0), 2.0))

        sh = st.get("shelves", {}) or {}
        self.in_shelves.setValue(safe_int(sh.get("count", 0), 0))
        self.ck_split_shelves.setChecked(bool(sh.get("split", True)))

        self.in_qty.setValue(safe_int(st.get("qty", 1), 1))

        fi = st.get("fittings", {}) or {}
        self.ck_hinges_auto.setChecked(bool(fi.get("hinges_auto", True)))
        self.in_hinges_override.setValue(safe_int(fi.get("hinges_override", 0), 0))
        self.in_legs.setValue(safe_int(fi.get("legs", 4), 4))
        self.in_hangers.setValue(safe_int(fi.get("hangers", 2), 2))
        self.in_pins_per_shelf.setValue(safe_int(fi.get("pins_per_shelf", 4), 4))

        # restore per-part material/edges
        saved_parts = st.get("parts", {}) or {}
        self._rebuild_parts()
        for k, meta in saved_parts.items():
            if k not in self.parts:
                continue
            mat = (meta.get("material") or "").strip()
            if mat:
                self.parts[k].material = mat
            ed = meta.get("edges", {}) or {}
            self.parts[k].edges = EdgeMap(
                L=str(ed.get("L", "")) if ed.get("L") else "",
                P=str(ed.get("P", "")) if ed.get("P") else "",
                G=str(ed.get("G", "")) if ed.get("G") else "",
                D=str(ed.get("D", "")) if ed.get("D") else "",
            )

        self.selected_key = str(st.get("selected_key", self.selected_key))
        self._refresh_scene()
        self._refresh_quick_panel()
        self._refresh_bom()
        self._save_state()

        QtWidgets.QMessageBox.information(self, "Wczytano", f"Wczytano moduł z bazy: {name}")
