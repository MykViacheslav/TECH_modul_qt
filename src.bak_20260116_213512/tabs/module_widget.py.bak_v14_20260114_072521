    key: str
    name_pl: str
    a_mm: float          # wymiar A (np. szer./gł.)
    b_mm: float          # wymiar B (np. wys./gł.)
    thick_mm: float      # grubość
    material: str = ""
    edges: EdgeMap = field(default_factory=EdgeMap)


def mm2_to_m2(mm2: float) -> float:
    return mm2 / 1_000_000.0


def safe_float(v: Any, default: float = 0.0) -> float:
    try:
        return float(v)
    except Exception:
        return default


def safe_int(v: Any, default: int = 0) -> int:
    try:
        return int(v)
    except Exception:
        return default


def clamp(v: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, v))


def pick_nl_for_depth(cabinet_depth_mm: float) -> int:
    """
    Auto zasada wg Twojego założenia:
    - w korpusie D nie można dać NL=D
    - bierzemy NL <= D-50 (np. D=500 => NL=450)
    """
    target = max(0.0, cabinet_depth_mm - 50.0)
    candidates = [nl for nl in STD_NL_MM if nl <= target]
    if not candidates:
        return max(0, min(STD_NL_MM))  # fallback najmniejszy
    return max(candidates)


class PartRectItem(QtWidgets.QGraphicsRectItem):
    def __init__(self, part_key: str, rect: QtCore.QRectF, selectable: bool = True):
        super().__init__(rect)
        self.part_key = part_key
        self.setAcceptHoverEvents(True)
        self.setFlag(QtWidgets.QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, bool(selectable))
        self._hover = False
        self._selected = False
        self._update_pen()
        # UI COMPACT v12 (styles)
        try:
            _qss = """
            /* compact inputs */
            QLineEdit, QSpinBox, QDoubleSpinBox {
                min-width: 70px;
                max-width: 95px;
                padding: 2px 6px;
            }
            QSpinBox, QDoubleSpinBox {
                padding-right: 4px;
            }
            /* bigger checkbox indicator */
            QCheckBox::indicator {
                width: 18px;
                height: 18px;
            }
            """
            self.setStyleSheet((self.styleSheet() or "") + _qss)
        except Exception:
            pass

    def set_selected(self, val: bool):
        self._selected = bool(val)
        self._update_pen()

    def hoverEnterEvent(self, event):
        self._hover = True
        self._update_pen()
        super().hoverEnterEvent(event)

    def hoverLeaveEvent(self, event):
        self._hover = False
        self._update_pen()
        super().hoverLeaveEvent(event)

    def _update_pen(self):
        if self._selected:
            pen = QtGui.QPen(QtGui.QColor("#DC2626"), 2.4)
        elif self._hover:
            pen = QtGui.QPen(QtGui.QColor("#2563EB"), 2.0)
        else:
            pen = QtGui.QPen(QtGui.QColor("#111827"), 1.4)
        self.setPen(pen)
        self.setBrush(QtCore.Qt.BrushStyle.NoBrush)


class ModuleWidget(QtWidgets.QWidget):
    def __init__(self, ctx, parent=None) -> None:
        super().__init__(parent)
        self.ctx = ctx
        self.settings: QSettings = getattr(ctx, "settings", QSettings("TECH_modul", "TECH_modul_qt"))

        proj_root = Path(__file__).resolve().parents[2]
        self.library = ModuleLibrary(proj_root / "data" / "modules.json")

        self.parts: Dict[str, Part] = {}
        self.selected_key: str = "side_left"

        self._build_ui()
        self._populate_catalogs()
        self._load_state()

        self._rebuild_parts()
        self._refresh_scene()
        self._refresh_quick_panel()
        self._refresh_bom()

        bus = getattr(self.ctx, "bus", None)
        sig = getattr(bus, "data_changed", None)
        if sig is not None and hasattr(sig, "connect"):
            try:
                sig.connect(self._on_data_changed)
            except Exception:
                pass

    @QtCore.Slot(object)
    def _on_data_changed(self, key: object) -> None:
        if str(key) == "catalogs":
            self._populate_catalogs()

    def closeEvent(self, e) -> None:
        try:
            self._save_state()
        except Exception:
            pass
        super().closeEvent(e)

