        self.cb_drawer_height_code.blockSignals(True)
        try:
            self.cb_drawer_height_code.clear()
            if sys == "MERIVOBOX":
                for k in ["N", "M", "K", "E"]:
                    self.cb_drawer_height_code.addItem(k)
            else:
                for k in ["K", "C", "D"]:
                    self.cb_drawer_height_code.addItem(k)
        finally:
            self.cb_drawer_height_code.blockSignals(False)

        self._update_drawer_nl_label()

    def _update_drawer_nl_label(self) -> None:
        nl = pick_nl_for_depth(float(self.in_D.value()))
        self.lbl_drawer_nl.setText(f"NL: {nl} mm")
    # -----------------------------
    # Catalogs
    # -----------------------------
    def _populate_catalogs(self) -> None:
        catalogs = getattr(self.ctx, "catalogs", None)

        mats: List[str] = []
        edges: List[str] = []

        try:
            if catalogs and hasattr(catalogs, "get_materials"):
                mats = [getattr(x, "name", str(x)) for x in catalogs.get_materials()]
        except Exception:
            mats = []

        try:
            if catalogs and hasattr(catalogs, "get_edges"):
                edges = [getattr(x, "name", str(x)) for x in catalogs.get_edges()]
        except Exception:
            edges = []

        def fill(cb: QtWidgets.QComboBox, placeholder: str, items: List[str]):
            cur = cb.currentText()
            cb.blockSignals(True)
            try:
                cb.clear()
                cb.addItem(placeholder)
                for it in items:
                    cb.addItem(it)
                idx = cb.findText(cur)
                if idx >= 0:
                    cb.setCurrentIndex(idx)
            finally:
                cb.blockSignals(False)

        fill(self.cb_mat_carcass, "Płyta wiórowa 18 mm (domyślnie)", mats)
        fill(self.cb_front_mat, "MDF 18 mm (domyślnie)", mats)
        fill(self.cb_back_mat, "HDF 3 mm (domyślnie)", mats)

        fill(self.cb_q_material, "— wybierz materiał —", mats)
        fill(self.cb_q_edge, "ABS 0.8 (domyślnie)", edges)

    # -----------------------------
    # Selection handling
    # -----------------------------
    def _scene_selection_changed(self):
        sel = self.scene.selectedItems()
        if not sel:
            return
        it = sel[0]
        if isinstance(it, PartRectItem):
            self._select_part(it.part_key)

    def _select_part(self, key: str) -> None:
        if key not in self.parts:
            return
        self.selected_key = key
        self._refresh_scene()
        self._refresh_quick_panel()
        self._save_state()

