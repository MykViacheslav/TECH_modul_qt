# Standardowe długości nominalne (NL) - Blum (typowe)
STD_NL_MM: List[int] = [250, 270, 300, 350, 400, 450, 500, 550, 600, 650]


# Wysokości MERIVOBOX wg Blum (N/M/K/E)
# N=68.5, M=91, K=129, E=192
MERIVOBOX_HEIGHTS_MM: Dict[str, float] = {
    "N": 68.5,
    "M": 91.0,
    "K": 129.0,
    "E": 192.0,
}

# TANDEMBOX (antaro) wg strony Blum pokazuje m.in. K/C/D
TANDEMBOX_HEIGHTS_MM: Dict[str, float] = {
    "K": 116.0,
    "C": 171.0,
    "D": 203.0,
}


@dataclass
class EdgeMap:
    L: str = ""
    P: str = ""
    G: str = ""
    D: str = ""


@dataclass
