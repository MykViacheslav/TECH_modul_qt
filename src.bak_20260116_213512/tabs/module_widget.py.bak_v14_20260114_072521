    # -----------------------------
    # Core parts rebuild
    # -----------------------------
    def _rebuild_parts(self) -> None:
        W = float(self.in_W.value())
        H = float(self.in_H.value())
        D = float(self.in_D.value())
        t = float(self.in_thick.value())
        bt = float(self.in_back_thick.value())

        has_L = bool(self.ck_side_left.isChecked())
        has_R = bool(self.ck_side_right.isChecked())
        has_T = bool(self.ck_top.isChecked())
        has_B = bool(self.ck_bottom.isChecked())

        front_enabled = bool(self.ck_front.isChecked())
        back_enabled = bool(self.ck_back.isChecked())
        middle_on = bool(self.ck_middle.isChecked())

        shelves_on = bool(self.ck_shelves.isChecked())
        shelves_cnt = int(self.in_shelves.value()) if shelves_on else 0
        split_shelves = bool(self.ck_split_shelves.isChecked())

        carcass_mat = self.cb_mat_carcass.currentText().strip()
        if self.cb_mat_carcass.currentIndex() == 0:
            carcass_mat = "Płyta wiórowa 18 mm"

        back_mat = self.cb_back_mat.currentText().strip()
        if self.cb_back_mat.currentIndex() == 0:
            back_mat = "HDF 3 mm"

        front_mat = self.cb_front_mat.currentText().strip()
        if self.cb_front_mat.currentIndex() == 0:
            front_mat = "MDF 18 mm"

        front_thick = 18.0

        innerW = W - (t if has_L else 0.0) - (t if has_R else 0.0)
        innerH = H - (t if has_T else 0.0) - (t if has_B else 0.0)
        innerW = max(0.0, innerW)
        innerH = max(0.0, innerH)

        parts: Dict[str, Part] = {}

        def ensure(key: str, name: str, a: float, b: float, thick: float, default_mat: str):
            old = self.parts.get(key)
            if old is None:
                parts[key] = Part(key, name, a, b, thick, default_mat)
            else:
                old.name_pl = name
                old.a_mm, old.b_mm = a, b
                old.thick_mm = thick
                if not old.material:
                    old.material = default_mat
                parts[key] = old

        # Boki: A=D (głęb.), B=H (wys.), T=t
        if has_L:
            ensure("side_left", "Bok lewy", D, H, t, carcass_mat)
        if has_R:
            ensure("side_right", "Bok prawy", D, H, t, carcass_mat)

        # Wieńce: A=innerW (szer.), B=D (głęb.), T=t
        if has_T:
            ensure("top", "Wieniec góra", innerW, D, t, carcass_mat)
        if has_B:
            ensure("bottom", "Wieniec dół", innerW, D, t, carcass_mat)

        # Plecy: A=W, B=H, T=bt
        if back_enabled:
            ensure("back", "Plecy", W, H, bt, back_mat)

        # Środkowa: A=D, B=innerH, T=t
        if middle_on:
            ensure("middle", "Środkowa ścianka", D, innerH, t, carcass_mat)

        # Półki: A=innerW lub połówki, B=D, T=t
        if shelves_cnt > 0:
            for i in range(1, shelves_cnt + 1):
                if middle_on and split_shelves:
                    a_half = max(0.0, (innerW - t) / 2.0)
                    ensure(f"shelf_{i}_L", f"Półka {i} (lewa)", a_half, D, t, carcass_mat)
                    ensure(f"shelf_{i}_R", f"Półka {i} (prawa)", a_half, D, t, carcass_mat)
                else:
                    ensure(f"shelf_{i}", f"Półka {i}", innerW, D, t, carcass_mat)

        # Fronty / Szuflady (fronty)
        if front_enabled and self.cb_front_mode.currentText() != "Brak":
            mode = self.cb_front_mode.currentText()
            n = int(self.in_front_count.value())
            gap = float(self.in_front_gap.value())
            side_off = float(self.in_front_side.value())
            hmode = self.cb_front_hmode.currentText()

            openH = H if hmode == "Na całą wysokość" else max(0.0, H - (t if has_T else 0.0) - (t if has_B else 0.0))
            if mode == "Drzwi":
                availW = max(0.0, W - 2 * side_off)
                panelW = max(0.0, (availW - gap * (n - 1)) / max(1, n))
                for i in range(1, n + 1):
                    ensure(f"front_{i}", f"Front {i}", panelW, openH, front_thick, front_mat)
            else:
                availW = max(0.0, W - 2 * side_off)
                availH = max(0.0, openH)
                panelH = max(0.0, (availH - gap * (n - 1)) / max(1, n))
                for i in range(1, n + 1):
                    ensure(f"front_{i}", f"Front szuflady {i}", availW, panelH, front_thick, front_mat)

        self.parts = parts
        if self.selected_key not in self.parts and self.parts:
            self.selected_key = next(iter(self.parts.keys()))

        self._update_drawer_nl_label()

    # -----------------------------
    # Draw
    # -----------------------------
    def _refresh_scene(self) -> None:
        self.scene.blockSignals(True)
        try:
            self.scene.clear()

            W = float(self.in_W.value())
            H = float(self.in_H.value())
            D = float(self.in_D.value())

            gap = 90.0
            margin = 50.0

            front_origin = QtCore.QPointF(0.0, 0.0)
            top_origin = QtCore.QPointF(0.0, H + gap)

            front_rect = QtCore.QRectF(front_origin.x(), front_origin.y(), W, H)
            top_rect = QtCore.QRectF(top_origin.x(), top_origin.y(), W, D)

            try:
                front_on = bool(front_on)
            except Exception:
                front_on = False
            if front_on:
                strip_h = max(8.0, min(14.0, top_rect.height() * 0.08))
                front_top_strip = QtCore.QRectF(top_rect.left(), top_rect.bottom(), top_rect.width(), strip_h)
                add_part('front_top', front_top_strip)
            pen_outer = QtGui.QPen(QtGui.QColor("#0f172a"), 2.0)
            self.scene.addRect(front_rect, pen_outer)
            self.scene.addRect(top_rect, pen_outer)

            def add_part(key: str, rect: QtCore.QRectF):
                if key not in self.parts:
                    return None
                hide_fronts = getattr(self, 'ck_hide_fronts', None)
                hide_fronts = hide_fronts.isChecked() if hide_fronts is not None else False
                fronts_clickable = getattr(self, 'ck_fronts_clickable', None)
                fronts_clickable = fronts_clickable.isChecked() if fronts_clickable is not None else True

                if key.startswith('front_') and hide_fronts:
                    return None

                selectable = True
                if key.startswith('front_') and fronts_clickable:
                    selectable = False

                it = PartRectItem(key, rect, selectable=selectable)
                if key.startswith('front_') and selectable is False:
                    pass
                it.set_selected(key == self.selected_key)
                self.scene.addItem(it)

                # A×B×T w środku jeśli się mieści
                p = self.parts[key]
                if rect.width() >= 64 and rect.height() >= 30:
                    txt = QtWidgets.QGraphicsSimpleTextItem(f"{p.a_mm:.0f}×{p.b_mm:.0f}×{p.thick_mm:.0f}", it)
                    txt.setBrush(QtGui.QBrush(QtGui.QColor("#475569")))
                    f = QtGui.QFont()
                    f.setPointSize(8)
                    f.setBold(True)
                    txt.setFont(f)
                    br = txt.boundingRect()
                    txt.setPos(rect.width()/2 - br.width()/2, rect.height()/2 - br.height()/2)
                return it

            # Prosty rysunek (jak było)
            t = float(self.in_thick.value())
            has_L = self.ck_side_left.isChecked()
            has_R = self.ck_side_right.isChecked()
            has_T = self.ck_top.isChecked()
            has_B = self.ck_bottom.isChecked()
            middle_on = self.ck_middle.isChecked()

            innerW = W - (t if has_L else 0) - (t if has_R else 0)
            innerH = H - (t if has_T else 0) - (t if has_B else 0)
            innerW = max(0.0, innerW)
            innerH = max(0.0, innerH)

            # front view
            if has_L and "side_left" in self.parts:
                r = QtCore.QRectF(front_origin.x() + 0, front_origin.y() + 0, t, H)
                add_part("side_left", r)
            if has_R and "side_right" in self.parts:
                r = QtCore.QRectF(front_origin.x() + (W - t), front_origin.y() + 0, t, H)
                add_part("side_right", r)
            if has_T and "top" in self.parts:
                x = (t if has_L else 0.0)
                r = QtCore.QRectF(front_origin.x() + x, front_origin.y() + 0, innerW, t)
                add_part("top", r)
            if has_B and "bottom" in self.parts:
                x = (t if has_L else 0.0)
                r = QtCore.QRectF(front_origin.x() + x, front_origin.y() + (H - t), innerW, t)
                add_part("bottom", r)

            if middle_on and "middle" in self.parts:
                x = (t if has_L else 0.0) + (innerW - t) / 2.0
                y0 = (t if has_T else 0.0)
                r = QtCore.QRectF(front_origin.x() + x, front_origin.y() + y0, t, innerH)
                add_part("middle", r)

            # półki
            shelves_cnt = int(self.in_shelves.value()) if self.ck_shelves.isChecked() else 0
            if shelves_cnt > 0:
                y0 = (t if has_T else 0.0)
                y1 = H - (t if has_B else 0.0)
                span = max(0.0, y1 - y0)
                step = span / (shelves_cnt + 1)
                for i in range(1, shelves_cnt + 1):
                    y = y0 + step * i
                    if middle_on and self.ck_split_shelves.isChecked():
                        left_w = max(0.0, (innerW - t) / 2.0)
                        xL = (t if has_L else 0.0)
                        xR = (t if has_L else 0.0) + left_w + t
                        rL = QtCore.QRectF(front_origin.x() + xL, front_origin.y() + y, left_w, t)
                        rR = QtCore.QRectF(front_origin.x() + xR, front_origin.y() + y, left_w, t)
                        add_part(f"shelf_{i}_L", rL)
                        add_part(f"shelf_{i}_R", rR)
                    else:
                        x = (t if has_L else 0.0)
                        r = QtCore.QRectF(front_origin.x() + x, front_origin.y() + y, innerW, t)
                        add_part(f"shelf_{i}", r)

            # fronty
            if self.ck_front.isChecked() and self.cb_front_mode.currentText() != "Brak":
                mode = self.cb_front_mode.currentText()
                n = int(self.in_front_count.value())
                gapF = float(self.in_front_gap.value())
                side_off = float(self.in_front_side.value())
                hmode = self.cb_front_hmode.currentText()
                openH = H if hmode == "Na całą wysokość" else max(0.0, H - (t if has_T else 0.0) - (t if has_B else 0.0))
                baseY = 0.0 if hmode == "Na całą wysokość" else (t if has_T else 0.0)

                if mode == "Drzwi":
                    availW = max(0.0, W - 2 * side_off)
                    panelW = max(0.0, (availW - gapF * (n - 1)) / max(1, n))
                    for i in range(1, n + 1):
                        x = side_off + (i - 1) * (panelW + gapF)
                        r = QtCore.QRectF(front_origin.x() + x, front_origin.y() + baseY, panelW, openH)
                        add_part(f"front_{i}", r)
                else:
                    availW = max(0.0, W - 2 * side_off)
                    availH = max(0.0, openH)
                    panelH = max(0.0, (availH - gapF * (n - 1)) / max(1, n))
                    for i in range(1, n + 1):
                        y = baseY + (i - 1) * (panelH + gapF)
                        r = QtCore.QRectF(front_origin.x() + side_off, front_origin.y() + y, availW, panelH)
                        add_part(f"front_{i}", r)

            # top view: kontur + boki + przegroda
            pen_thin = QtGui.QPen(QtGui.QColor("#334155"), 1.2)
            if has_L:
                self.scene.addRect(QtCore.QRectF(top_origin.x() + 0, top_origin.y() + 0, t, D), pen_thin)
            if has_R:
                self.scene.addRect(QtCore.QRectF(top_origin.x() + (W - t), top_origin.y() + 0, t, D), pen_thin)
            if middle_on and "middle" in self.parts:
                x = (t if has_L else 0.0) + (innerW - t) / 2.0
                self.scene.addRect(QtCore.QRectF(top_origin.x() + x, top_origin.y() + 0, t, D), pen_thin)

            # module dimensions
            # --- DIMENSIONS (czytelne, tylko liczby) ---
            dim_pen = QtGui.QPen(QtGui.QColor("#2563eb"), 2.6)
            dim_pen.setCosmetic(True)

            def dim_text(number_str: str, x: float, y: float, rotate_deg: float = 0.0):
                t = self.scene.addText(number_str)
                f = QtGui.QFont(); f.setPointSize(16); f.setBold(True)
                t.setFont(f)
                t.setDefaultTextColor(QtGui.QColor("#0f172a"))
                t.setPos(x, y)
                if rotate_deg:
                    t.setTransformOriginPoint(t.boundingRect().center())
                    t.setRotation(rotate_deg)
                return t

            # FRONT VIEW: H only (vertical)
            xH = front_rect.left() - 32
            self.scene.addLine(xH, front_rect.top(), xH, front_rect.bottom(), dim_pen)
            dim_text(f"{int(H)}", xH - 18, front_rect.center().y() - 12, rotate_deg=-90)

            # TOP VIEW: W (horizontal) + D (vertical)
            yW = top_rect.top() - 26
            self.scene.addLine(top_rect.left(), yW, top_rect.right(), yW, dim_pen)
            dim_text(f"{int(W)}", top_rect.center().x() - 12, yW - 22, rotate_deg=0)

            xD = top_rect.left() - 32
            self.scene.addLine(xD, top_rect.top(), xD, top_rect.bottom(), dim_pen)
            dim_text(f"{int(D)}", xD - 18, top_rect.center().y() - 12, rotate_deg=-90)

            all_rect = front_rect.united(top_rect).adjusted(-margin, -margin, margin, margin)
            self.scene.setSceneRect(all_rect)
            front_chk = getattr(self, 'ck_front', None)
            front_on2 = front_chk.isChecked() if front_chk is not None else False
            if front_on2:
                try:
                    strip_h = max(8.0, min(14.0, top_rect.height() * 0.08))
                    front_strip = QtCore.QRectF(top_rect.left(), top_rect.bottom(), top_rect.width(), strip_h)
                except Exception:
                    pass

            # TOP VIEW: front pasek (manual, zawsze widoczny) — bez add_part
            try:
                # front włączony?
                _front_chk = getattr(self, 'ck_front', None)
                _front_on = _front_chk.isChecked() if _front_chk is not None else False
            
                # ukryj fronty? (best-effort: różne nazwy)
                _hide = False
                for _nm in ('ck_hide_fronts','ck_hide_front','ck_front_hide','ck_fronts_hide','ck_hide_front_view'):
                    _w = getattr(self, _nm, None)
                    if _w is not None and hasattr(_w, 'isChecked') and _w.isChecked():
                        _hide = True
                        break
            
                if _front_on and not _hide:
                    # top_rect powinien istnieć w tej funkcji; jeśli nie, to skip
                    if 'top_rect' in locals():
                        _strip_h = max(10.0, min(18.0, float(top_rect.height()) * 0.10))
                        _rect = QtCore.QRectF(top_rect.left(), top_rect.bottom(), top_rect.width(), _strip_h)
                        _it = QtWidgets.QGraphicsRectItem(_rect)
                        try:
                            _it.setPen(QtGui.QPen(QtGui.QColor('#334155'), 1))
                            _it.setBrush(QtGui.QBrush(QtGui.QColor('#E2E8F0')))
                        except Exception:
                            pass
                        _it.setZValue(999)
                        # oznaczamy klucz (dla debug/klików jeśli potrzebne)
                        try:
                            _it.setData(0, 'frontTop')
                        except Exception:
                            pass
                        self.scene.addItem(_it)
            except Exception:
                pass

            self.view.fitInView(all_rect, QtCore.Qt.AspectRatioMode.KeepAspectRatio)
        finally:
            self.scene.blockSignals(False)

    # -----------------------------
    # Quick panel
    # -----------------------------
    def _refresh_quick_panel(self) -> None:
        p = self.parts.get(self.selected_key)
        if not p:
            self.lbl_selected.setText("Wybrany: —")
            self.lbl_selected_dims.setText("A×B×T: —")
            return
        self.lbl_selected.setText(f"Wybrany: {p.name_pl}  [{p.key}]")
        self.lbl_selected_dims.setText(f"A×B×T: {p.a_mm:.0f}×{p.b_mm:.0f}×{p.thick_mm:.0f} mm")

        if p.material:
            idx = self.cb_q_material.findText(p.material)
            if idx >= 0:
                self.cb_q_material.blockSignals(True)
                self.cb_q_material.setCurrentIndex(idx)
                self.cb_q_material.blockSignals(False)

    def _apply_quick_material(self) -> None:
        p = self.parts.get(self.selected_key)
        if not p:
            return
        txt = self.cb_q_material.currentText().strip()
        if txt.startswith("—"):
            return
        p.material = txt
        self._refresh_bom()
        self._save_state()

    # -----------------------------
    # Drawers calc (AUTO)
    # -----------------------------
    def _drawer_height_mm(self) -> float:
        sys = self.cb_drawer_system.currentText()
        code = self.cb_drawer_height_code.currentText()
        if sys == "MERIVOBOX":
            return float(MERIVOBOX_HEIGHTS_MM.get(code, 91.0))
        return float(TANDEMBOX_HEIGHTS_MM.get(code, 116.0))

    def _drawer_board_thick_mm(self) -> float:
        # Na razie zgodnie z Twoim założeniem: MERIVOBOX i TANDEMBOX -> 16 mm
        return 16.0

    def _drawer_side_clear_total_mm(self) -> float:
        # Auto luz na boki - wg typowego założenia systemów metalowych (około 42 mm łącznie)
        # (doprecyzujemy, jeśli chcesz rozróżnienie systemów)
        return 42.0

    def _drawer_calc_area_m2(self) -> Tuple[str, float, int]:
        """
        Zwraca:
        - nazwa materiału (płyta do szuflad),
        - area_m2_total dla 1 modułu,
        - NL (nominal length)
        Liczymy: dno (Wbox x NL) + tył (Wbox x Hbox)
        """
        if self.cb_front_mode.currentText() != "Szuflady":
            return ("", 0.0, 0)

        W = float(self.in_W.value())
        H = float(self.in_H.value())
        D = float(self.in_D.value())
        t = float(self.in_thick.value())

        has_L = bool(self.ck_side_left.isChecked())
        has_R = bool(self.ck_side_right.isChecked())

        innerW = W - (t if has_L else 0.0) - (t if has_R else 0.0)
        innerW = max(0.0, innerW)

        n = int(self.in_front_count.value())

        nl = pick_nl_for_depth(D)
        box_h = self._drawer_height_mm()
        thick = self._drawer_board_thick_mm()

        # box width: innerW - clearance(system)
        w_box = max(0.0, innerW - self._drawer_side_clear_total_mm())
        d_box = float(nl)

        area_one = mm2_to_m2(w_box * d_box) + mm2_to_m2(w_box * box_h)
        area_total = area_one * n

        mat = f"Płyta {int(thick)} mm (szuflady)"
        return (mat, area_total, nl)

    # -----------------------------
    # BOM
    # -----------------------------
    def _hinges_for_height(self, h_mm: float) -> int:
        if h_mm <= 900:
            return 3
        if h_mm <= 1600:
            return 4
        return 5

    def _refresh_bom(self) -> None:
        qty = int(self.in_qty.value())
        lines: List[str] = []
        lines.append(f"Moduł: {self.in_name.text().strip() or '—'}   x{qty}")
        lines.append("")

        mats_m2: Dict[str, float] = {}

        def add_area(mat: str, a: float, b: float):
            if not mat:
                mat = "—"
            mats_m2[mat] = mats_m2.get(mat, 0.0) + mm2_to_m2(a * b)

        part_list = list(self.parts.values())
        self.lbl_parts.setText(f"parts: {len(part_list)}")

        for p in part_list:
            add_area(p.material or "—", p.a_mm, p.b_mm)

        # drawers
        mat_draw, area_draw, nl = self._drawer_calc_area_m2()
        if mat_draw and area_draw > 0:
            mats_m2[mat_draw] = mats_m2.get(mat_draw, 0.0) + area_draw

        lines.append("MATERIAŁY (m²):")
        for k in sorted(mats_m2.keys()):
            lines.append(f"- {k}: {mats_m2[k] * qty:.3f} m²")
        lines.append("")

        lines.append("OKUCIA:")
        # drzwi: zawiasy
        hinges_override = int(self.in_hinges_override.value())
        hinges_auto = bool(self.ck_hinges_auto.isChecked())
        hinges_total = 0
        if self.ck_front.isChecked() and self.cb_front_mode.currentText() == "Drzwi":
            for p in part_list:
                if p.key.startswith("front_"):
                    if hinges_override > 0:
                        hinges_total += hinges_override
                    else:
                        hinges_total += self._hinges_for_height(p.b_mm) if hinges_auto else 0
        if hinges_total:
            lines.append(f"- Zawiasy: {hinges_total * qty} szt")

        # szuflady: prowadnice
        if self.cb_front_mode.currentText() == "Szuflady":
            n = int(self.in_front_count.value())
            system = self.cb_drawer_system.currentText()
            code = self.cb_drawer_height_code.currentText()
            lines.append(f"- Prowadnice szuflad (Blum {system} {code}, NL={nl}): {n * qty} kpl")

        legs = int(self.in_legs.value())
        hangers = int(self.in_hangers.value())
        pins_per_shelf = int(self.in_pins_per_shelf.value())
        shelf_count = sum(1 for p in part_list if p.key.startswith("shelf_"))

        if legs:
            lines.append(f"- Nóżki: {legs * qty} szt")
        if hangers:
            lines.append(f"- Zawieszki: {hangers * qty} szt")
        if shelf_count and pins_per_shelf:
            lines.append(f"- Podpórki półek: {shelf_count * pins_per_shelf * qty} szt")

        self.txt_bom.setPlainText("\n".join(lines))

    # -----------------------------
    # Actions
    # -----------------------------
    def _on_recalc(self) -> None:
        self._rebuild_parts()
        self._refresh_scene()
        self._refresh_quick_panel()
        self._refresh_bom()
        self._save_state()

    def _on_reset(self) -> None:
        self.in_W.setValue(600.0)
        self.in_H.setValue(720.0)
        self.in_D.setValue(560.0)
        self.in_thick.setValue(18.0)
        self.in_back_thick.setValue(3.0)
        self.in_shelves.setValue(0)
        self.in_qty.setValue(1)
        self.ck_middle.setChecked(False)
        self.ck_split_shelves.setChecked(True)
        self._on_recalc()

    # -----------------------------
    # DB: save/load
    # -----------------------------
    def _export_state(self) -> Dict[str, Any]:
        return {
            "name": self.in_name.text(),
            "W": self.in_W.value(),
            "H": self.in_H.value(),
            "D": self.in_D.value(),
            "front_mode": self.cb_front_mode.currentText(),
            "front_hmode": self.cb_front_hmode.currentText(),
            "front_count": self.in_front_count.value(),
            "front_gap": self.in_front_gap.value(),
            "front_side_offset": self.in_front_side.value(),
            "thick": self.in_thick.value(),
            "back_thick": self.in_back_thick.value(),
            "shelves_count": self.in_shelves.value(),
            "shelves_split": self.ck_split_shelves.isChecked(),
            "qty": self.in_qty.value(),
            "drawer": {
                "system": self.cb_drawer_system.currentText(),
                "height_code": self.cb_drawer_height_code.currentText(),
            },
        }

    def _save_to_db(self) -> None:
        name = (self.in_name.text() or "").strip()
        if not name:
            QtWidgets.QMessageBox.warning(self, "Brak nazwy", "Podaj nazwę modułu przed zapisem.")
            return
        try:
            state = self._export_state()
            record = ModuleRecord(name=name, state=state)
            self.library.upsert(record)
            QtWidgets.QMessageBox.information(self, "Zapisano", f"Zapisano moduł do bazy: {name}")
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Błąd zapisu", f"Nie udało się zapisać do bazy.\n\nPowód: {e}")

    def _load_from_db(self) -> None:
        name = (self.in_name.text() or "").strip()
        if not name:
            QtWidgets.QMessageBox.warning(self, "Brak nazwy", "Wpisz nazwę modułu do wczytania.")
            return
        try:
            rec = self.library.get(name)
            st = rec.state or {}
            self.in_W.setValue(safe_float(st.get("W", 600.0), 600.0))
            self.in_H.setValue(safe_float(st.get("H", 720.0), 720.0))
            self.in_D.setValue(safe_float(st.get("D", 560.0), 560.0))

            fm = str(st.get("front_mode", "Drzwi"))
            idx = self.cb_front_mode.findText(fm)
            if idx >= 0:
                self.cb_front_mode.setCurrentIndex(idx)

            hm = str(st.get("front_hmode", "Na całą wysokość"))
            idx = self.cb_front_hmode.findText(hm)
            if idx >= 0:
                self.cb_front_hmode.setCurrentIndex(idx)

            self.in_front_count.setValue(safe_int(st.get("front_count", 2), 2))
            self.in_front_gap.setValue(safe_float(st.get("front_gap", 2.0), 2.0))
            self.in_front_side.setValue(safe_float(st.get("front_side_offset", 2.0), 2.0))

            self.in_thick.setValue(safe_float(st.get("thick", 18.0), 18.0))
            self.in_back_thick.setValue(safe_float(st.get("back_thick", 3.0), 3.0))
            self.in_shelves.setValue(safe_int(st.get("shelves_count", 0), 0))
            self.ck_split_shelves.setChecked(bool(st.get("shelves_split", True)))
            self.in_qty.setValue(safe_int(st.get("qty", 1), 1))

            dr = st.get("drawer", {}) or {}
            sys = str(dr.get("system", "MERIVOBOX"))
            idx = self.cb_drawer_system.findText(sys)
            if idx >= 0:
                self.cb_drawer_system.setCurrentIndex(idx)

            code = str(dr.get("height_code", "M"))
            idx = self.cb_drawer_height_code.findText(code)
            if idx >= 0:
                self.cb_drawer_height_code.setCurrentIndex(idx)

            self._on_recalc()
            QtWidgets.QMessageBox.information(self, "Wczytano", f"Wczytano moduł z bazy: {name}")
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Błąd odczytu", f"Nie udało się wczytać z bazy.\n\nPowód: {e}")

