def mm2_to_m2(mm2: float) -> float:
    return mm2 / 1_000_000.0


def safe_float(v: Any, default: float = 0.0) -> float:
    try:
        return float(v)
    except Exception:
        return default


def safe_int(v: Any, default: int = 0) -> int:
    try:
        return int(v)
    except Exception:
        return default


def clamp(v: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, v))


def pick_nl_for_depth(cabinet_depth_mm: float) -> int:
    """
    Auto zasada wg Twojego założenia:
    - w korpusie D nie można dać NL=D
    - bierzemy NL <= D-50 (np. D=500 => NL=450)
    """
    target = max(0.0, cabinet_depth_mm - 50.0)
    candidates = [nl for nl in STD_NL_MM if nl <= target]
    if not candidates:
        return max(0, min(STD_NL_MM))  # fallback najmniejszy
    return max(candidates)


class PartRectItem(QtWidgets.QGraphicsRectItem):
    def __init__(self, part_key: str, rect: QtCore.QRectF, selectable: bool = True):
        super().__init__(rect)
        self.part_key = part_key
        self.setAcceptHoverEvents(True)
        self.setFlag(QtWidgets.QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, bool(selectable))
        self._hover = False
        self._selected = False
        self._update_pen()
        # UI COMPACT v12 (styles)
        try:
            _qss = """
            /* compact inputs */
            QLineEdit, QSpinBox, QDoubleSpinBox {
                min-width: 70px;
                max-width: 95px;
                padding: 2px 6px;
            }
            QSpinBox, QDoubleSpinBox {
                padding-right: 4px;
            }
            /* bigger checkbox indicator */
            QCheckBox::indicator {
                width: 18px;
                height: 18px;
            }
            """
            self.setStyleSheet((self.styleSheet() or "") + _qss)
        except Exception:
            pass

    def set_selected(self, val: bool):
        self._selected = bool(val)
        self._update_pen()

    def hoverEnterEvent(self, event):
                # HOVER_DEBUG_V3
        try:
            sp = self.scenePos()
            key = getattr(self, "part_key", None) or getattr(self, "key", None) or ""
            print(f"[HOVER] {key} pos=({sp.x():.0f},{sp.y():.0f})", flush=True)
        except Exception:
            pass
        self._hover = True
        self._update_pen()
        super().hoverEnterEvent(event)

    def hoverLeaveEvent(self, event):
        self._hover = False
        self._update_pen()
        super().hoverLeaveEvent(event)

    def _update_pen(self):

        # Always assign pen (prevents UnboundLocalError)

        if getattr(self, '_selected', False):

            pen = QtGui.QPen(QtGui.QColor('#DC2626'), 2.4)

        elif getattr(self, '_hover', False):

            pen = QtGui.QPen(QtGui.QColor('#2563EB'), 2.0)

        else:

            pen = QtGui.QPen(QtGui.QColor('#111827'), 1.4)

        try:

            pen.setCosmetic(True)

        except Exception:

            pass

        self.setPen(pen)

        self.setBrush(QtCore.Qt.BrushStyle.NoBrush)
    def hoverMoveEvent(self, event):
        try:
            # scene units are mm in this app
            sp = self.scenePos()
            key = getattr(self, "part_key", None) or getattr(self, "key", None) or ""
            QtWidgets.QToolTip.showText(
                event.screenPos().toPoint(),
                f"{key} | pos: ({sp.x():.0f}, {sp.y():.0f}) mm",
            )
        except Exception:
            pass
        return super().hoverMoveEvent(event)

class DragPartRectItem(PartRectItem):
    """
    Draggable item with small overlay (Δ in mm). Works in scene units = mm.
    - shows bubble while dragging
    - bubble is editable; Enter commits Δ
    - stores override in ModuleWidget._pos_override_mm
    """
    def __init__(self, part_key: str, rect: QtCore.QRectF, mw: "ModuleWidget", axis: str = "y", selectable: bool = True):
        super().__init__(part_key, rect, selectable=selectable)
        self._mw = mw
        self._axis = axis
        self._dragging = False
        self._press_scene = None
        self._start_pos = QtCore.QPointF(0.0, 0.0)
        try:
            self.setCursor(QtCore.Qt.CursorShape.OpenHandCursor)
        except Exception:
            pass

    def mousePressEvent(self, event):
        if event.button() == QtCore.Qt.MouseButton.LeftButton:
            self._dragging = True
            self._press_scene = event.scenePos()
            self._start_pos = self.pos()
            try:
                self.setCursor(QtCore.Qt.CursorShape.ClosedHandCursor)
            except Exception:
                pass
            if self._mw is not None:
                self._mw._drag_begin(self, self._press_scene, self._start_pos)
            event.accept()
            return
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        if self._dragging and self._press_scene is not None:
            cur = event.scenePos()
            dx = cur.x() - self._press_scene.x()
            dy = cur.y() - self._press_scene.y()

            if self._axis == "y":
                new_pos = QtCore.QPointF(self._start_pos.x(), self._start_pos.y() + dy)
                delta_for_bubble = dy
            elif self._axis == "x":
                new_pos = QtCore.QPointF(self._start_pos.x() + dx, self._start_pos.y())
                delta_for_bubble = dx
            else:
                new_pos = QtCore.QPointF(self._start_pos.x() + dx, self._start_pos.y() + dy)
                delta_for_bubble = dy

            self.setPos(new_pos)
            if self._mw is not None:
                self._mw._drag_update(cur, delta_for_bubble, new_pos)
            event.accept()
            return
        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        if self._dragging:
            self._dragging = False
            try:
                self.setCursor(QtCore.Qt.CursorShape.OpenHandCursor)
            except Exception:
                pass
            if self._mw is not None:
                self._mw._drag_end()
            event.accept()
            return
        super().mouseReleaseEvent(event)
# ALT_DRAG_FILTER_V3
class AltDragViewportFilter(QtCore.QObject):
    """
    ALT+LMB drag (Y only) on QGraphicsView viewport with bubble ΔY and editable value.
    Stable 'zero': base_y is the original computed position per part_key, offset_y is user adjustment.
    - Enter 0 in dialog -> always returns to base_y.
    - ALT + DoubleClick -> offset=0 (back to base).
    - ESC during drag -> cancel (restore previous offset).
    Uses grabMouse/grabKeyboard to avoid stuck dragging.
    """
    def __init__(self, mw: "ModuleWidget"):
        super().__init__(mw)
        self.mw = mw

        self.active = False
        self.item = None
        self.key = None

        self.start_scene = QtCore.QPointF(0.0, 0.0)
        self.base_y = 0.0
        self.start_offset = 0.0

        self.bubble = None

    def _ensure_bubble(self):
        if self.bubble is not None:
            return
        try:
            t = QtWidgets.QGraphicsSimpleTextItem("")
            t.setZValue(999999)
            t.setVisible(False)
            self.mw.scene.addItem(t)
            self.bubble = t
        except Exception:
            self.bubble = None

    def _get_base_offset(self, it):
        key = getattr(it, "part_key", None)
        if key is None:
            return None, 0.0, 0.0

        off = 0.0
        try:
            off = float(self.mw._offset_y_by_key.get(key, 0.0))
        except Exception:
            off = 0.0

        base = None
        try:
            base = self.mw._base_y_by_key.get(key, None)
        except Exception:
            base = None

        if base is None:
            # define base as current_y - stored_offset (so 0 always maps to original)
            try:
                base = float(it.pos().y()) - off
            except Exception:
                base = 0.0
            try:
                self.mw._base_y_by_key[key] = float(base)
            except Exception:
                pass

        return key, float(base), float(off)

    def _set_offset(self, it, key, base, offset):
        try:
            if key is not None:
                self.mw._offset_y_by_key[key] = float(offset)
        except Exception:
            pass
        try:
            it.setPos(QtCore.QPointF(it.pos().x(), float(base) + float(offset)))
        except Exception:
            pass

    def _begin(self, it, scene_pos: QtCore.QPointF, viewport):
        self._ensure_bubble()
        key, base, off = self._get_base_offset(it)

        self.active = True
        self.item = it
        self.key = key

        self.start_scene = QtCore.QPointF(scene_pos.x(), scene_pos.y())
        self.base_y = float(base)
        self.start_offset = float(off)

        if self.bubble is not None:
            self.bubble.setText("ΔY: 0 mm  (ESC=cancel, ALT+dbl=0)")
            self.bubble.setPos(scene_pos + QtCore.QPointF(12, 12))
            self.bubble.setVisible(True)

        try:
            viewport.grabMouse()
        except Exception:
            pass
        try:
            viewport.grabKeyboard()
        except Exception:
            pass

    def _update(self, scene_pos: QtCore.QPointF):
        if not self.active or self.item is None:
            return
        dy = float(scene_pos.y() - self.start_scene.y())
        off = float(self.start_offset + dy)

        try:
            self.item.setPos(QtCore.QPointF(self.item.pos().x(), self.base_y + off))
        except Exception:
            pass

        if self.bubble is not None:
            self.bubble.setText(f"ΔY: {int(round(off))} mm  (ESC=cancel, ALT+dbl=0)")
            self.bubble.setPos(scene_pos + QtCore.QPointF(12, 12))

    def _finish(self, viewport, ask_value: bool = True):
        if not self.active:
            return
        it = self.item
        key = self.key
        base = float(self.base_y)

        # compute current offset from base
        cur_off = 0.0
        try:
            if it is not None:
                cur_off = float(it.pos().y()) - base
        except Exception:
            cur_off = float(self.start_offset)

        # stop capture first
        self.active = False
        self.item = None
        self.key = None

        if self.bubble is not None:
            self.bubble.setVisible(False)

        try:
            viewport.releaseMouse()
        except Exception:
            pass
        try:
            viewport.releaseKeyboard()
        except Exception:
            pass

        if it is None:
            return

        if not ask_value:
            return

        try:
            val, ok = QtWidgets.QInputDialog.getDouble(
                self.mw, "Точне зміщення", "ΔY (мм) від бази:",
                float(cur_off), -100000.0, 100000.0, 1
            )
            if ok:
                self._set_offset(it, key, base, float(val))
            else:
                # keep current position, but store it as offset so state stays consistent
                self._set_offset(it, key, base, float(cur_off))
        except Exception:
            # best-effort store current
            self._set_offset(it, key, base, float(cur_off))

    def _cancel(self, viewport):
        if not self.active:
            return
        it = self.item
        key = self.key
        base = float(self.base_y)
        off = float(self.start_offset)

        # restore previous offset
        try:
            if it is not None:
                it.setPos(QtCore.QPointF(it.pos().x(), base + off))
        except Exception:
            pass

        # keep stored offset unchanged (previous)
        try:
            if key is not None:
                self.mw._offset_y_by_key[key] = off
        except Exception:
            pass

        self._finish(viewport, ask_value=False)

    def _reset_to_zero(self, it, viewport):
        key, base, off = self._get_base_offset(it)
        self._set_offset(it, key, base, 0.0)

        # if currently dragging this same item, update drag baseline too
        if self.active and it is self.item:
            self.start_offset = 0.0
            self.base_y = float(base)
            self.start_scene = QtCore.QPointF(self.start_scene.x(), self.start_scene.y())

        return True

    def eventFilter(self, obj, event):
        try:
            v = getattr(self.mw, "view", None)
            if v is None:
                return False
            viewport = v.viewport()
            if obj is not viewport:
                return False

            et = event.type()

            if et == QtCore.QEvent.Type.KeyPress:
                if self.active and event.key() == QtCore.Qt.Key.Key_Escape:
                    self._cancel(viewport)
                    return True

            if et == QtCore.QEvent.Type.MouseButtonDblClick:
                if event.button() == QtCore.Qt.MouseButton.LeftButton:
                    mods = QtWidgets.QApplication.keyboardModifiers()
                    if mods & QtCore.Qt.KeyboardModifier.AltModifier:
                        sp = v.mapToScene(event.pos())
                        it = self.mw.scene.itemAt(sp, v.transform())
                        if it is not None and getattr(it, "part_key", None) is not None:
                            return self._reset_to_zero(it, viewport)

            if et == QtCore.QEvent.Type.MouseButtonPress:
                if event.button() == QtCore.Qt.MouseButton.LeftButton:
                    mods = QtWidgets.QApplication.keyboardModifiers()
                    if mods & QtCore.Qt.KeyboardModifier.AltModifier:
                        sp = v.mapToScene(event.pos())
                        it = self.mw.scene.itemAt(sp, v.transform())
                        if it is not None and getattr(it, "part_key", None) is not None:
                            self._begin(it, sp, viewport)
                            return True

            if et == QtCore.QEvent.Type.MouseMove:
                if self.active:
                    # safety: if left released -> finish
                    try:
                        if not (event.buttons() & QtCore.Qt.MouseButton.LeftButton):
                            self._finish(viewport, ask_value=True)
                            return True
                    except Exception:
                        pass
                    sp = v.mapToScene(event.pos())
                    self._update(sp)
                    return True

            if et == QtCore.QEvent.Type.MouseButtonRelease:
                if self.active and event.button() == QtCore.Qt.MouseButton.LeftButton:
                    self._finish(viewport, ask_value=True)
                    return True

        except Exception:
            pass
        return False



class ModuleWidget(QtWidgets.QWidget):
    def __init__(self, ctx, parent=None) -> None:
        super().__init__(parent)
        self.ctx = ctx
        self.settings: QSettings = getattr(ctx, "settings", QSettings("TECH_modul", "TECH_modul_qt"))

        proj_root = Path(__file__).resolve().parents[2]
        self.library = ModuleLibrary(proj_root / "data" / "modules.json")

        self.parts: Dict[str, Part] = {}
        # ALT_DRAG_ZERO_BASE_V2 state (stable base + offset)
        self._base_y_by_key = {}
        self._offset_y_by_key = {}
        self._pos_override_mm: Dict[str, QtCore.QPointF] = {}
        self._drag_item = None
        self._drag_start_item_pos = QtCore.QPointF(0.0, 0.0)
        self._drag_bubble_proxy = None
        self._drag_bubble_edit = None
        self._drag_bubble_label = None
        self.selected_key: str = "side_left"

        self._build_ui()
        self._install_alt_drag_filter_v3()
        self._populate_catalogs()
        self._load_state()

        self._rebuild_parts()
        self._refresh_scene()
        self._refresh_quick_panel()
        self._refresh_bom()
        self._refresh_project_tree()

        bus = getattr(self.ctx, "bus", None)
        sig = getattr(bus, "data_changed", None)
        if sig is not None and hasattr(sig, "connect"):
            try:
                sig.connect(self._on_data_changed)
            except Exception:
                pass

    @QtCore.Slot(object)
    def _on_data_changed(self, key: object) -> None:
        if str(key) == "catalogs":
            self._populate_catalogs()

    def closeEvent(self, e) -> None:
        try:
            self._save_state()
        except Exception:
            pass
        super().closeEvent(e)

