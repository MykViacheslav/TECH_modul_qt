        if p.material:
            idx = self.cb_q_material.findText(p.material)
            if idx >= 0:
                self.cb_q_material.blockSignals(True)
                self.cb_q_material.setCurrentIndex(idx)
                self.cb_q_material.blockSignals(False)

    def _apply_quick_material(self) -> None:
        p = self.parts.get(self.selected_key)
        if not p:
            return
        txt = self.cb_q_material.currentText().strip()
        if txt.startswith("—"):
            return
        p.material = txt
        self._refresh_bom()
        self._save_state()

    # -----------------------------
    # Drawers calc (AUTO)
    # -----------------------------
    def _drawer_height_mm(self) -> float:
        sys = self.cb_drawer_system.currentText()
        code = self.cb_drawer_height_code.currentText()
        if sys == "MERIVOBOX":
            return float(MERIVOBOX_HEIGHTS_MM.get(code, 91.0))
        return float(TANDEMBOX_HEIGHTS_MM.get(code, 116.0))

    def _drawer_board_thick_mm(self) -> float:
        # Na razie zgodnie z Twoim założeniem: MERIVOBOX i TANDEMBOX -> 16 mm
        return 16.0

    def _drawer_side_clear_total_mm(self) -> float:
        # Auto luz na boki - wg typowego założenia systemów metalowych (około 42 mm łącznie)
        # (doprecyzujemy, jeśli chcesz rozróżnienie systemów)
        return 42.0

    def _drawer_calc_area_m2(self) -> Tuple[str, float, int]:
        """
        Zwraca:
        - nazwa materiału (płyta do szuflad),
        - area_m2_total dla 1 modułu,
        - NL (nominal length)
        Liczymy: dno (Wbox x NL) + tył (Wbox x Hbox)
        """
        if self.cb_front_mode.currentText() != "Szuflady":
            return ("", 0.0, 0)

        W = float(self.in_W.value())
        H = float(self.in_H.value())
        D = float(self.in_D.value())
        t = float(self.in_thick.value())

        has_L = bool(self.ck_side_left.isChecked())
        has_R = bool(self.ck_side_right.isChecked())

        innerW = W - (t if has_L else 0.0) - (t if has_R else 0.0)
        innerW = max(0.0, innerW)

        n = int(self.in_front_count.value())

        nl = pick_nl_for_depth(D)
        box_h = self._drawer_height_mm()
        thick = self._drawer_board_thick_mm()

        # box width: innerW - clearance(system)
        w_box = max(0.0, innerW - self._drawer_side_clear_total_mm())
        d_box = float(nl)

        area_one = mm2_to_m2(w_box * d_box) + mm2_to_m2(w_box * box_h)
        area_total = area_one * n

        mat = f"Płyta {int(thick)} mm (szuflady)"
        return (mat, area_total, nl)

    # -----------------------------
    # BOM
    # -----------------------------
    def _hinges_for_height(self, h_mm: float) -> int:
        if h_mm <= 900:
            return 3
        if h_mm <= 1600:
            return 4
        return 5

    def _refresh_bom(self) -> None:
        qty = int(self.in_qty.value())
        lines: List[str] = []
        lines.append(f"Moduł: {self.in_name.text().strip() or '—'}   x{qty}")
        lines.append("")

        mats_m2: Dict[str, float] = {}

        def add_area(mat: str, a: float, b: float):
            if not mat:
                mat = "—"
            mats_m2[mat] = mats_m2.get(mat, 0.0) + mm2_to_m2(a * b)

        part_list = list(self.parts.values())
        self.lbl_parts.setText(f"parts: {len(part_list)}")

        for p in part_list:
            add_area(p.material or "—", p.a_mm, p.b_mm)

        # drawers
        mat_draw, area_draw, nl = self._drawer_calc_area_m2()
        if mat_draw and area_draw > 0:
            mats_m2[mat_draw] = mats_m2.get(mat_draw, 0.0) + area_draw

        lines.append("MATERIAŁY (m²):")
        for k in sorted(mats_m2.keys()):
            lines.append(f"- {k}: {mats_m2[k] * qty:.3f} m²")
        lines.append("")

        lines.append("OKUCIA:")
        # drzwi: zawiasy
        hinges_override = int(self.in_hinges_override.value())
        hinges_auto = bool(self.ck_hinges_auto.isChecked())
        hinges_total = 0
        if self.ck_front.isChecked() and self.cb_front_mode.currentText() == "Drzwi":
            for p in part_list:
                if p.key.startswith("front_"):
                    if hinges_override > 0:
                        hinges_total += hinges_override
        if hinges_total:
            lines.append(f"- Zawiasy: {hinges_total * qty} szt")

        # szuflady: prowadnice
        if self.cb_front_mode.currentText() == "Szuflady":
            n = int(self.in_front_count.value())
            system = self.cb_drawer_system.currentText()
            code = self.cb_drawer_height_code.currentText()
            lines.append(f"- Prowadnice szuflad (Blum {system} {code}, NL={nl}): {n * qty} kpl")

        legs = int(self.in_legs.value())
        hangers = int(self.in_hangers.value())
        pins_per_shelf = int(self.in_pins_per_shelf.value())
        shelf_count = sum(1 for p in part_list if p.key.startswith("shelf_"))

        if legs:
            lines.append(f"- Nóżki: {legs * qty} szt")
        if hangers:
            lines.append(f"- Zawieszki: {hangers * qty} szt")
        if shelf_count and pins_per_shelf:
            lines.append(f"- Podpórki półek: {shelf_count * pins_per_shelf * qty} szt")

        self.txt_bom.setPlainText("\n".join(lines))

    def _refresh_project_tree(self) -> None:
        tree = getattr(self, "tree", None)
        if tree is None:
            return

        tree.blockSignals(True)
        try:
            tree.clear()

            name = self.in_name.text().strip() if hasattr(self, "in_name") else ""
            name = name or "—"

            root = QtWidgets.QTreeWidgetItem(["Moduł", name])
            tree.addTopLevelItem(root)
            root.setExpanded(True)

            # dims
            dims = QtWidgets.QTreeWidgetItem(["Wymiary", ""])
            try:
                dims.addChild(QtWidgets.QTreeWidgetItem(["W (mm)", f"{float(self.in_W.value()):.1f}"]))
                dims.addChild(QtWidgets.QTreeWidgetItem(["H (mm)", f"{float(self.in_H.value()):.1f}"]))
                dims.addChild(QtWidgets.QTreeWidgetItem(["D (mm)", f"{float(self.in_D.value()):.1f}"]))
            except Exception:
                pass
            root.addChild(dims)

            # parts
            parts_node = QtWidgets.QTreeWidgetItem(["Części", f"{len(self.parts)}"])
            root.addChild(parts_node)

            for key, p in sorted(self.parts.items(), key=lambda kv: kv[0]):
                node = QtWidgets.QTreeWidgetItem([p.name_pl, p.key])
                node.setData(0, QtCore.Qt.ItemDataRole.UserRole, p.key)
                parts_node.addChild(node)

                node.addChild(QtWidgets.QTreeWidgetItem(
                    ["Wymiary (A×B×T)", f"{p.a_mm:.0f}×{p.b_mm:.0f}×{p.thick_mm:.0f} mm"]
                ))
                node.addChild(QtWidgets.QTreeWidgetItem(["Materiał", p.material or "—"]))

                e = getattr(p, "edges", None)
                if e is not None and any(getattr(e, k, "") for k in ("L", "P", "G", "D")):
                    edges = QtWidgets.QTreeWidgetItem(["Okleina", ""])
                    edges.addChild(QtWidgets.QTreeWidgetItem(["L", getattr(e, "L", "") or "—"]))
                    edges.addChild(QtWidgets.QTreeWidgetItem(["P", getattr(e, "P", "") or "—"]))
                    edges.addChild(QtWidgets.QTreeWidgetItem(["G", getattr(e, "G", "") or "—"]))
                    edges.addChild(QtWidgets.QTreeWidgetItem(["D", getattr(e, "D", "") or "—"]))
                    node.addChild(edges)

            tree.expandToDepth(1)
            tree.resizeColumnToContents(0)
        finally:
            tree.blockSignals(False)

    def _on_tree_clicked(self, item: QtWidgets.QTreeWidgetItem, column: int) -> None:
        key = item.data(0, QtCore.Qt.ItemDataRole.UserRole)
        if isinstance(key, str) and key in self.parts:
            self._select_part(key)

            # best-effort: center on scene item
            try:
                for it in self.scene.items():
                    if isinstance(it, PartRectItem) and getattr(it, "part_key", None) == key:
                        self.view.centerOn(it)
                        break
            except Exception:
                pass

    # -----------------------------
    # Drag bubble (Δ mm + editable)
    # -----------------------------
    def _ensure_drag_bubble(self) -> None:
        if getattr(self, "_drag_bubble_proxy", None) is not None:
            return

        w = QtWidgets.QWidget()
        w.setObjectName("dragBubble")
        w.setStyleSheet("""
        QWidget#dragBubble {
            background: rgba(255,255,255,235);
            border: 1px solid rgba(15,23,42,60);
            border-radius: 8px;
        }
        QLabel { color:#0f172a; font-weight:900; }
        QLineEdit {
            min-width: 70px;
            padding: 3px 6px;
            border: 1px solid rgba(15,23,42,60);
            border-radius: 6px;
            font-weight: 900;
        }
        """)

        lay = QtWidgets.QHBoxLayout(w)
        lay.setContentsMargins(8, 6, 8, 6)
        lay.setSpacing(6)

        lab = QtWidgets.QLabel("ΔY (mm):")
        edit = QtWidgets.QLineEdit("0")
        edit.setAlignment(QtCore.Qt.AlignmentFlag.AlignRight | QtCore.Qt.AlignmentFlag.AlignVCenter)
        edit.setFixedWidth(80)
        suffix = QtWidgets.QLabel("mm")

        lay.addWidget(lab)
        lay.addWidget(edit)
        lay.addWidget(suffix)

        proxy = self.scene.addWidget(w)
        proxy.setZValue(100000)
        proxy.setVisible(False)

        self._drag_bubble_proxy = proxy
        self._drag_bubble_edit = edit
        self._drag_bubble_label = lab

        def commit():
            self._drag_commit_from_edit()
        edit.returnPressed.connect(commit)

    def _drag_begin(self, item: QtWidgets.QGraphicsItem, scene_pos: QtCore.QPointF, start_item_pos: QtCore.QPointF) -> None:
        self._ensure_drag_bubble()
        self._drag_item = item
        self._drag_start_item_pos = QtCore.QPointF(start_item_pos.x(), start_item_pos.y())

        # show bubble near cursor
        self._drag_bubble_proxy.setPos(scene_pos + QtCore.QPointF(16, 16))
        self._drag_bubble_proxy.setVisible(True)

        # set editable value = 0
        try:
            self._drag_bubble_edit.setText("0")
            self._drag_bubble_edit.selectAll()
        except Exception:
            pass

    def _drag_update(self, scene_pos: QtCore.QPointF, delta_mm: float, new_item_pos: QtCore.QPointF) -> None:
        if getattr(self, "_drag_bubble_proxy", None) is None:
            return
        if self._drag_bubble_proxy.isVisible():
            self._drag_bubble_proxy.setPos(scene_pos + QtCore.QPointF(16, 16))
        # update text (keep it simple: int mm)
        try:
            self._drag_bubble_edit.setText(str(int(round(delta_mm))))
        except Exception:
            pass

        # persist override
        try:
            key = getattr(self._drag_item, "part_key", None)
            if isinstance(key, str):
                self._pos_override_mm[key] = QtCore.QPointF(new_item_pos.x(), new_item_pos.y())
        except Exception:
            pass

    def _drag_commit_from_edit(self) -> None:
        # Enter in edit: apply Δ mm exactly
        if self._drag_item is None:
            return
        try:
            txt = self._drag_bubble_edit.text().strip()
            dy = safe_float(txt, 0.0)
        except Exception:
            dy = 0.0

        # move only Y by dy relative to drag start pos
        try:
            cur = self._drag_item.pos()
            new_pos = QtCore.QPointF(self._drag_start_item_pos.x(), self._drag_start_item_pos.y() + dy)
            self._drag_item.setPos(new_pos)

            key = getattr(self._drag_item, "part_key", None)
            if isinstance(key, str):
                self._pos_override_mm[key] = QtCore.QPointF(new_pos.x(), new_pos.y())
        except Exception:
            pass

        self._drag_end()

    def _drag_end(self) -> None:
        if getattr(self, "_drag_bubble_proxy", None) is not None:
            try:
                self._drag_bubble_proxy.setVisible(False)
            except Exception:
                pass
        self._drag_item = None

    def _install_alt_drag_filter_v3(self) -> None:
        # ALT_DRAG_FILTER_V3 install
        try:
            v = getattr(self, "view", None)
            if v is None:
                v = self.findChild(QtWidgets.QGraphicsView)
                if v is not None:
                    self.view = v
            if v is None:
                return
            if getattr(self, "_alt_drag_filter_v3", None) is None:
                self._alt_drag_filter_v3 = AltDragViewportFilter(self)
                v.viewport().installEventFilter(self._alt_drag_filter_v3)
                v.viewport().setMouseTracking(True)
                v.setMouseTracking(True)
                v.viewport().setFocusPolicy(QtCore.Qt.FocusPolicy.StrongFocus)
        except Exception:
            pass
    # -----------------------------
    # Actions
    # -----------------------------
    def _on_recalc(self) -> None:
        self._rebuild_parts()
        self._refresh_scene()
        self._refresh_quick_panel()
        self._refresh_bom()
        self._save_state()
        # FRONT BOM v14 add FRONT row if enabled
        try:
            # FRONT enabled?
            _front_on = False
            _chk = getattr(self, 'ck_front', None)
            if _chk is not None and hasattr(_chk, 'isChecked'):
                _front_on = bool(_chk.isChecked())
        
            if _front_on:
                # best-effort dimension getter
                def _dim_mm(_key: str, _default: float = 0.0) -> float:
                    k = (_key or '').lower()
                    # try common spinboxes by attribute name
                    candidates = []
                    if k in ('w','width','szer','szerokosc','szerokość'):
                        candidates = ['sp_w','sb_w','spin_w','sp_width','sb_width','spin_width','sp_szer','sb_szer','spin_szer']
                    elif k in ('h','height','wys','wysokosc','wysokość'):
                        candidates = ['sp_h','sb_h','spin_h','sp_height','sb_height','spin_height','sp_wys','sb_wys','spin_wys']
                    elif k in ('d','depth','gleb','glebokosc','głębokość'):
                        candidates = ['sp_d','sb_d','spin_d','sp_depth','sb_depth','spin_depth','sp_gleb','sb_gleb','spin_gleb']
                    for nm in candidates:
                        w = getattr(self, nm, None)
                        if w is not None and hasattr(w, 'value'):
                            try:
                                return float(w.value())
                            except Exception:
                                pass
                    # fallback: scan all attributes
                    for nm, w in self.__dict__.items():
                        if not isinstance(nm, str):
                            continue
                        nml = nm.lower()
                        if k == 'w' and ('width' in nml or 'szer' in nml):
                            if hasattr(w, 'value'):
                                if True:
                                    pass
                        if k == 'h' and ('height' in nml or 'wys' in nml):
                            if hasattr(w, 'value'):
                                if True:
                                    pass
                        if k == 'd' and ('depth' in nml or 'gleb' in nml):
                            if hasattr(w, 'value'):
                                if True:
                                    pass
                    return float(_default)
        
                W = _dim_mm('w', 0.0)
                H = _dim_mm('h', 0.0)
                area_m2 = max(0.0, (W/1000.0) * (H/1000.0))
        
                # find materials table (common names)
                tbl = None
                for _nm in ('tbl_mat','tbl_materials','tbl_material','table_materials','table_mat','tbl_bom','tbl_qty'):
                    _t = getattr(self, _nm, None)
                    if _t is not None and hasattr(_t, 'rowCount') and hasattr(_t, 'insertRow'):
                        tbl = _t
                        break
        
                if tbl is not None:
                    from PySide6.QtWidgets import QTableWidgetItem
                    r = tbl.rowCount()
                    tbl.insertRow(r)
                    cols = int(tbl.columnCount()) if hasattr(tbl, 'columnCount') else 1
                    if cols >= 1:
                        tbl.setItem(r, 0, QTableWidgetItem('Front'))
                    if cols >= 2:
                        tbl.setItem(r, 1, QTableWidgetItem(f"{area_m2:.3f}"))
                    if cols >= 3:
                        tbl.setItem(r, 2, QTableWidgetItem('m²'))
        except Exception:
            pass
        # FRONT BOM v15
        try:
            _front_on = False
            if hasattr(self, 'ck_front') and self.ck_front is not None:
                try:
                    _front_on = bool(self.ck_front.isChecked())
                except Exception:
                    _front_on = False
        
            if _front_on:
                W = float(self.in_W.value()) if hasattr(self, 'in_W') else 0.0
                H = float(self.in_H.value()) if hasattr(self, 'in_H') else 0.0
                area_m2 = max(0.0, (W/1000.0) * (H/1000.0))
                cnt = int(self.in_front_count.value()) if hasattr(self, 'in_front_count') else 1
                mat = ''
                if hasattr(self, 'cb_front_mat') and self.cb_front_mat is not None:
                    try:
                        mat = self.cb_front_mat.currentText().strip()
                    except Exception:
                        mat = ''
                lines.append(f"Front: {area_m2:.3f} m2  | szt: {cnt}  | mat: {mat or '-'}")
        except Exception:
            pass


    def _on_reset(self) -> None:
        self.in_W.setValue(600.0)
        self.in_H.setValue(720.0)
        self.in_D.setValue(560.0)
        self.in_thick.setValue(18.0)
        self.in_back_thick.setValue(3.0)
        self.in_shelves.setValue(0)
        self.in_qty.setValue(1)
        self.ck_middle.setChecked(False)
        self.ck_split_shelves.setChecked(True)
        self._on_recalc()

    # -----------------------------
    # DB: save/load
    # -----------------------------
    def _export_state(self) -> Dict[str, Any]:
        return {
            "name": self.in_name.text(),
            "W": self.in_W.value(),
            "H": self.in_H.value(),
            "D": self.in_D.value(),
            "front_mode": self.cb_front_mode.currentText(),
            "front_hmode": self.cb_front_hmode.currentText(),
            "front_count": self.in_front_count.value(),
            "front_gap": self.in_front_gap.value(),
            "front_side_offset": self.in_front_side.value(),
            "thick": self.in_thick.value(),
            "back_thick": self.in_back_thick.value(),
            "shelves_count": self.in_shelves.value(),
            "shelves_split": self.ck_split_shelves.isChecked(),
            "qty": self.in_qty.value(),
            "drawer": {
                "system": self.cb_drawer_system.currentText(),
                "height_code": self.cb_drawer_height_code.currentText(),
            },
        }

    def _save_to_db(self) -> None:
        name = (self.in_name.text() or "").strip()
        if not name:
            QtWidgets.QMessageBox.warning(self, "Brak nazwy", "Podaj nazwę modułu przed zapisem.")
            return
        try:
            state = self._export_state()
            record = ModuleRecord(name=name, state=state)
            self.library.upsert(record)
            QtWidgets.QMessageBox.information(self, "Zapisano", f"Zapisano moduł do bazy: {name}")
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Błąd zapisu", f"Nie udało się zapisać do bazy.\n\nPowód: {e}")

    def _load_from_db(self) -> None:
        name = (self.in_name.text() or "").strip()
        if not name:
            QtWidgets.QMessageBox.warning(self, "Brak nazwy", "Wpisz nazwę modułu do wczytania.")
            return
        if True:
            rec = self.library.get(name)
            st = rec.state or {}
            self.in_W.setValue(safe_float(st.get("W", 600.0), 600.0))
            self.in_H.setValue(safe_float(st.get("H", 720.0), 720.0))
            self.in_D.setValue(safe_float(st.get("D", 560.0), 560.0))

            fm = str(st.get("front_mode", "Drzwi"))
            idx = self.cb_front_mode.findText(fm)
            if idx >= 0:
                self.cb_front_mode.setCurrentIndex(idx)

            hm = str(st.get("front_hmode", "Na całą wysokość"))
            idx = self.cb_front_hmode.findText(hm)
            if idx >= 0:
                self.cb_front_hmode.setCurrentIndex(idx)

            self.in_front_count.setValue(safe_int(st.get("front_count", 2), 2))
            self.in_front_gap.setValue(safe_float(st.get("front_gap", 2.0), 2.0))
            self.in_front_side.setValue(safe_float(st.get("front_side_offset", 2.0), 2.0))

            self.in_thick.setValue(safe_float(st.get("thick", 18.0), 18.0))
            self.in_back_thick.setValue(safe_float(st.get("back_thick", 3.0), 3.0))
            self.in_shelves.setValue(safe_int(st.get("shelves_count", 0), 0))
            self.ck_split_shelves.setChecked(bool(st.get("shelves_split", True)))
            self.in_qty.setValue(safe_int(st.get("qty", 1), 1))

            dr = st.get("drawer", {}) or {}
            sys = str(dr.get("system", "MERIVOBOX"))
            idx = self.cb_drawer_system.findText(sys)
            if idx >= 0:
                self.cb_drawer_system.setCurrentIndex(idx)

            code = str(dr.get("height_code", "M"))
            idx = self.cb_drawer_height_code.findText(code)
            if idx >= 0:
                self.cb_drawer_height_code.setCurrentIndex(idx)

            self._on_recalc()
            QtWidgets.QMessageBox.information(self, "Wczytano", f"Wczytano moduł z bazy: {name}")

