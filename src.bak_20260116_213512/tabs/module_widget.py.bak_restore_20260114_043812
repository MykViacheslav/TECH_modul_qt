# -----------------------------
# Model
# -----------------------------
@dataclass
class EdgeMap:
    # L/P/G/D = lewa/prawa/góra/dół (na elemencie)
    L: str = ""
    P: str = ""
    G: str = ""
    D: str = ""


@dataclass
class Part:
    key: str
    name_pl: str
    w_mm: float
    h_mm: float
    material: str = ""
    edges: EdgeMap = field(default_factory=EdgeMap)


@dataclass
class ModuleState:
    # Wymiary
    W: float = 600.0
    H: float = 720.0
    D: float = 560.0

    # konstrukcja
    thick: float = 18.0
    back_enabled: bool = True
    back_thick: float = 3.0
    middle_wall: bool = False
    shelves_count: int = 0
    shelves_split_with_middle: bool = True

    # fronty/szuflady
    front_mode: str = "Drzwi"  # Drzwi / Szuflady / Brak
    front_count: int = 2
    front_gap: float = 2.0
    front_side_offset: float = 2.0  # "Front: odstęp od boków"
    front_height_mode: str = "Na całą wysokość"  # Na całą wysokość / Między wieńcami
    front_material: str = ""

    qty: int = 1


def mm2_to_m2(mm2: float) -> float:
    return mm2 / 1_000_000.0


def mm_to_m(mm: float) -> float:
    return mm / 1000.0


# -----------------------------
# Graphics items (hover/selection)
# -----------------------------
class PartRectItem(QtWidgets.QGraphicsRectItem):
    def __init__(self, part_key: str, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.part_key = part_key
        self.setAcceptHoverEvents(True)
        self._hover = False
        self._selected = False
        self._update_pen()

    def set_selected(self, val: bool):
        self._selected = bool(val)
        self._update_pen()

    def hoverEnterEvent(self, event):
        self._hover = True
        self._update_pen()
        super().hoverEnterEvent(event)

    def hoverLeaveEvent(self, event):
        self._hover = False
        self._update_pen()
        super().hoverLeaveEvent(event)

    def _update_pen(self):
        # hover=niebieski, selected=czerwony
        if self._selected:
            pen = QtGui.QPen(QtGui.QColor("#DC2626"), 2.4)
        elif self._hover:
            pen = QtGui.QPen(QtGui.QColor("#2563EB"), 2.0)
        else:
            pen = QtGui.QPen(QtGui.QColor("#111827"), 1.4)
        self.setPen(pen)
        self.setBrush(QtCore.Qt.BrushStyle.NoBrush)


