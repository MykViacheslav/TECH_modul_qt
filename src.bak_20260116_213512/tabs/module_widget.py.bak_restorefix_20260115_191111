                dol=self.edge_carcass["dol"].isChecked(),
            ),
            edge_shelves=EdgeFlags(
                przod=self.edge_shelves["przod"].isChecked(),
                boki=self.edge_shelves["boki"].isChecked(),
                gora=self.edge_shelves["gora"].isChecked(),
                dol=self.edge_shelves["dol"].isChecked(),
            ),
            edge_middle=EdgeFlags(
                przod=self.edge_middle["przod"].isChecked(),
                boki=self.edge_middle["boki"].isChecked(),
                gora=self.edge_middle["gora"].isChecked(),
                dol=self.edge_middle["dol"].isChecked(),
            ),
            edge_top=EdgeFlags(
                przod=self.edge_top["przod"].isChecked(),
                boki=self.edge_top["boki"].isChecked(),
                gora=self.edge_top["gora"].isChecked(),
                dol=self.edge_top["dol"].isChecked(),
            ),
