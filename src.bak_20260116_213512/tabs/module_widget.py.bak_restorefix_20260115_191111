        self.edge_middle["przod"].setChecked(True)
        for cb in self.edge_top.values(): cb.setChecked(False)
        self.edge_top["przod"].setChecked(True)
        self.edge_top["boki"].setChecked(True)

        self._refresh_all()

    # ---------------- geometry helpers ----------------
