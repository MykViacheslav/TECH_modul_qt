    def _populate_catalogs(self) -> None:
        def fill(cb: QtWidgets.QComboBox, names: List[str], placeholder: str):
            cb.blockSignals(True)
            try:
                cur = cb.currentText()
                cb.clear()
                cb.addItem(placeholder)
                for n in names:
                    cb.addItem(n)
                # try restore
                idx = cb.findText(cur)
                if idx >= 0:
                    cb.setCurrentIndex(idx)
            finally:
                cb.blockSignals(False)

        catalogs = getattr(self.ctx, "catalogs", None)
        mats: List[str] = []
        edges: List[str] = []

        try:
            if catalogs and hasattr(catalogs, "get_materials"):
                mats = [getattr(x, "name", str(x)) for x in catalogs.get_materials()]
        except Exception:
            mats = []
        try:
            if catalogs and hasattr(catalogs, "get_edges"):
                edges = [getattr(x, "name", str(x)) for x in catalogs.get_edges()]
        except Exception:
            edges = []

        fill(self.cb_material, mats, "— wybierz materiał —")
        fill(self.cb_edge, edges, "— wybierz krawędź —")

    # ------------- state -------------
    def _load_state(self) -> None:
        s = self.settings
        s.beginGroup("module")
        try:
            self.sp_w.setValue(_safe_float(s.value("w_mm", 600), 600))
            self.sp_h.setValue(_safe_float(s.value("h_mm", 720), 720))
            self.sp_d.setValue(_safe_float(s.value("d_mm", 560), 560))

            mode = str(s.value("front_mode", "Drzwi"))
            idx = self.cb_mode.findText(mode)
            if idx >= 0:
                self.cb_mode.setCurrentIndex(idx)

            self.sp_front_count.setValue(int(_safe_float(s.value("front_count", 2), 2)))
            self.sp_gap.setValue(_safe_float(s.value("gap_mm", 2.0), 2.0))
            self.sp_inset.setValue(_safe_float(s.value("inset_mm", 0.0), 0.0))
            self.sp_qty.setValue(int(_safe_float(s.value("qty", 1), 1)))
            self.ck_handles.setChecked(str(s.value("handles", "true")).lower() in ("1","true","tak","yes"))

            self.sp_thick.setValue(_safe_float(s.value("thickness_mm", 18.0), 18.0))
            self.ck_back.setChecked(str(s.value("back_panel", "true")).lower() in ("1","true","tak","yes"))
            self.sp_back_thick.setValue(_safe_float(s.value("back_thickness_mm", 3.0), 3.0))

            self.ck_middle.setChecked(str(s.value("middle_wall", "false")).lower() in ("1","true","tak","yes"))
            self.sp_shelves.setValue(int(_safe_float(s.value("shelves_count", 0), 0)))
            self.ck_split_shelves.setChecked(str(s.value("shelves_split", "true")).lower() in ("1","true","tak","yes"))

            # edge flags
            def load_flags(prefix: str, d: Dict[str, QtWidgets.QCheckBox], defaults: Dict[str, bool]):
                for k, cb in d.items():
                    cb.setChecked(str(s.value(f"{prefix}_{k}", "true" if defaults.get(k, False) else "false")).lower() in ("1","true","tak","yes"))

            load_flags("edge_carcass", self.edge_carcass, {"przod": True})
            load_flags("edge_shelves", self.edge_shelves, {"przod": True})
            load_flags("edge_middle",  self.edge_middle,  {"przod": True})
            load_flags("edge_top",     self.edge_top,     {"przod": True, "boki": True})

            sizes = s.value("split_sizes", None)
            if sizes:
                try:
                    self.split.setSizes([int(x) for x in sizes])
                except Exception:
                    pass
        finally:
            s.endGroup()

    def _save_state(self) -> None:
        s = self.settings
        s.beginGroup("module")
        try:
            s.setValue("w_mm", self.sp_w.value())
            s.setValue("h_mm", self.sp_h.value())
            s.setValue("d_mm", self.sp_d.value())
            s.setValue("front_mode", self.cb_mode.currentText())
            s.setValue("front_count", self.sp_front_count.value())
            s.setValue("gap_mm", self.sp_gap.value())
            s.setValue("inset_mm", self.sp_inset.value())
            s.setValue("qty", self.sp_qty.value())
            s.setValue("handles", "true" if self.ck_handles.isChecked() else "false")

            s.setValue("thickness_mm", self.sp_thick.value())
            s.setValue("back_panel", "true" if self.ck_back.isChecked() else "false")
            s.setValue("back_thickness_mm", self.sp_back_thick.value())

            s.setValue("middle_wall", "true" if self.ck_middle.isChecked() else "false")
            s.setValue("shelves_count", self.sp_shelves.value())
            s.setValue("shelves_split", "true" if self.ck_split_shelves.isChecked() else "false")

            def save_flags(prefix: str, d: Dict[str, QtWidgets.QCheckBox]):
                for k, cb in d.items():
                    s.setValue(f"{prefix}_{k}", "true" if cb.isChecked() else "false")

            save_flags("edge_carcass", self.edge_carcass)
            save_flags("edge_shelves", self.edge_shelves)
            save_flags("edge_middle",  self.edge_middle)
            save_flags("edge_top",     self.edge_top)

            s.setValue("split_sizes", self.split.sizes())
        finally:
            s.endGroup()

    def closeEvent(self, e) -> None:
        try:
            self._save_state()
        except Exception:
            pass
        super().closeEvent(e)

    # ------------- actions -------------
