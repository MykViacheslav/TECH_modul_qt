        return p

    def _internal_dims(self, p: ModuleParams) -> Tuple[float, float, float]:
        t = max(0.0, p.thickness_mm)
        iw = max(0.0, p.w_mm - 2*t)
        ih = max(0.0, p.h_mm - 2*t)
        idp = max(0.0, p.d_mm)  # w uproszczeniu: pełna głębokość
        return iw, ih, idp

    def _calc_front_panels(self, p: ModuleParams) -> List[Tuple[float, float, float, float]]:
        rects: List[Tuple[float, float, float, float]] = []
        if p.front_mode == "Brak":
            return rects
        n = max(1, p.front_count)
        gap = max(0.0, p.gap_mm)
        if p.front_mode == "Drzwi":
            total_gap = gap * (n - 1)
            panel_w = max(0.0, (p.w_mm - total_gap) / n)
            x = 0.0
            for _ in range(n):
                rects.append((x, 0.0, panel_w, p.h_mm))
                x += panel_w + gap
        else:
            total_gap = gap * (n - 1)
            panel_h = max(0.0, (p.h_mm - total_gap) / n)
            y = 0.0
            for _ in range(n):
                rects.append((0.0, y, p.w_mm, panel_h))
                y += panel_h + gap
        return rects

    # ---------------- BOM helpers ----------------
    def _edge_len_for_rect(self, w: float, h: float, flags: EdgeFlags) -> float:
        """
        Długość okleiny (mm) dla elementu (prostokąt w x h).
        Interpretacja:
        - przód -> krawędź "frontowa" = szerokość (w)
        - boki  -> dwie krawędzie boczne = 2*h
        - góra  -> górna krawędź = w
        - dół   -> dolna krawędź = w
        To jest praktyczny model dla półki/blatu. Dla boków/przegrody traktujemy:
        - "przód" = wysokość (h), "góra/dół" = głębokość (w) — ustawiamy świadomie przy wywołaniu.
        """
        total = 0.0
        if flags.przod:
            total += w
        if flags.boki:
            total += 2*h
        if flags.gora:
            total += w
        if flags.dol:
            total += w
        return total

    def _build_bom(self, p: ModuleParams) -> str:
        t = max(0.0, p.thickness_mm)
        iw, ih, idp = self._internal_dims(p)

        lines: List[str] = []
        lines.append("PARAMETRY")
        lines.append(f"- W: {p.w_mm:.1f} mm, H: {p.h_mm:.1f} mm, D: {p.d_mm:.1f} mm")
        lines.append(f"- Grubość płyty: {t:.1f} mm  |  Plecy: {'Tak' if p.back_panel else 'Nie'} ({p.back_thickness_mm:.1f} mm)")
        lines.append(f"- Fronty: {p.front_mode}  |  ilość: {p.front_count}  |  gap: {p.gap_mm:.1f} mm  |  inset: {p.inset_mm:.1f} mm")
        lines.append(f"- Przegroda: {'Tak' if p.middle_wall else 'Nie'}  |  Półki: {p.shelves_count}  |  Dziel półki: {'Tak' if p.shelves_split_with_middle else 'Nie'}")
        lines.append(f"- Ilość modułów: {p.qty}")
        if p.material:
            lines.append(f"- Materiał: {p.material}")
        if p.edge:
            lines.append(f"- Krawędź: {p.edge}")

        lines.append("")
        lines.append("ELEMENTY (na 1 moduł)")

        # Korpus: boki, góra, dół
        # Boki: H x D
        # dla boków przyjmujemy: "przód" = H, "góra/dół" = D, "boki" ignorujemy (sens mniej jasny)
        def edge_len_side(H: float, D: float, flags: EdgeFlags) -> float:
            total = 0.0
            if flags.przod: total += H
            if flags.gora:  total += D
            if flags.dol:   total += D
            # flags.boki pomijamy dla boków
            return total

        edge_m_total = 0.0

        side_edge = edge_len_side(p.h_mm, p.d_mm, p.edge_carcass)
        edge_m_total += 2 * _mm_to_m(side_edge)

        lines.append(f"- Bok lewy:  {p.h_mm:.1f} x {p.d_mm:.1f} mm  | okleina: { _mm_to_m(side_edge):.3f} m")
        lines.append(f"- Bok prawy: {p.h_mm:.1f} x {p.d_mm:.1f} mm  | okleina: { _mm_to_m(side_edge):.3f} m")

        # Góra i dół: W-2t x D
        top_w = max(0.0, p.w_mm - 2*t)
        top_h = max(0.0, p.d_mm)
        top_edge_len_mm = self._edge_len_for_rect(top_w, top_h, p.edge_carcass)
        edge_m_total += 2 * _mm_to_m(top_edge_len_mm)

        lines.append(f"- Góra (wew.): {top_w:.1f} x {top_h:.1f} mm  | okleina: { _mm_to_m(top_edge_len_mm):.3f} m")
        lines.append(f"- Dół  (wew.): {top_w:.1f} x {top_h:.1f} mm  | okleina: { _mm_to_m(top_edge_len_mm):.3f} m")

        # Plecy: W x H (HDF) - bez okleiny
        if p.back_panel:
            lines.append(f"- Plecy: {p.w_mm:.1f} x {p.h_mm:.1f} mm  (HDF)")

        # Przegroda środkowa: (H-2t) x D
        if p.middle_wall:
            mw_h = max(0.0, p.h_mm - 2*t)
            mw_d = max(0.0, p.d_mm)
            mw_edge = edge_len_side(mw_h, mw_d, p.edge_middle)
            edge_m_total += _mm_to_m(mw_edge)
            lines.append(f"- Przegroda: {mw_h:.1f} x {mw_d:.1f} mm  | okleina: { _mm_to_m(mw_edge):.3f} m")

        # Półki
        if p.shelves_count > 0:
            if p.middle_wall and p.shelves_split_with_middle:
                # dwie półki na poziom (lewa+ prawa)
                shelf_w = max(0.0, (iw - t) / 2.0)  # iw = W-2t, minus przegroda
                shelf_d = max(0.0, p.d_mm)
                shelf_edge_len_mm = self._edge_len_for_rect(shelf_w, shelf_d, p.edge_shelves)
                qty_parts = p.shelves_count * 2
                edge_m_total += qty_parts * _mm_to_m(shelf_edge_len_mm)
                lines.append(f"- Półki (dzielone): {qty_parts} szt | {shelf_w:.1f} x {shelf_d:.1f} mm | okleina/szt: {_mm_to_m(shelf_edge_len_mm):.3f} m")
            else:
                shelf_w = max(0.0, iw)
                shelf_d = max(0.0, p.d_mm)
                shelf_edge_len_mm = self._edge_len_for_rect(shelf_w, shelf_d, p.edge_shelves)
                qty_parts = p.shelves_count
                edge_m_total += qty_parts * _mm_to_m(shelf_edge_len_mm)
                lines.append(f"- Półki: {qty_parts} szt | {shelf_w:.1f} x {shelf_d:.1f} mm | okleina/szt: {_mm_to_m(shelf_edge_len_mm):.3f} m")

        # Blat: W x D (często okleinowany przód + boki)
        top_edge_mm = self._edge_len_for_rect(p.w_mm, p.d_mm, p.edge_top)
        edge_m_total += _mm_to_m(top_edge_mm)
        lines.append(f"- Blat: {p.w_mm:.1f} x {p.d_mm:.1f} mm | okleina: {_mm_to_m(top_edge_mm):.3f} m")

        # Fronty
        panels = self._calc_front_panels(p)
        if p.front_mode != "Brak":
            area_m2 = 0.0
            for (_, _, w, h) in panels:
                area_m2 += _mm_to_m2(w*h)
            lines.append(f"- Fronty: {len(panels)} szt | suma powierzchni: {area_m2:.3f} m²")

        lines.append("")
        lines.append("OKLEINA (SUMA)")
        lines.append(f"- Okleina na 1 moduł: {edge_m_total:.3f} m")
        lines.append(f"- Okleina x{p.qty}: {edge_m_total * p.qty:.3f} m")

        return "\n".join(lines)

    # ---------------- SVG ----------------
    def _build_svg(self, p: ModuleParams) -> bytes:
        box_w = 320.0
        box_h = 320.0
        pad = 22.0
        gap_boxes = 36.0

        s = min(
            (box_w - 2*pad) / max(p.w_mm, 1.0),
            (box_h - 2*pad) / max(p.h_mm, 1.0),
            (box_w - 2*pad) / max(p.w_mm, 1.0),
            (box_h - 2*pad) / max(p.d_mm, 1.0)
        )

        front_x = 0.0
        top_x = box_w + gap_boxes
        view_w = box_w*2 + gap_boxes
        view_h = box_h

        stroke = 1.2
        col_main = "#334155"
        col_inset = "#F59E0B"
        col_soft = "#64748B"

        def rect(x,y,w,h,stroke_col,sw,rx=8):
            return f'<rect x="{x:.2f}" y="{y:.2f}" width="{w:.2f}" height="{h:.2f}" fill="none" stroke="{stroke_col}" stroke-width="{sw}" rx="{rx}"/>'

        def line(x1,y1,x2,y2,col,sw, dash=False):
            ds = ' stroke-dasharray="6 4"' if dash else ""
            return f'<line x1="{x1:.2f}" y1="{y1:.2f}" x2="{x2:.2f}" y2="{y2:.2f}" stroke="{col}" stroke-width="{sw}"{ds}/>'

        label = lambda x,y,t: f'<text x="{x:.2f}" y="{y:.2f}" font-size="14" font-family="Segoe UI" fill="#0B1220">{t}</text>'

        # FRONT outline
        fw = p.w_mm * s
        fh = p.h_mm * s
        fx = front_x + (box_w - fw)/2
        fy = (box_h - fh)/2
        front_outline = rect(fx, fy, fw, fh, col_main, stroke)

        inset = max(0.0, p.inset_mm) * s
        inset_outline = ""
        if inset > 0.1 and fw - 2*inset > 2 and fh - 2*inset > 2:
            inset_outline = rect(fx+inset, fy+inset, fw-2*inset, fh-2*inset, col_inset, stroke)

        # Front panels
        panels_svg = ""
        for (x,y,w,h) in self._calc_front_panels(p):
            px = fx + x*s
            py = fy + y*s
            pw = w*s
            ph = h*s
            if pw > 1 and ph > 1:
                panels_svg += rect(px, py, pw, ph, col_main, stroke, rx=6)

        # Middle wall in FRONT view (dashed vertical line)
        mw_svg = ""
        if p.middle_wall:
            t = max(0.0, p.thickness_mm) * s
            xmid = fx + fw/2.0
            mw_svg = line(xmid, fy+inset, xmid, fy+fh-inset, col_soft, 1.0, dash=True)

        # Shelves in FRONT view (dashed horizontal lines)
        shelves_svg = ""
        if p.shelves_count > 0:
            # równy podział przestrzeni wewnętrznej (wizualnie)
            n = p.shelves_count
            for i in range(1, n+1):
                yline = fy + (fh * i) / (n+1)
                shelves_svg += line(fx+inset, yline, fx+fw-inset, yline, col_soft, 1.0, dash=True)

        # TOP outline (W x D)
        tw = p.w_mm * s
        th = p.d_mm * s
        tx = top_x + (box_w - tw)/2
        ty = (box_h - th)/2
        top_outline = rect(tx, ty, tw, th, col_main, stroke)

        # Middle wall in TOP view (dashed line)
        mw_top = ""
        if p.middle_wall:
            xmid = tx + tw/2.0
            mw_top = line(xmid, ty+inset, xmid, ty+th-inset, col_soft, 1.0, dash=True)

        svg = f'''<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="{view_w:.0f}" height="{view_h:.0f}" viewBox="0 0 {view_w:.0f} {view_h:.0f}">
  {label(front_x + 10, 22, "Widok przód")}
  {label(top_x + 10, 22, "Widok góra")}
  {front_outline}
  {inset_outline}
  {panels_svg}
  {mw_svg}
  {shelves_svg}
  {top_outline}
  {mw_top}
</svg>
'''
        return svg.encode("utf-8")

    # ------------- refresh -------------
    def _refresh_all(self) -> None:
        p = self._get_params()
        try:
            self.svg.load(self._build_svg(p))
        except Exception:
            self.txt_bom.setPlainText("Błąd rysowania SVG (sprawdź QtSvgWidgets).")
            return
        self.txt_bom.setPlainText(self._build_bom(p))
        try:
            self._save_state()
        except Exception:
            pass
