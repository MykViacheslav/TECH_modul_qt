from __future__ import annotations

from dataclasses import dataclass
from typing import List, Tuple, Optional, Dict

from PySide6 import QtCore, QtWidgets
from PySide6.QtCore import QSettings
from PySide6.QtSvgWidgets import QSvgWidget


@dataclass
class EdgeFlags:
    przod: bool = True   # okleina na krawędzi frontowej
    boki: bool = False   # okleina na bocznych krawędziach (lewa+prawa)
    gora: bool = False   # okleina na górnej krawędzi
    dol: bool = False    # okleina na dolnej krawędzi


@dataclass
class ModuleParams:
    # wymiary zewnętrzne
    w_mm: float = 600.0
    h_mm: float = 720.0
    d_mm: float = 560.0

    # fronty
    front_mode: str = "Drzwi"   # "Drzwi" | "Szuflady" | "Brak"
    front_count: int = 2
    qty: int = 1
    inset_mm: float = 0.0
    gap_mm: float = 2.0
    handles: bool = True

    # baza
    material: str = ""
    edge: str = ""

    # konstrukcja
    thickness_mm: float = 18.0
    back_panel: bool = True
    back_thickness_mm: float = 3.0

    middle_wall: bool = False
    shelves_count: int = 0
    shelves_split_with_middle: bool = True

    # okleinowanie (na typach elementów)
    edge_carcass: EdgeFlags = EdgeFlags(przod=True, boki=False, gora=False, dol=False)
    edge_shelves: EdgeFlags = EdgeFlags(przod=True, boki=False, gora=False, dol=False)
    edge_middle: EdgeFlags = EdgeFlags(przod=True, boki=False, gora=False, dol=False)
    edge_top: EdgeFlags = EdgeFlags(przod=True, boki=True, gora=False, dol=False)


def _clamp_int(v: int, lo: int, hi: int) -> int:
    return max(lo, min(hi, v))


def _mm_to_m(mm: float) -> float:
    return mm / 1000.0


def _mm_to_m2(area_mm2: float) -> float:
    return area_mm2 / 1_000_000.0


def _safe_float(x, default: float) -> float:
    try:
        return float(x)
    except Exception:
        return default


class ModuleWidget(QtWidgets.QWidget):
    """
    Moduł — przywracamy logikę jak wcześniej:
    - widok przód + widok góra w tej samej skali
    - W/H/D, fronty, ilość, gap, inset, uchwyty
    - przegroda środkowa, półki
    - okleinowanie części + BOM (w tym metry okleiny)
    """

    def __init__(self, ctx, parent=None) -> None:
        super().__init__(parent)
        self.ctx = ctx
        self.settings: QSettings = getattr(ctx, "settings", QSettings("TECH_modul", "TECH_modul_qt"))
        self._build_ui()
        self._populate_catalogs()
        self._load_state()
        self._refresh_all()

        bus = getattr(self.ctx, "bus", None)
        sig = getattr(bus, "data_changed", None)
        if sig is not None and hasattr(sig, "connect"):
            try:
                sig.connect(self._on_data_changed)
            except Exception:
                pass

    @QtCore.Slot(object)
    def _on_data_changed(self, key: object) -> None:
        if str(key) == "catalogs":
            self._populate_catalogs()

