            h_mm=float(self.sp_h.value()),
            d_mm=float(self.sp_d.value()),
            front_mode=self.cb_mode.currentText(),
            front_count=_clamp_int(int(self.sp_front_count.value()), 1, 12),
            qty=_clamp_int(int(self.sp_qty.value()), 1, 999),
            inset_mm=float(self.sp_inset.value()),
            gap_mm=float(self.sp_gap.value()),
            handles=bool(self.ck_handles.isChecked()),
            material=self.cb_material.currentText() if self.cb_material.currentIndex() >= 1 else "",
            edge=self.cb_edge.currentText() if self.cb_edge.currentIndex() >= 1 else "",
            thickness_mm=float(self.sp_thick.value()),
            back_panel=bool(self.ck_back.isChecked()),
            back_thickness_mm=float(self.sp_back_thick.value()),
            middle_wall=bool(self.ck_middle.isChecked()),
            shelves_count=int(self.sp_shelves.value()),
            shelves_split_with_middle=bool(self.ck_split_shelves.isChecked()),
            edge_carcass=EdgeFlags(
                przod=self.edge_carcass["przod"].isChecked(),
                boki=self.edge_carcass["boki"].isChecked(),
