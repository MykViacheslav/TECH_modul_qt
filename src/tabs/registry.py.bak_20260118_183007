from __future__ import annotations
from types import SimpleNamespace

def ensure_ctx(ctx):
    if ctx is None:
        ctx = SimpleNamespace()

    # keep compatibility dict/object
    if isinstance(ctx, dict):
        if "bus" not in ctx: ctx["bus"] = None
        return ctx

    if not hasattr(ctx, "bus"):
        ctx.bus = None
    return ctx

def build_tabs(ctx):
    ctx = ensure_ctx(ctx)

    # Optional shared Project Tree wrapper (if exists in project)
    def wrap(widget):
        try:
            from .project_tree_wrapper import wrap_with_project_tree
            return wrap_with_project_tree(widget, ctx)
        except Exception:
            return widget

    from .tab_module import ModuleTab
    from .tab_module_base import ModuleBaseTab

    return [
        ("MODUL", wrap(ModuleTab(ctx))),
        ("BAZA MODULU", wrap(ModuleBaseTab(ctx))),
    ]
