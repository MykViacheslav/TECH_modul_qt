from __future__ import annotations

from dataclasses import dataclass
from typing import List, Tuple

from PySide6 import QtCore, QtWidgets, QtGui

from widgets.collapsible import CollapsibleSection


@dataclass
class Segment:
    x0: int
    x1: int
    name: str


class ModuleProtoWidget(QtWidgets.QWidget):
    """
    SAFE proto UI (no dependency on old core/module_widget).
    Small steps: segments (between sides & mid panels) + auto shelves for selected segment.
    """
    def __init__(self, ctx=None, parent=None):
        super().__init__(parent)
        self.ctx = ctx

        self._segments: List[Segment] = []
        self._build_ui()
        self._wire()
        self._recalc()

    # ---------- UI helpers ----------
    def _cs_add(self, cs: CollapsibleSection, w: QtWidgets.QWidget):
        # robust attach regardless of CollapsibleSection flavor
        if hasattr(cs, "addWidget"):
            try:
                cs.addWidget(w)
                return
            except Exception:
                pass
        if hasattr(cs, "contentLayout"):
            cs.contentLayout.addWidget(w)
            return
        if hasattr(cs, "content_layout"):
            cs.content_layout.addWidget(w)
            return
        if hasattr(cs, "content"):
            lay = cs.content.layout()
            if lay is None:
                lay = QtWidgets.QVBoxLayout(cs.content)
                lay.setContentsMargins(0, 0, 0, 0)
                lay.setSpacing(6)
            lay.addWidget(w)
            return
        lay = cs.layout() or QtWidgets.QVBoxLayout(cs)
        lay.addWidget(w)

    # ---------- Build ----------
    def _build_ui(self):
        root = QtWidgets.QVBoxLayout(self)
        root.setContentsMargins(8, 8, 8, 8)
        root.setSpacing(8)

        # status pill
        top = QtWidgets.QHBoxLayout()
        top.addStretch(1)
        self.status = QtWidgets.QLabel("OK")
        self.status.setAlignment(QtCore.Qt.AlignCenter)
        self.status.setFixedWidth(60)
        self.status.setStyleSheet(
            "QLabel{padding:4px 10px;border-radius:10px;background:#d7ffe1;color:#000;font-weight:700;}"
        )
        top.addWidget(self.status)
        root.addLayout(top)

        self.split = QtWidgets.QSplitter(QtCore.Qt.Horizontal)
        root.addWidget(self.split, 1)

        # LEFT: controls
        leftWrap = QtWidgets.QWidget()
        leftLay = QtWidgets.QVBoxLayout(leftWrap)
        leftLay.setContentsMargins(0, 0, 0, 0)
        leftLay.setSpacing(8)

        # --- Dims + Anchor ---
        self.secDims = CollapsibleSection("Wymiary + Anchor")
        dims = QtWidgets.QWidget()
        g = QtWidgets.QGridLayout(dims)
        g.setContentsMargins(0, 0, 0, 0)

        self.w = QtWidgets.QSpinBox(); self.w.setRange(50, 5000); self.w.setValue(600)
        self.h = QtWidgets.QSpinBox(); self.h.setRange(50, 5000); self.h.setValue(720)
        self.d = QtWidgets.QSpinBox(); self.d.setRange(50, 2000); self.d.setValue(560)

        self.anchor = QtWidgets.QComboBox()
        self.anchor.addItems(["NONE", "LT", "RT", "LB", "RB"])

        g.addWidget(QtWidgets.QLabel("W (mm)"), 0, 0); g.addWidget(self.w, 0, 1)
        g.addWidget(QtWidgets.QLabel("H (mm)"), 1, 0); g.addWidget(self.h, 1, 1)
        g.addWidget(QtWidgets.QLabel("D (mm)"), 2, 0); g.addWidget(self.d, 2, 1)
        g.addWidget(QtWidgets.QLabel("Anchor"), 3, 0); g.addWidget(self.anchor, 3, 1)

        self._cs_add(self.secDims, dims)
        leftLay.addWidget(self.secDims)

        # --- Offsets ---
        self.secPos = CollapsibleSection("Przesunięcia (offset)")
        pos = QtWidgets.QWidget()
        g2 = QtWidgets.QGridLayout(pos)
        g2.setContentsMargins(0, 0, 0, 0)

        self.posL = QtWidgets.QSpinBox(); self.posL.setRange(0, 2000); self.posL.setValue(0)
        self.posR = QtWidgets.QSpinBox(); self.posR.setRange(0, 2000); self.posR.setValue(0)
        self.posT = QtWidgets.QSpinBox(); self.posT.setRange(0, 2000); self.posT.setValue(0)
        self.posB = QtWidgets.QSpinBox(); self.posB.setRange(0, 2000); self.posB.setValue(0)

        self.btnZero = QtWidgets.QPushButton("Zeruj")

        g2.addWidget(QtWidgets.QLabel("Left"), 0, 0);   g2.addWidget(self.posL, 0, 1)
        g2.addWidget(QtWidgets.QLabel("Right"), 1, 0);  g2.addWidget(self.posR, 1, 1)
        g2.addWidget(QtWidgets.QLabel("Top"), 2, 0);    g2.addWidget(self.posT, 2, 1)
        g2.addWidget(QtWidgets.QLabel("Bottom"), 3, 0); g2.addWidget(self.posB, 3, 1)
        g2.addWidget(self.btnZero, 4, 0, 1, 2)

        self._cs_add(self.secPos, pos)
        leftLay.addWidget(self.secPos)

        # --- Mid panels -> segments ---
        self.secMid = CollapsibleSection("Piony środkowe → segmenty")
        mid = QtWidgets.QWidget()
        gm = QtWidgets.QGridLayout(mid)
        gm.setContentsMargins(0, 0, 0, 0)
        gm.setHorizontalSpacing(8)
        gm.setVerticalSpacing(6)

        self.midEnabled = QtWidgets.QCheckBox("Pion #1 (midA)")
        self.midX = QtWidgets.QSpinBox(); self.midX.setRange(1, 5000); self.midX.setValue(300)

        self.mid2Enabled = QtWidgets.QCheckBox("Pion #2 (midB)")
        self.mid2X = QtWidgets.QSpinBox(); self.mid2X.setRange(1, 5000); self.mid2X.setValue(420)

        gm.addWidget(self.midEnabled, 0, 0, 1, 2)
        gm.addWidget(QtWidgets.QLabel("X (mm)"), 1, 0); gm.addWidget(self.midX, 1, 1)
        gm.addWidget(self.mid2Enabled, 2, 0, 1, 2)
        gm.addWidget(QtWidgets.QLabel("X2 (mm)"), 3, 0); gm.addWidget(self.mid2X, 3, 1)

        note = QtWidgets.QLabel("Segmenty powstają: [bok..mid..mid..bok]. Następny krok: wysokość mid + półka nad mid.")
        note.setWordWrap(True)
        note.setStyleSheet("color:#666; font-size:11px;")
        gm.addWidget(note, 4, 0, 1, 2)

        self._cs_add(self.secMid, mid)
        leftLay.addWidget(self.secMid)

        # --- Shelves in selected segment ---
        self.secShelves = CollapsibleSection("Półki (segment)")
        sh = QtWidgets.QWidget()
        gs = QtWidgets.QGridLayout(sh)
        gs.setContentsMargins(0, 0, 0, 0)
        gs.setHorizontalSpacing(8)
        gs.setVerticalSpacing(6)

        self.segPick = QtWidgets.QComboBox()
        self.shelfCount = QtWidgets.QSpinBox(); self.shelfCount.setRange(0, 12); self.shelfCount.setValue(1)
        self.btnShelvesClear = QtWidgets.QPushButton("0")
        self.btnShelvesEqual = QtWidgets.QPushButton("Równo")

        gs.addWidget(QtWidgets.QLabel("Segment"), 0, 0); gs.addWidget(self.segPick, 0, 1)
        gs.addWidget(QtWidgets.QLabel("Ilość (auto)"), 1, 0); gs.addWidget(self.shelfCount, 1, 1)
        rowBtns = QtWidgets.QHBoxLayout()
        rowBtns.addWidget(self.btnShelvesEqual, 1)
        rowBtns.addWidget(self.btnShelvesClear, 0)
        gs.addLayout(rowBtns, 2, 0, 1, 2)

        self._cs_add(self.secShelves, sh)
        leftLay.addWidget(self.secShelves)

        leftLay.addStretch(1)

        leftScroll = QtWidgets.QScrollArea()
        leftScroll.setWidgetResizable(True)
        leftScroll.setWidget(leftWrap)

        # CENTER: view
        center = QtWidgets.QWidget()
        cLay = QtWidgets.QVBoxLayout(center)
        cLay.setContentsMargins(0, 0, 0, 0)
        title = QtWidgets.QLabel("Widok (proto) — segmenty + półki")
        title.setStyleSheet("font-weight:800;")
        cLay.addWidget(title)

        self.scene = QtWidgets.QGraphicsScene(self)
        self.view = QtWidgets.QGraphicsView(self.scene)
        self.view.setRenderHint(QtGui.QPainter.Antialiasing, True)
        cLay.addWidget(self.view, 1)

        # RIGHT: BOM
        right = QtWidgets.QWidget()
        rLay = QtWidgets.QVBoxLayout(right)
        rLay.setContentsMargins(0, 0, 0, 0)
        rTitle = QtWidgets.QLabel("BOM (proto)")
        rTitle.setStyleSheet("font-weight:800;")
        self.bom = QtWidgets.QPlainTextEdit()
        self.bom.setReadOnly(True)
        rLay.addWidget(rTitle)
        rLay.addWidget(self.bom, 1)

        self.split.addWidget(leftScroll)
        self.split.addWidget(center)
        self.split.addWidget(right)
        self.split.setStretchFactor(0, 0)
        self.split.setStretchFactor(1, 1)
        self.split.setStretchFactor(2, 0)
        self.split.setSizes([360, 720, 320])

    # ---------- Wire ----------
    def _wire(self):
        for sp in (self.w, self.h, self.d, self.posL, self.posR, self.posT, self.posB, self.midX, self.mid2X, self.shelfCount):
            sp.valueChanged.connect(self._recalc)
        self.anchor.currentIndexChanged.connect(self._recalc)
        self.midEnabled.toggled.connect(self._recalc)
        self.mid2Enabled.toggled.connect(self._recalc)
        self.segPick.currentIndexChanged.connect(self._recalc)

        self.btnZero.clicked.connect(self._zero)
        self.btnShelvesClear.clicked.connect(lambda: self.shelfCount.setValue(0))
        self.btnShelvesEqual.clicked.connect(self._recalc)

    def _zero(self):
        self.posL.setValue(0); self.posR.setValue(0); self.posT.setValue(0); self.posB.setValue(0)

    def _set_ok(self, ok: bool, msg: str = "OK"):
        if ok:
            self.status.setText("OK")
            self.status.setStyleSheet("QLabel{padding:4px 10px;border-radius:10px;background:#d7ffe1;color:#000;font-weight:700;}")
        else:
            self.status.setText("ERR")
            self.status.setStyleSheet("QLabel{padding:4px 10px;border-radius:10px;background:#ffd6d6;color:#000;font-weight:700;}")
            self.bom.setPlainText(msg)

    # ---------- Logic ----------
    def _calc_segments(self, openW: int) -> List[Segment]:
        cuts: List[int] = []
        if self.midEnabled.isChecked():
            cuts.append(int(self.midX.value()))
        if self.mid2Enabled.isChecked():
            cuts.append(int(self.mid2X.value()))

        # clamp + sort + unique
        cuts = [max(1, min(openW - 1, c)) for c in cuts if openW > 2]
        cuts = sorted(set(cuts))

        xs = [0] + cuts + [openW]
        segs: List[Segment] = []
        for i in range(len(xs) - 1):
            a, b = xs[i], xs[i + 1]
            name = f"S{i+1}: {a}..{b}"
            segs.append(Segment(a, b, name))
        return segs

    def _sync_segment_pick(self):
        # keep selection by index if possible
        old = self.segPick.currentIndex()
        self.segPick.blockSignals(True)
        self.segPick.clear()
        for s in self._segments:
            self.segPick.addItem(s.name)
        if self._segments:
            self.segPick.setCurrentIndex(max(0, min(old, len(self._segments) - 1)))
        self.segPick.blockSignals(False)

    def _recalc(self):
        try:
            W, H, D = self.w.value(), self.h.value(), self.d.value()
            L, R, T, B = self.posL.value(), self.posR.value(), self.posT.value(), self.posB.value()

            openW = max(1, W - L - R)
            openH = max(1, H - T - B)

            # keep mid ranges sane
            self.midX.setRange(1, max(2, openW - 1))
            self.mid2X.setRange(1, max(2, openW - 1))

            self._segments = self._calc_segments(openW)
            self._sync_segment_pick()
            seg_idx = max(0, self.segPick.currentIndex())
            seg = self._segments[seg_idx] if self._segments else Segment(0, openW, "S1")

            n = int(self.shelfCount.value())

            # --- draw ---
            self.scene.clear()
            scale = 0.70
            ow = openW * scale
            oh = openH * scale

            outer = QtCore.QRectF(0, 0, ow, oh)
            pen_outer = QtGui.QPen(QtGui.QColor(40, 40, 40), 2)
            self.scene.addRect(outer, pen_outer)

            # mid lines
            pen_mid = QtGui.QPen(QtGui.QColor(80, 80, 80), 1)
            for s in self._segments[1:]:
                x = s.x0 * scale
                self.scene.addLine(x, 0, x, oh, pen_mid)

            # selected segment highlight
            x0 = seg.x0 * scale
            x1 = seg.x1 * scale
            hi = QtCore.QRectF(x0, 0, max(1.0, x1 - x0), oh)
            self.scene.addRect(hi, QtGui.QPen(QtCore.Qt.NoPen), QtGui.QBrush(QtGui.QColor(210, 220, 255, 80)))

            # shelves (auto evenly spaced)
            pen_shelf = QtGui.QPen(QtGui.QColor(200, 60, 60), 2)
            shelf_positions_mm: List[int] = []
            if n > 0:
                for i in range(n):
                    y = (i + 1) * (openH / (n + 1))
                    shelf_positions_mm.append(int(round(openH - y)))  # from bottom
                    yy = y * scale
                    self.scene.addLine(x0, yy, x1, yy, pen_shelf)

            self.scene.setSceneRect(outer.adjusted(-20, -20, 20, 20))

            # --- BOM text ---
            txt = []
            txt.append(f"W/H/D: {W} / {H} / {D}")
            txt.append(f"Offsets L/R/T/B: {L} / {R} / {T} / {B}")
            txt.append(f"Opening: {openW} x {openH}")
            txt.append(f"Anchor: {self.anchor.currentText()}")
            txt.append("")
            txt.append(f"Segments: {len(self._segments)}  | Selected: {seg.name}")
            txt.append(f"ShelfStack(auto): count={n}  span={seg.x0}..{seg.x1}")
            if shelf_positions_mm:
                txt.append("Shelf Y from bottom (mm): " + ", ".join(map(str, shelf_positions_mm)))
            else:
                txt.append("Shelf Y from bottom (mm): —")
            txt.append("")
            txt.append("NEXT (small steps): mid height (end below top) + shelf/bottom above mid, per-side spans, then materials/BOM.")
            self.bom.setPlainText("\n".join(txt))

            self._set_ok(True)
        except Exception:
            import traceback
            self._set_ok(False, traceback.format_exc())