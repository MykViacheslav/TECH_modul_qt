    def _get_mid_cfgs(self) -> List[MidPanelCfg]:
        out: List[MidPanelCfg] = []
        if self.midA_on.isChecked():
            out.append(MidPanelCfg(True, self.midA_x.value(), self.midA_h.value(),
                                   self.midA_cap.currentText(), self.midA_span.currentText()))
        if self.midB_on.isChecked():
            out.append(MidPanelCfg(True, self.midB_x.value(), self.midB_h.value(),
                                   self.midB_cap.currentText(), self.midB_span.currentText()))
        return out

    def _compute_segments(self, W: int, L: int, R: int, mids: List[MidPanelCfg]) -> List[Tuple[str, int, int]]:
        x0 = L
        xN = max(L + 1, W - R)

        xs = []
        for m in mids:
            x = int(m.x_mm)
            x = max(x0 + 1, min(x, xN - 1))
            xs.append(x)
        xs = sorted(set(xs))

        bounds = [x0] + xs + [xN]
        segs = []
        for i in range(len(bounds) - 1):
            segs.append((f"SEG{i+1}", bounds[i], bounds[i+1]))
        return segs

    def _cap_limits_by_segment(self, segs: List[Tuple[str, int, int]], W: int, H: int, B: int, mids: List[MidPanelCfg]) -> dict:
        open_bottom = H - B
        limits = {name: open_bottom for (name, _, _) in segs}

        # helpers
        def clamp_x(xm: int) -> int:
            return max(segs[0][1] + 1, min(xm, segs[-1][2] - 1))

        def find_seg_left_of(xm: int) -> Optional[str]:
            for name, x1, x2 in segs:
                if x2 == xm:
                    return name
            return None

        def find_seg_right_of(xm: int) -> Optional[str]:
            for name, x1, x2 in segs:
                if x1 == xm:
                    return name
            return None

        for m in mids:
            if m.cap_kind == "NONE":
                continue
            capY = (H - B) - int(m.height_mm)
            capY = max(0, min(capY, open_bottom))

            xm = clamp_x(int(m.x_mm))

            if m.cap_span == "BOTH":
                for k in list(limits.keys()):
                    limits[k] = min(limits[k], capY)
            elif m.cap_span == "LEFT":
                segname = find_seg_left_of(xm)
                if segname:
                    limits[segname] = min(limits[segname], capY)
            elif m.cap_span == "RIGHT":
                segname = find_seg_right_of(xm)
                if segname:
                    limits[segname] = min(limits[segname], capY)

        return limits

