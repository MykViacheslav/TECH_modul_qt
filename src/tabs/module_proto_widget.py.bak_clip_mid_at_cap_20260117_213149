class _SegItem(QtWidgets.QGraphicsRectItem):
    def __init__(self, rect: QtCore.QRectF, name: str, owner: "ModuleProtoWidget"):
        super().__init__(rect)
        self.name = name
        self.owner = owner
        self.setAcceptHoverEvents(True)
        self.setCursor(QtCore.Qt.PointingHandCursor)

    def hoverEnterEvent(self, event):
        self.owner._hover_seg = self.name
        self.owner._redraw_only()
        super().hoverEnterEvent(event)

    def hoverLeaveEvent(self, event):
        self.owner._hover_seg = None
        self.owner._redraw_only()
        super().hoverLeaveEvent(event)

    def mousePressEvent(self, event):
        self.owner._select_segment(self.name)
        super().mousePressEvent(event)


class ModuleProtoWidget(QtWidgets.QWidget):
    """
    Proto UI:
    - segments from mid panels (X positions)
    - shelves per segment (All / Seg1 / Seg2 / Seg3)
    - cap above a mid-panel: shelf/bottom, span left/right/both
    - IMPORTANT: cap limits segment height -> shelves don't go "above segment"
    - NEW: click on segment in view -> select SEG
    """

    def _recalc(self):
        """Recompute / redraw. Always draws something."""
        # try real _render only if it exists as a real method on the class (not via __getattr__)
        try:
            for cls in type(self).mro():
                if "_render" in getattr(cls, "__dict__", {}):
                    fn = cls.__dict__.get("_render")
                    if callable(fn):
                        return fn(self)
        except Exception:
            # if real render fails, fall back
            pass

        # always draw fallback
        if hasattr(self, "_render_fallback"):
            return self._render_fallback()
        return None
    def _sync_shelf_mode(self):
        """Enable/disable shelf controls depending on mode."""
        mode  = getattr(self, 'shelf_mode', None)
        start = getattr(self, 'shelf_start', None)
        step  = getattr(self, 'shelf_step', None)
        if mode is None or start is None or step is None:
            return
        m = mode.currentData() or 'EQUAL'
        on = (m != 'EQUAL')
        start.setEnabled(on)
        step.setEnabled(on)


    def _zero(self):
        """Zero offsets (safe)."""
        # Set known fields to 0 if they exist.
        for name in ('posL','posR','posT','posB','midOffT','midOffB','mid2OffT','mid2OffB'):
            w = getattr(self, name, None)
            if w is not None and hasattr(w, 'setValue'):
                try:
                    w.setValue(0)
                except Exception:
                    pass
        # refresh if available
        if hasattr(self, '_recalc'):
            try:
                self._recalc()
            except Exception:
                pass


    def __getattr__(self, name):
        """Fail-safe: missing private handlers won't crash the UI."""
        if isinstance(name, str) and name.startswith('_'):
            def _noop(*args, **kwargs):
                return None
            return _noop
        raise AttributeError("{} has no attribute {!r}".format(type(self).__name__, name))


    def _lr_same(self, *args, **kwargs):
        """Right offset = Left offset."""
        L = getattr(self, 'posL', None)
        R = getattr(self, 'posR', None)
        try:
            if L is not None and R is not None:
                R.setValue(int(L.value()))
        except Exception:
            pass
        try:
            if hasattr(self, '_recalc'): self._recalc()
        except Exception:
            pass


    def _tb_same(self, *args, **kwargs):
        """Bottom offset = Top offset."""
        T = getattr(self, 'posT', None)
        B = getattr(self, 'posB', None)
        try:
            if T is not None and B is not None:
                B.setValue(int(T.value()))
        except Exception:
            pass
        try:
            if hasattr(self, '_recalc'): self._recalc()
        except Exception:
            pass


    def _render_fallback(self):
        """Always draw something (so the view is never empty)."""
        try:
            from PySide6 import QtCore, QtGui
            scene = getattr(self, "scene", None)
            view  = getattr(self, "view", None)
            if scene is None:
                return None

            # try to make background visible even in dark theme
            if view is not None:
                try:
                    view.setBackgroundBrush(QtGui.QBrush(QtGui.QColor(250, 250, 250)))
                except Exception:
                    pass

            # read dims + offsets safely
            W = int(getattr(self, "w").value()) if hasattr(self, "w") else 600
            H = int(getattr(self, "h").value()) if hasattr(self, "h") else 720
            L = int(getattr(self, "posL").value()) if hasattr(self, "posL") else 0
            R = int(getattr(self, "posR").value()) if hasattr(self, "posR") else 0
            T = int(getattr(self, "posT").value()) if hasattr(self, "posT") else 0
            B = int(getattr(self, "posB").value()) if hasattr(self, "posB") else 0

            scale = 0.60
            ow = max(1, (W - L - R)) * scale
            oh = max(1, (H - T - B)) * scale

            scene.clear()
            rect = QtCore.QRectF(0, 0, ow, oh)
            pen = QtGui.QPen(QtGui.QColor(30, 30, 30), 2)
            brush = QtGui.QBrush(QtGui.QColor(235, 235, 235))
            scene.addRect(rect, pen, brush)

            # label
            t = scene.addText(f"{W} x {H}  (L/R/T/B = {L}/{R}/{T}/{B})")
            try:
                t.setDefaultTextColor(QtGui.QColor(10,10,10))
            except Exception:
                pass
            t.setPos(6, 6)

            scene.setSceneRect(rect.adjusted(-30, -30, 30, 30))
            if view is not None:
                try:
                    view.fitInView(scene.sceneRect(), QtCore.Qt.KeepAspectRatio)
                except Exception:
                    pass

            # status OK if exists
            if hasattr(self, "status"):
                try:
                    self.status.setText("OK")
                except Exception:
                    pass
            return None
        except Exception:
            # dump to BOM if exists
            import traceback
            tb = traceback.format_exc()
            if hasattr(self, "bom"):
                try:
                    self.bom.setPlainText(tb)
                except Exception:
                    pass
            if hasattr(self, "status"):
                try:
                    self.status.setText("ERR")
                except Exception:
                    pass
            return None


    def _shelf_ensure_model(self):
        """Init shelves model + caches (safe to call many times)."""
        if not hasattr(self, '_shelf_cfg_all'):
            # defaults from UI if available
            n = int(getattr(getattr(self,'shelf_n',None),'value',lambda: 1)()) if hasattr(self,'shelf_n') else 1
            mode = (getattr(getattr(self,'shelf_mode',None),'currentData',lambda: 'EQUAL')() or 'EQUAL') if hasattr(self,'shelf_mode') else 'EQUAL'
            start = int(getattr(getattr(self,'shelf_start',None),'value',lambda: 150)()) if hasattr(self,'shelf_start') else 150
            step = int(getattr(getattr(self,'shelf_step',None),'value',lambda: 300)()) if hasattr(self,'shelf_step') else 300
            self._shelf_cfg_all = {'n': n, 'mode': mode, 'start': start, 'step': step}
        if not hasattr(self, '_shelf_cfg'):
            self._shelf_cfg = {}  # per segment
        if not hasattr(self, '_active_seg'):
            self._active_seg = None
        if not hasattr(self, '_segs_cache'):
            self._segs_cache = []
        if not hasattr(self, '_seg_limits_cache'):
            self._seg_limits_cache = {}
        if not hasattr(self, '_shelf_wired'):
            self._shelf_wired = False
        if not hasattr(self, '_shelf_ui_lock'):
            self._shelf_ui_lock = False


    def _rebuild_shelf_seg_items(self):
        """Rebuild segment combo from current segments cache."""
        self._shelf_ensure_model()
        cb = getattr(self, 'shelf_seg', None)
        if cb is None:
            return
        try:
            cur = cb.currentText() if cb.count() else 'ALL'
        except Exception:
            cur = 'ALL'
        seg_names = [name for (name, _x1, _x2) in (self._segs_cache or [])]
        items = ['ALL'] + seg_names
        # update only if changed
        try:
            old = [cb.itemText(i) for i in range(cb.count())]
        except Exception:
            old = []
        if old != items:
            self._shelf_ui_lock = True
            try:
                cb.clear()
                cb.addItems(items)
            finally:
                self._shelf_ui_lock = False
        # restore selection
        if cur in items:
            cb.setCurrentText(cur)
        else:
            cb.setCurrentText('ALL')


    def _on_shelf_seg_changed(self, *args):
        """Load per-segment config into UI when user changes segment."""
        self._shelf_ensure_model()
        if getattr(self, '_shelf_ui_lock', False):
            return
        cb = getattr(self, 'shelf_seg', None)
        seg = cb.currentText() if cb is not None else 'ALL'
        if not seg:
            seg = 'ALL'
        self._active_seg = None if seg == 'ALL' else seg
        cfg = self._shelf_cfg_all if seg == 'ALL' else self._shelf_cfg.get(seg, dict(self._shelf_cfg_all))
        # apply to UI
        self._shelf_ui_lock = True
        try:
            if hasattr(self,'shelf_n'): self.shelf_n.setValue(int(cfg.get('n', 0)))
            if hasattr(self,'shelf_mode'):
                want = cfg.get('mode','EQUAL')
                # match by data
                for i in range(self.shelf_mode.count()):
                    if (self.shelf_mode.itemData(i) or 'EQUAL') == want:
                        self.shelf_mode.setCurrentIndex(i)
                        break
            if hasattr(self,'shelf_start'): self.shelf_start.setValue(int(cfg.get('start', 150)))
            if hasattr(self,'shelf_step'):  self.shelf_step.setValue(int(cfg.get('step', 300)))
            if hasattr(self,'_sync_shelf_mode'): self._sync_shelf_mode()
        finally:
            self._shelf_ui_lock = False
        if hasattr(self,'_recalc'): self._recalc()


    def _on_shelf_params_changed(self, *args):
        """Commit UI -> per-segment config and redraw."""
        self._shelf_ensure_model()
        if getattr(self, '_shelf_ui_lock', False):
            return
        cb = getattr(self, 'shelf_seg', None)
        seg = cb.currentText() if cb is not None else 'ALL'
        if not seg:
            seg = 'ALL'
        cfg = {
            'n': int(getattr(getattr(self,'shelf_n',None),'value',lambda: 0)()),
            'mode': (getattr(getattr(self,'shelf_mode',None),'currentData',lambda: 'EQUAL')() or 'EQUAL'),
            'start': int(getattr(getattr(self,'shelf_start',None),'value',lambda: 150)()),
            'step': int(getattr(getattr(self,'shelf_step',None),'value',lambda: 300)()),
        }
        if seg == 'ALL':
            self._shelf_cfg_all = cfg
        else:
            self._shelf_cfg[seg] = cfg
            self._active_seg = seg
        if hasattr(self,'_sync_shelf_mode'): self._sync_shelf_mode()
        if hasattr(self,'_recalc'): self._recalc()


    def _apply_shelves_to_all(self, *args):
        """Copy current ALL config to every known segment."""
        self._shelf_ensure_model()
        # ensure cfg_all is current UI
        try:
            self._shelf_cfg_all = {
                'n': int(getattr(getattr(self,'shelf_n',None),'value',lambda: 0)()),
                'mode': (getattr(getattr(self,'shelf_mode',None),'currentData',lambda: 'EQUAL')() or 'EQUAL'),
                'start': int(getattr(getattr(self,'shelf_start',None),'value',lambda: 150)()),
                'step': int(getattr(getattr(self,'shelf_step',None),'value',lambda: 300)()),
            }
        except Exception:
            pass
        for name, _x1, _x2 in (self._segs_cache or []):
            self._shelf_cfg[name] = dict(self._shelf_cfg_all)
        if hasattr(self,'_recalc'): self._recalc()


    def _set_active_seg(self, name: str):
        """Set active segment (also updates combo if present)."""
        self._shelf_ensure_model()
        if not name:
            self._active_seg = None
            return
        self._active_seg = name
        cb = getattr(self, 'shelf_seg', None)
        if cb is not None:
            try:
                if cb.findText(name) >= 0:
                    cb.setCurrentText(name)
            except Exception:
                pass


    def _on_scene_selection(self):
        """When user clicks a segment rect in scene, select that segment."""
        self._shelf_ensure_model()
        sc = getattr(self, 'scene', None)
        if sc is None:
            return
        try:
            items = sc.selectedItems()
        except Exception:
            return
        for it in items:
            try:
                name = it.data(0)
                if name:
                    self._set_active_seg(str(name))
                    # load UI for that segment
                    if hasattr(self, '_on_shelf_seg_changed'):
                        self._on_shelf_seg_changed()
                    break
            except Exception:
                continue

    def __init__(self, ctx=None, parent=None):
        super().__init__(parent)
        self.ctx = ctx

        self._selected_seg: str = "ALL"
        self._hover_seg: Optional[str] = None

        self._last_render = None  # cache for redraw-only
        self._build_ui()
        self._wire()
        self._recalc()

    # ---------- helpers ----------
    @staticmethod
    def _sec_add(sec: CollapsibleSection, w: QtWidgets.QWidget):
        # Support both robust CollapsibleSection and old stubs
        if hasattr(sec, "contentLayout") and sec.contentLayout is not None:
            sec.contentLayout.addWidget(w)
            return
        if hasattr(sec, "content") and sec.content is not None:
            lay = sec.content.layout()
            if lay is None:
                lay = QtWidgets.QVBoxLayout(sec.content)
                lay.setContentsMargins(8, 8, 8, 8)
            lay.addWidget(w)
            return
        lay = sec.layout() or QtWidgets.QVBoxLayout(sec)
        lay.addWidget(w)

