    # ---------- Wire ----------
    def _wire(self):
        for sp in (self.w, self.h, self.d, self.posL, self.posR, self.posT, self.posB, self.midX, self.midH, self.mid2X, self.mid2H):
            sp.valueChanged.connect(self._recalc)

        self.anchor.currentIndexChanged.connect(self._recalc)
        self.midEnabled.toggled.connect(self._recalc)
        self.mid2Enabled.toggled.connect(self._recalc)
        self.midCapType.currentIndexChanged.connect(self._recalc)
        self.midCapSpan.currentIndexChanged.connect(self._recalc)
        self.mid2CapType.currentIndexChanged.connect(self._recalc)
        self.mid2CapSpan.currentIndexChanged.connect(self._recalc)

        self.btnZero.clicked.connect(self._zero)

        self.segPick.currentIndexChanged.connect(self._on_segment_changed)
        self.shelfCount.valueChanged.connect(self._on_shelf_count_changed)
        self.btnShelvesClear.clicked.connect(lambda: self.shelfCount.setValue(0))
        self.btnShelvesEqual.clicked.connect(self._recalc)

    def _zero(self):
        self.posL.setValue(0); self.posR.setValue(0); self.posT.setValue(0); self.posB.setValue(0)

    def _set_ok(self, ok: bool, msg: str = "OK"):
        if ok:
            self.status.setText("OK")
            self.status.setStyleSheet("QLabel{padding:4px 10px;border-radius:10px;background:#d7ffe1;color:#000;font-weight:700;}")
        else:
            self.status.setText("ERR")
            self.status.setStyleSheet("QLabel{padding:4px 10px;border-radius:10px;background:#ffd6d6;color:#000;font-weight:700;}")
            self.bom.setPlainText(msg)

    # ---------- Segments / shelves store ----------
    def _calc_segments(self, openW: int) -> List[Segment]:
        cuts: List[int] = []
        if self.midEnabled.isChecked():
            cuts.append(int(self.midX.value()))
        if self.mid2Enabled.isChecked():
            cuts.append(int(self.mid2X.value()))
        cuts = [max(1, min(openW - 1, c)) for c in cuts if openW > 2]
        cuts = sorted(set(cuts))

        xs = [0] + cuts + [openW]
        segs: List[Segment] = []
        for i in range(len(xs) - 1):
            a, b = xs[i], xs[i + 1]
            key = SegmentKey(a, b)
            segs.append(Segment(a, b, f"S{i+1}: {a}..{b}", key))
        return segs

    def _sync_segment_pick(self):
        old_key = None
        if 0 <= self.segPick.currentIndex() < len(self._segments):
            old_key = self._segments[self.segPick.currentIndex()].key

        self.segPick.blockSignals(True)
        self.segPick.clear()
        for s in self._segments:
            self.segPick.addItem(s.name)
        # restore selection by key
        idx = 0
        if old_key is not None:
            for i, s in enumerate(self._segments):
                if s.key == old_key:
                    idx = i
                    break
        if self._segments:
            self.segPick.setCurrentIndex(max(0, min(idx, len(self._segments) - 1)))
        self.segPick.blockSignals(False)

        self._sync_shelf_spin_from_store()

    def _selected_segment(self) -> Optional[Segment]:
        i = self.segPick.currentIndex()
        if 0 <= i < len(self._segments):
            return self._segments[i]
        return None

    def _sync_shelf_spin_from_store(self):
        seg = self._selected_segment()
        if not seg:
            return
        val = int(self._shelves_per_seg.get(seg.key, int(self.shelfCount.value())))
        self.shelfCount.blockSignals(True)
        self.shelfCount.setValue(val)
        self.shelfCount.blockSignals(False)

    def _on_segment_changed(self):
        self._sync_shelf_spin_from_store()
        self._recalc()

    def _on_shelf_count_changed(self, v: int):
        seg = self._selected_segment()
        if seg:
            self._shelves_per_seg[seg.key] = int(v)
        self._recalc()

    # ---------- Mid helpers ----------
    def _get_mid_specs(self, openW: int, openH: int) -> Tuple[Optional[MidSpec], Optional[MidSpec]]:
        def clamp_x(x: int) -> int:
            return max(1, min(openW - 1, int(x))) if openW > 2 else 1
        def clamp_h(h: int) -> int:
            return max(1, min(openH, int(h)))

        a = None
        b = None
        if self.midEnabled.isChecked():
            a = MidSpec(True, clamp_x(self.midX.value()), clamp_h(self.midH.value()),
                        self.midCapType.currentText(), self.midCapSpan.currentText())
        if self.mid2Enabled.isChecked():
            b = MidSpec(True, clamp_x(self.mid2X.value()), clamp_h(self.mid2H.value()),
                        self.mid2CapType.currentText(), self.mid2CapSpan.currentText())
        return a, b

    def _cap_span_range(self, mid: MidSpec, other: Optional[MidSpec], openW: int) -> Tuple[int, int]:
        span = mid.cap_span
        if span == "FULL":
            return 0, openW
        if span == "LEFT":
            return 0, mid.x
        if span == "RIGHT":
            return mid.x, openW
        if span == "BETWEEN" and other is not None:
            return (min(mid.x, other.x), max(mid.x, other.x))
        return 0, openW

    # ---------- Recalc / draw ----------
    def _recalc(self):
        try:
            W, H, D = self.w.value(), self.h.value(), self.d.value()
            L, R, T, B = self.posL.value(), self.posR.value(), self.posT.value(), self.posB.value()

            openW = max(1, W - L - R)
            openH = max(1, H - T - B)

            # ranges
            self.midX.setRange(1, max(2, openW - 1))
            self.mid2X.setRange(1, max(2, openW - 1))
            self.midH.setRange(1, openH)
            self.mid2H.setRange(1, openH)

            # segments
            self._segments = self._calc_segments(openW)
            self._sync_segment_pick()

            seg = self._selected_segment() or Segment(0, openW, "S1", SegmentKey(0, openW))
            n = int(self._shelves_per_seg.get(seg.key, int(self.shelfCount.value())))

            midA, midB = self._get_mid_specs(openW, openH)

            # draw
            self.scene.clear()
            scale = 0.70
            ow = openW * scale
            oh = openH * scale

            outer = QtCore.QRectF(0, 0, ow, oh)
            self.scene.addRect(outer, QtGui.QPen(QtGui.QColor(40, 40, 40), 2))

            # highlight selected segment
            x0s = seg.x0 * scale
            x1s = seg.x1 * scale
            hi = QtCore.QRectF(x0s, 0, max(1.0, x1s - x0s), oh)
            self.scene.addRect(hi, QtGui.QPen(QtCore.Qt.NoPen), QtGui.QBrush(QtGui.QColor(210, 220, 255, 80)))

            # mids
            pen_mid = QtGui.QPen(QtGui.QColor(80, 80, 80), 2)

            def draw_mid(mid: MidSpec) -> float:
                x = mid.x * scale
                y_top = max(0.0, oh - mid.h * scale)
                self.scene.addLine(x, oh, x, y_top, pen_mid)
                return y_top

            yA = draw_mid(midA) if midA else None
            yB = draw_mid(midB) if midB else None

            # cap shelf/bottom
            pen_cap = QtGui.QPen(QtGui.QColor(60, 140, 60), 3)

            def draw_cap(mid: MidSpec, other: Optional[MidSpec], y_top: float):
                if mid.cap_type == "NONE":
                    return None
                if mid.h >= openH:
                    return None
                x0, x1 = self._cap_span_range(mid, other, openW)
                self.scene.addLine(x0 * scale, y_top, x1 * scale, y_top, pen_cap)
                return (mid.cap_type, x0, x1)

            capA = draw_cap(midA, midB, yA) if (midA and yA is not None) else None
            capB = draw_cap(midB, midA, yB) if (midB and yB is not None) else None

            # shelves for selected segment
            pen_shelf = QtGui.QPen(QtGui.QColor(200, 60, 60), 2)
            shelf_positions_mm: List[int] = []
            if n > 0:
                for i in range(n):
                    y = (i + 1) * (openH / (n + 1))
                    shelf_positions_mm.append(int(round(openH - y)))
                    yy = y * scale
                    self.scene.addLine(x0s, yy, x1s, yy, pen_shelf)

            self.scene.setSceneRect(outer.adjusted(-20, -20, 20, 20))

            # BOM
            txt = []
            txt.append(f"W/H/D: {W} / {H} / {D}")
            txt.append(f"Offsets L/R/T/B: {L} / {R} / {T} / {B}")
            txt.append(f"Opening: {openW} x {openH}")
            txt.append(f"Anchor: {self.anchor.currentText()}")
            txt.append("")
            txt.append(f"Segments: {len(self._segments)} | Selected: {seg.name}")
            txt.append(f"Shelves in selected segment: {n} | span={seg.x0}..{seg.x1}")
            txt.append("Shelf Y from bottom (mm): " + (", ".join(map(str, shelf_positions_mm)) if shelf_positions_mm else "—"))
            txt.append("")
            if midA:
                txt.append(f"midA: x={midA.x} h={midA.h} cap={midA.cap_type} span={midA.cap_span}" + (f" range={capA[1]}..{capA[2]}" if capA else ""))
            if midB:
                txt.append(f"midB: x={midB.x} h={midB.h} cap={midB.cap_type} span={midB.cap_span}" + (f" range={capB[1]}..{capB[2]}" if capB else ""))
            txt.append("")
            txt.append("NEXT: зробимо сегмент як 'sub-module' (окремий блок) -> полки/фасади/шухляди всередині сегмента.")
            self.bom.setPlainText("\n".join(txt))

            self._set_ok(True)
        except Exception:
            import traceback
            self._set_ok(False, traceback.format_exc())