from __future__ import annotations
from PySide6 import QtWidgets
from .project_tree import ProjectTree

def wrap_with_project_tree(widget: QtWidgets.QWidget, ctx):
    """
    Wraps given widget with a shared ProjectTree on the left.
    No hierarchy of tabs; this is only inside each tab.
    """
    box = QtWidgets.QWidget()
    lay = QtWidgets.QVBoxLayout(box)
    lay.setContentsMargins(0,0,0,0)

    split = QtWidgets.QSplitter()
    split.setOrientation(QtWidgets.Qt.Horizontal)

    tree = ProjectTree(ctx)
    tree.setMinimumWidth(260)

    split.addWidget(tree)
    split.addWidget(widget)
    split.setStretchFactor(0, 0)
    split.setStretchFactor(1, 1)

    lay.addWidget(split)
    return box
