from __future__ import annotations

from dataclasses import dataclass
from typing import Dict, List, Tuple, Optional

from PySide6 import QtCore, QtWidgets, QtGui

from widgets.collapsible import CollapsibleSection


@dataclass
class Point:
    name: str   # "L","A","B","R"
    x: int      # mm absolute


@dataclass
class Segment:
    key: str
    label: str
    x0: int  # mm
    x1: int  # mm


class ModuleProtoWidget(QtWidgets.QWidget):

    def _sec_add(self, sec, widget):
        """Add widget to CollapsibleSection content layout (supports different API variants)."""
        lay = None
        for name in ("contentLayout", "content_layout", "bodyLayout", "body_layout", "containerLayout", "container_layout"):
            lay = getattr(sec, name, None)
            if lay is not None:
                break
        # common pattern: sec.content is QWidget with its own layout
        if lay is None:
            content = getattr(sec, "content", None) or getattr(sec, "body", None) or getattr(sec, "container", None)
            if content is not None:
                lay = content.layout()
                if lay is None:
                    from PySide6 import QtWidgets
                    lay = QtWidgets.QVBoxLayout(content)
                    lay.setContentsMargins(0, 0, 0, 0)
        # last resort: attach directly to sec
        if lay is None:
            lay = sec.layout()
            if lay is None:
                from PySide6 import QtWidgets
                lay = QtWidgets.QVBoxLayout(sec)
                lay.setContentsMargins(0, 0, 0, 0)
        lay.addWidget(widget)

    """
    SAFE proto UI based on web mock (NO dependency on core/module_widget logic).

    This step:
      - mid panels (midA/midB): X + HEIGHT (mm from bottom)
      - cap element at mid end: NONE / SHELF / DNO + span LEFT/RIGHT/BOTH
      - shelves per segment (between sides and mids)
      - view draws: frame, mid lines (up to height), shelves, caps
    """

    def __init__(self, ctx=None, parent=None):
        super().__init__(parent)
        self.ctx = ctx

        # shelves counts per segment
        self._shelf_counts: Dict[str, int] = {}

        self._build_ui()
        self._wire()

        self._rebuild_shelves_ui()
        self._recalc()

