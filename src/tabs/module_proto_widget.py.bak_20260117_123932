    def _wire(self):
        for sp in (
            self.w, self.h, self.d,
            self.posL, self.posR, self.posT, self.posB,
            self.midA_x, self.midB_x, self.midA_h, self.midB_h
        ):
            sp.valueChanged.connect(self._on_geom_changed)

        self.anchor.currentIndexChanged.connect(self._recalc)
        self.btnZero.clicked.connect(self._zero)

        self.midA_on.toggled.connect(self._on_geom_changed)
        self.midB_on.toggled.connect(self._on_geom_changed)

        self.midA_cap_type.currentIndexChanged.connect(self._recalc)
        self.midA_cap_span.currentIndexChanged.connect(self._recalc)
        self.midB_cap_type.currentIndexChanged.connect(self._recalc)
        self.midB_cap_span.currentIndexChanged.connect(self._recalc)

    def _on_geom_changed(self):
        self._sanitize_mids()
        self._sync_mid_height_ranges()
        self._rebuild_shelves_ui()
        self._recalc()

    def _zero(self):
        self.posL.setValue(0)
        self.posR.setValue(0)
        self.posT.setValue(0)
        self.posB.setValue(0)

    def _set_ok(self, ok: bool, msg: str = "OK"):
        if ok:
            self.status.setText("OK")
            self.status.setStyleSheet("QLabel{padding:4px 10px;border-radius:10px;background:#d7ffe1;color:#000;font-weight:700;}")
        else:
            self.status.setText("ERR")
            self.status.setStyleSheet("QLabel{padding:4px 10px;border-radius:10px;background:#ffd6d6;color:#000;font-weight:700;}")
            self.bom.setPlainText(msg)

    # ---------- geometry helpers ----------
    def _opening(self) -> Tuple[int, int, int, int, int, int]:
        W, H, D = self.w.value(), self.h.value(), self.d.value()
        L, R, T, B = self.posL.value(), self.posR.value(), self.posT.value(), self.posB.value()
        innerW = max(1, W - L - R)
        innerH = max(1, H - T - B)
        return W, H, D, L, R, innerW, innerH

    def _sanitize_mids(self):
        W, H, D, L, R, innerW, innerH = self._opening()
        xL = L
        xR = max(L + 1, W - R)

        if self.midA_on.isChecked():
            self.midA_x.setValue(max(xL + 1, min(xR - 1, self.midA_x.value())))
        if self.midB_on.isChecked():
            self.midB_x.setValue(max(xL + 1, min(xR - 1, self.midB_x.value())))

        # enforce A < B when both enabled
        if self.midA_on.isChecked() and self.midB_on.isChecked():
            if self.midA_x.value() >= self.midB_x.value():
                self.midB_x.setValue(min(xR - 1, self.midA_x.value() + 1))

    def _sync_mid_height_ranges(self):
        W, H, D, L, R, innerW, innerH = self._opening()
        for sp in (self.midA_h, self.midB_h):
            sp.setRange(0, innerH)
        # clamp values
        self.midA_h.setValue(min(innerH, self.midA_h.value()))
        self.midB_h.setValue(min(innerH, self.midB_h.value()))

        # default to full opening height if mid enabled and height is 0 (first time)
        if self.midA_on.isChecked() and self.midA_h.value() == 0:
            self.midA_h.setValue(innerH)
        if self.midB_on.isChecked() and self.midB_h.value() == 0:
            self.midB_h.setValue(innerH)

    def _points(self) -> List[Point]:
        W, H, D, L, R, innerW, innerH = self._opening()
        pts: List[Point] = [Point("L", L)]

        if self.midA_on.isChecked():
            pts.append(Point("A", self.midA_x.value()))
        if self.midB_on.isChecked():
            pts.append(Point("B", self.midB_x.value()))

        pts.append(Point("R", max(L + 1, W - R)))
        pts.sort(key=lambda p: p.x)

        # remove duplicates / non-increasing
        out: List[Point] = []
        last_x = None
        for p in pts:
            if last_x is None or p.x > last_x:
                out.append(p)
                last_x = p.x
        return out

    def _segments(self) -> List[Segment]:
        pts = self._points()
        out: List[Segment] = []
        for i in range(len(pts) - 1):
            a, b = pts[i], pts[i + 1]
            if b.x <= a.x:
                continue
            key = f"{a.name}-{b.name}"
            label = f"{a.name} → {b.name}"
            out.append(Segment(key=key, label=label, x0=a.x, x1=b.x))
        return out

    def _neighbor_bounds(self, name: str) -> Optional[Tuple[int, int, int]]:
        """
        Returns (x_left_bound, x_mid, x_right_bound) for mid 'A' or 'B' based on sorted points.
        """
        pts = self._points()
        for i, p in enumerate(pts):
            if p.name == name:
                if i <= 0 or i >= len(pts) - 1:
                    return None
                return (pts[i - 1].x, p.x, pts[i + 1].x)
        return None

    # ---------- shelves UI ----------
    def _rebuild_shelves_ui(self):
        # clear old
        while self.shelvesLay.count():
            it = self.shelvesLay.takeAt(0)
            w = it.widget()
            if w:
                w.deleteLater()

        segs = self._segments()

        note = QtWidgets.QLabel(
            "Każdy segment ma własną ilość półek.\n"
            "To jest dokładnie: półki między bokami i mid-panelami."
        )
        note.setWordWrap(True)
        note.setStyleSheet("color:#9aa0a6;")
        self.shelvesLay.addWidget(note)

        for seg in segs:
            row = QtWidgets.QWidget()
            lay = QtWidgets.QHBoxLayout(row)
            lay.setContentsMargins(0, 0, 0, 0)
            lay.setSpacing(10)

            lbl = QtWidgets.QLabel(f"Segment {seg.label} ({seg.x1 - seg.x0} mm)")
            lbl.setMinimumWidth(185)

            sp = QtWidgets.QSpinBox()
            sp.setRange(0, 12)
            sp.setValue(int(self._shelf_counts.get(seg.key, 0)))

            def _mk(k: str, spin: QtWidgets.QSpinBox):
                def on_change(_v: int):
                    self._shelf_counts[k] = int(spin.value())
                    self._recalc()
                return on_change

            sp.valueChanged.connect(_mk(seg.key, sp))

            lay.addWidget(lbl, 1)
            lay.addWidget(QtWidgets.QLabel("Ilość:"), 0)
            lay.addWidget(sp, 0)

            self.shelvesLay.addWidget(row)

        self.shelvesLay.addStretch(1)

    # ---------- draw + BOM ----------
    def _recalc(self):
        try:
            W, H, D, L, R, innerW, innerH = self._opening()
            self._sync_mid_height_ranges()

            scale = 0.60
            ow = innerW * scale
            oh = innerH * scale

            self.scene.clear()

            pen_frame = QtGui.QPen(QtGui.QColor(60, 60, 60), 2)
            pen_mid   = QtGui.QPen(QtGui.QColor(130, 130, 130), 2, QtCore.Qt.DashLine)
            pen_shelf = QtGui.QPen(QtGui.QColor(170, 170, 170), 2)
            pen_cap_s = QtGui.QPen(QtGui.QColor(200, 200, 200), 3)  # shelf cap
            pen_cap_b = QtGui.QPen(QtGui.QColor(220, 160, 160), 3)  # dno cap (just different shade)

            rect = QtCore.QRectF(0, 0, ow, oh)
            self.scene.addRect(rect, pen_frame)
            self.scene.setSceneRect(rect.adjusted(-20, -20, 20, 20))

            def x_px(x_mm: int) -> float:
                return (x_mm - L) * scale

            def y_px_from_bottom(h_mm: int) -> float:
                # h_mm = height from bottom
                return oh - (h_mm * scale)

            # draw mid panels (only up to their height)
            if self.midA_on.isChecked():
                xA = self.midA_x.value()
                hA = self.midA_h.value()
                yTop = y_px_from_bottom(hA)
                self.scene.addLine(x_px(xA), yTop, x_px(xA), oh, pen_mid)

            if self.midB_on.isChecked():
                xB = self.midB_x.value()
                hB = self.midB_h.value()
                yTop = y_px_from_bottom(hB)
                self.scene.addLine(x_px(xB), yTop, x_px(xB), oh, pen_mid)

            # draw shelves per segment (equal distribution)
            segs = self._segments()
            shelves_total = 0
            for seg in segs:
                n = int(self._shelf_counts.get(seg.key, 0))
                if n <= 0:
                    continue
                for i in range(n):
                    y_mm = (i + 1) * (innerH / (n + 1))
                    y = oh - (y_mm * scale)
                    self.scene.addLine(x_px(seg.x0), y, x_px(seg.x1), y, pen_shelf)
                    shelves_total += 1

            # draw caps at mid ends (shelf/dno)
            def draw_cap(mid_name: str, cap_type: str, cap_span: str, mid_height: int):
                nb = self._neighbor_bounds(mid_name)
                if not nb:
                    return
                xL_b, xM, xR_b = nb
                y = y_px_from_bottom(mid_height)

                if cap_type == "NONE":
                    return

                if cap_type == "SHELF":
                    pen = pen_cap_s
                else:
                    pen = pen_cap_b

                if cap_span == "LEFT":
                    self.scene.addLine(x_px(xL_b), y, x_px(xM), y, pen)
                elif cap_span == "RIGHT":
                    self.scene.addLine(x_px(xM), y, x_px(xR_b), y, pen)
                else:  # BOTH
                    self.scene.addLine(x_px(xL_b), y, x_px(xR_b), y, pen)

            if self.midA_on.isChecked():
                draw_cap("A", self.midA_cap_type.currentText(), self.midA_cap_span.currentText(), self.midA_h.value())
            if self.midB_on.isChecked():
                draw_cap("B", self.midB_cap_type.currentText(), self.midB_cap_span.currentText(), self.midB_h.value())

            # BOM text
            txt: List[str] = []
            txt.append(f"W/H/D: {W} / {H} / {D}")
            txt.append(f"Offsets L/R/T/B: {L} / {R} / {self.posT.value()} / {self.posB.value()}")
            txt.append(f"Anchor: {self.anchor.currentText()}")
            txt.append("")
            txt.append("MID:")
            txt.append(f"  midA: {'ON' if self.midA_on.isChecked() else 'OFF'}  X={self.midA_x.value()}  H={self.midA_h.value()}  CAP={self.midA_cap_type.currentText()}  SPAN={self.midA_cap_span.currentText()}")
            txt.append(f"  midB: {'ON' if self.midB_on.isChecked() else 'OFF'}  X={self.midB_x.value()}  H={self.midB_h.value()}  CAP={self.midB_cap_type.currentText()}  SPAN={self.midB_cap_span.currentText()}")
            txt.append("")
            txt.append("SEGMENTS:")
            for seg in segs:
                txt.append(f"  {seg.label} ({seg.x1 - seg.x0}mm) shelves={int(self._shelf_counts.get(seg.key, 0))}")
            txt.append("")
            txt.append(f"TOTAL shelves drawn: {shelves_total}")
            txt.append("")
            txt.append("NEXT: per-segment manual shelves + drag + real parts list (BOM)")

            self.bom.setPlainText("\n".join(txt))
            self._set_ok(True)

        except Exception:
            import traceback
            self._set_ok(False, traceback.format_exc())