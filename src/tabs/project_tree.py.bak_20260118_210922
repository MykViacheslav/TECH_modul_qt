from __future__ import annotations
import os, json
from PySide6 import QtCore, QtWidgets

class ProjectTree(QtWidgets.QWidget):
    """
    One shared "Project Tree" component:
      - shows Modules + Materials (from DB)
      - emits bus signals on click (module load / material selected)
    """
    def __init__(self, ctx=None, parent=None):
        super().__init__(parent)
        self.ctx = ctx

        self.ed = QtWidgets.QLineEdit()
        self.ed.setPlaceholderText("Szukaj w drzewie... (anchor/code/name)")
        self.btn = QtWidgets.QPushButton("Odśwież")

        self.tree = QtWidgets.QTreeWidget()
        self.tree.setHeaderHidden(True)

        top = QtWidgets.QHBoxLayout()
        top.addWidget(self.ed, 1)
        top.addWidget(self.btn)

        lay = QtWidgets.QVBoxLayout(self)
        lay.addLayout(top)
        lay.addWidget(self.tree, 1)

        self.btn.clicked.connect(self.refresh)
        self.ed.textChanged.connect(lambda *_: self.refresh())
        self.tree.itemActivated.connect(self._activated)

        bus = self._bus()
        if bus is not None:
            if hasattr(bus, "modules_changed"):
                try: bus.modules_changed.connect(self.refresh)
                except Exception: pass
            if hasattr(bus, "materials_changed"):
                try: bus.materials_changed.connect(self.refresh)
                except Exception: pass

        self.refresh()

    def _bus(self):
        try:
            if isinstance(self.ctx, dict):
                return self.ctx.get("bus")
            return getattr(self.ctx, "bus", None)
        except Exception:
            return None

    def _db_path(self) -> str:
        try:
            if isinstance(self.ctx, dict) and self.ctx.get("db_path"):
                return str(self.ctx["db_path"])
        except Exception:
            pass
        root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))  # .../src/tabs -> .../src
        proj = os.path.dirname(root)
        return os.path.join(proj, "data", "tech.db")

    def _load_modules(self):
        from tools import module_db_cli
        con = module_db_cli.connect(self._db_path())
        module_db_cli.ensure_schema(con)
        rows = con.execute("SELECT payload_json FROM modules ORDER BY updated_at DESC LIMIT 500").fetchall()
        out = []
        for r in rows:
            try: out.append(json.loads(r["payload_json"]))
            except Exception: pass
        return out

    def _load_materials(self):
        from tools import material_db_cli
        con = material_db_cli.connect(self._db_path())
        material_db_cli.ensure_schema(con)
        rows = con.execute("SELECT payload_json FROM materials ORDER BY updated_at DESC LIMIT 800").fetchall()
        out = []
        for r in rows:
            try: out.append(json.loads(r["payload_json"]))
            except Exception: pass
        return out

    def refresh(self):
        q = (self.ed.text() or "").strip().lower()

        mods = self._load_modules()
        mats = self._load_materials()

        if q:
            def hit_module(o):
                s = " ".join([str(o.get("anchor","")), str(o.get("name","")), str(o.get("materials",""))]).lower()
                return q in s
            def hit_mat(o):
                s = " ".join([str(o.get("code","")), str(o.get("name","")), str(o.get("kind",""))]).lower()
                return q in s
            mods = [o for o in mods if hit_module(o)]
            mats = [o for o in mats if hit_mat(o)]

        self.tree.clear()

        rootMods = QtWidgets.QTreeWidgetItem(["Modules"])
        rootMods.setData(0, QtCore.Qt.UserRole, {"type":"root","name":"modules"})
        self.tree.addTopLevelItem(rootMods)

        for o in mods:
            a = str(o.get("anchor",""))
            nm = str(o.get("name",""))
            it = QtWidgets.QTreeWidgetItem([f"{a}  | {nm}"])
            it.setData(0, QtCore.Qt.UserRole, {"type":"module","anchor":a})
            rootMods.addChild(it)

        rootMats = QtWidgets.QTreeWidgetItem(["Materials"])
        rootMats.setData(0, QtCore.Qt.UserRole, {"type":"root","name":"materials"})
        self.tree.addTopLevelItem(rootMats)

        for o in mats:
            c = str(o.get("code",""))
            nm = str(o.get("name",""))
            it = QtWidgets.QTreeWidgetItem([f"{c}  | {nm}"])
            it.setData(0, QtCore.Qt.UserRole, {"type":"material","code":c})
            rootMats.addChild(it)

        rootMods.setExpanded(True)
        rootMats.setExpanded(True)

    def _activated(self, item, _col):
        meta = item.data(0, QtCore.Qt.UserRole) or {}
        bus = self._bus()

        if bus is not None and hasattr(bus, "project_item_selected"):
            try: bus.project_item_selected.emit(dict(meta))
            except Exception: pass

        if meta.get("type") == "module":
            a = (meta.get("anchor") or "").strip()
            if a and bus is not None and hasattr(bus, "module_load_requested"):
                try: bus.module_load_requested.emit(a)
                except Exception: pass

        if meta.get("type") == "material":
            c = (meta.get("code") or "").strip()
            if c:
                QtWidgets.QApplication.clipboard().setText(c)
            if c and bus is not None and hasattr(bus, "material_selected"):
                try: bus.material_selected.emit(c)
                except Exception: pass
