    @staticmethod
    def _sec_add(sec: CollapsibleSection, w: QtWidgets.QWidget):
        # Support both robust CollapsibleSection and old stubs
        if hasattr(sec, "contentLayout") and sec.contentLayout is not None:
            sec.contentLayout.addWidget(w)
            return
        if hasattr(sec, "content") and sec.content is not None:
            lay = sec.content.layout()
            if lay is None:
                lay = QtWidgets.QVBoxLayout(sec.content)
                lay.setContentsMargins(8, 8, 8, 8)
            lay.addWidget(w)
            return
        lay = sec.layout() or QtWidgets.QVBoxLayout(sec)
        lay.addWidget(w)

