@dataclass
class MidPanelCfg:
    enabled: bool
    x_mm: int
    height_mm: int
    cap_kind: str          # "NONE" | "SHELF" | "BOTTOM"
    cap_span: str          # "BOTH" | "LEFT" | "RIGHT"


class _SegItem(QtWidgets.QGraphicsRectItem):
    def __init__(self, rect: QtCore.QRectF, name: str, owner: "ModuleProtoWidget"):
        super().__init__(rect)
        self.name = name
        self.owner = owner
        self.setAcceptHoverEvents(True)
        self.setCursor(QtCore.Qt.PointingHandCursor)

    def hoverEnterEvent(self, event):
        self.owner._hover_seg = self.name
        self.owner._redraw_only()
        super().hoverEnterEvent(event)

    def hoverLeaveEvent(self, event):
        self.owner._hover_seg = None
        self.owner._redraw_only()
        super().hoverLeaveEvent(event)

    def mousePressEvent(self, event):
        self.owner._select_segment(self.name)
        super().mousePressEvent(event)


class ModuleProtoWidget(QtWidgets.QWidget):
    """
    Proto UI:
    - segments from mid panels (X positions)
    - shelves per segment (All / Seg1 / Seg2 / Seg3)
    - cap above a mid-panel: shelf/bottom, span left/right/both
    - IMPORTANT: cap limits segment height -> shelves don't go "above segment"
    - NEW: click on segment in view -> select SEG
    """

    def _recalc(self):
        """Compatibility: other code calls _recalc()."""
        for name in ("_render", "_redraw", "_update_view", "_refresh", "_recompute", "_calc"):
            fn = getattr(self, name, None)
            if callable(fn):
                return fn()
        return None


    def _sync_shelf_mode(self):
        """Enable/disable shelf controls depending on mode."""
        mode  = getattr(self, 'shelf_mode', None)
        start = getattr(self, 'shelf_start', None)
        step  = getattr(self, 'shelf_step', None)
        if mode is None or start is None or step is None:
            return
        m = mode.currentData() or 'EQUAL'
        on = (m != 'EQUAL')
        start.setEnabled(on)
        step.setEnabled(on)

    def __init__(self, ctx=None, parent=None):
        super().__init__(parent)
        self.ctx = ctx

        self._selected_seg: str = "ALL"
        self._hover_seg: Optional[str] = None

        self._last_render = None  # cache for redraw-only
        self._build_ui()
        self._wire()
        self._recalc()

