        r0 = QtWidgets.QGridLayout(); r0.setContentsMargins(0, 0, 0, 0)
        self.segment = QtWidgets.QComboBox()
        r0.addWidget(QtWidgets.QLabel("Segment"), 0, 0)
        r0.addWidget(self.segment, 0, 1)
        s.addLayout(r0)

        r1 = QtWidgets.QGridLayout(); r1.setContentsMargins(0, 0, 0, 0)
        self.autoShelfCount = QtWidgets.QSpinBox(); self.autoShelfCount.setRange(0, 12); self.autoShelfCount.setValue(1)
