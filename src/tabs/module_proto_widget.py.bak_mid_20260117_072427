from __future__ import annotations

from PySide6 import QtCore, QtWidgets, QtGui

from widgets.collapsible import CollapsibleSection


def _clamp(v: int, lo: int, hi: int) -> int:
    return max(lo, min(hi, v))


class ModuleProtoWidget(QtWidgets.QWidget):
    """
    SAFE proto UI based on web mock (NO dependency on core/module_widget logic).
    Goal: stable never-empty tab + port features step-by-step.
    Now: mid-panels + shelves (with segments between sides/mids).
    """
    def __init__(self, ctx=None, parent=None):
        super().__init__(parent)
        self.ctx = ctx

        self._auto_shelf_boxes: list[QtWidgets.QSpinBox] = []
        self._extra_rows: list[tuple[QtWidgets.QWidget, QtWidgets.QSpinBox]] = []

        self._build_ui()
        self._wire()
        self._rebuild_segments()
        self._rebuild_auto_shelves()
        self._recalc()

