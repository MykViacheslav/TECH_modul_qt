        self.btnAddExtra = QtWidgets.QPushButton("+ Dodaj")
        r2.addWidget(QtWidgets.QLabel("Wysokość od dołu (mm)"), 0, 0)
        r2.addWidget(self.extraShelfY, 0, 1)
        r2.addWidget(self.btnAddExtra, 1, 0, 1, 2)
        s.addLayout(r2)

        self.extraList = QtWidgets.QVBoxLayout()
