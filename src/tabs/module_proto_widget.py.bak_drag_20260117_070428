    def _wire(self):
        for sp in (self.w, self.h, self.d, self.posL, self.posR, self.posT, self.posB, self.midX, self.mid2X):
            sp.valueChanged.connect(self._recalc)
        for cb in (self.midEnabled, self.mid2Enabled):
            cb.stateChanged.connect(self._recalc)
        self.anchor.currentIndexChanged.connect(self._recalc)

        self.btnZero.clicked.connect(self._zero)
        self.autoShelfCount.valueChanged.connect(self._on_auto_count_changed)
        self.btnEqual.clicked.connect(self._equalize_current)
        self.btnClear.clicked.connect(self._clear_current)
        self.btnAddExtra.clicked.connect(self._add_extra)

    # ---------------- logic helpers ----------------
    def _zero(self):
        self.posL.setValue(0); self.posR.setValue(0); self.posT.setValue(0); self.posB.setValue(0)

    def _set_ok(self, ok: bool, msg: str = "OK"):
        if ok:
            self.status.setText("OK")
            self.status.setStyleSheet("QLabel{padding:4px 10px;border-radius:10px;background:#d7ffe1;color:#000;font-weight:700;}")
        else:
            self.status.setText("ERR")
            self.status.setStyleSheet("QLabel{padding:4px 10px;border-radius:10px;background:#ffd6d6;color:#000;font-weight:700;}")
            self.bom.setPlainText(msg)

    def _pick_segment(self, idx: int):
        self._selected_seg = int(idx)
        self._refresh_shelves_ui()
        self._recalc()

    def _compute_segments(self, innerW: int) -> List[Segment]:
        mids: List[int] = []
        if self.midEnabled.isChecked():
            mids.append(int(self.midX.value()))
        if self.mid2Enabled.isChecked():
            mids.append(int(self.mid2X.value()))
        mids2 = []
        for m in mids:
            m = max(1, min(innerW - 1, m))
            mids2.append(m)
        mids2 = sorted(set(mids2))

        cuts = [0] + mids2 + [innerW]
        segs: List[Segment] = []
        for a, b in zip(cuts, cuts[1:]):
            if b > a:
                segs.append(Segment(a, b))
        return segs

    def _ensure_current_shelves(self, innerH: int):
        # keep shelf lists only for existing segments
        max_seg = max(0, len(self._segments) - 1)
        self._shelves_by_seg = {k: v for k, v in self._shelves_by_seg.items() if 0 <= k <= max_seg}

        if self._selected_seg not in self._shelves_by_seg:
            # default: use current auto count only for the first time
            n = int(self.autoShelfCount.value())
            self._shelves_by_seg[self._selected_seg] = self._even_shelves(innerH, n)

        # clamp shelf Ys into [1..innerH-1]
        clamped = []
        for y in self._shelves_by_seg.get(self._selected_seg, []):
            y2 = max(1, min(innerH - 1, int(y)))
            clamped.append(y2)
        self._shelves_by_seg[self._selected_seg] = sorted(set(clamped))

    def _even_shelves(self, innerH: int, n: int) -> List[int]:
        if n <= 0:
            return []
        out = []
        for k in range(n):
            y = round((k + 1) * innerH / (n + 1))
            y = max(1, min(innerH - 1, y))
            out.append(int(y))
        return out

    # ---------------- shelves UI ----------------
    def _clear_layout(self, lay: QtWidgets.QLayout):
        while lay.count():
            it = lay.takeAt(0)
            w = it.widget()
            if w is not None:
                w.deleteLater()

    def _refresh_shelves_ui(self):
        if self._loading_ui:
            return
        self._loading_ui = True
        try:
            # update autoShelfCount to match current list length (per segment)
            cur = self._shelves_by_seg.get(self._selected_seg, [])
            self.autoShelfCount.setValue(len(cur))

            self._clear_layout(self.shelfListLay)

            if not cur:
                lbl = QtWidgets.QLabel("Brak półek w tym segmencie.")
                lbl.setStyleSheet("color:#666; font-size:12px;")
                self.shelfListLay.addWidget(lbl)
                return

            for i, y in enumerate(cur):
                row = QtWidgets.QWidget()
                hl = QtWidgets.QHBoxLayout(row)
                hl.setContentsMargins(0, 0, 0, 0)
                hl.setSpacing(8)

                lab = QtWidgets.QLabel(f"#{i+1}  y(mm)")
                sp = QtWidgets.QSpinBox()
                sp.setRange(1, 5000)
                sp.setValue(int(y))
                btn = QtWidgets.QPushButton("✕")
                btn.setFixedWidth(34)

                def make_on_change(idx: int):
                    def _chg(val: int):
                        arr = list(self._shelves_by_seg.get(self._selected_seg, []))
                        if 0 <= idx < len(arr):
                            arr[idx] = int(val)
                            self._shelves_by_seg[self._selected_seg] = sorted(set(arr))
                            self._refresh_shelves_ui()
                            self._recalc()
                    return _chg

                def make_on_del(idx: int):
                    def _del():
                        arr = list(self._shelves_by_seg.get(self._selected_seg, []))
                        if 0 <= idx < len(arr):
                            arr.pop(idx)
                            self._shelves_by_seg[self._selected_seg] = arr
                            self._refresh_shelves_ui()
                            self._recalc()
                    return _del

                sp.valueChanged.connect(make_on_change(i))
                btn.clicked.connect(make_on_del(i))

                hl.addWidget(lab)
                hl.addWidget(sp, 1)
                hl.addWidget(btn)
                self.shelfListLay.addWidget(row)
        finally:
            self._loading_ui = False

    def _on_auto_count_changed(self, n: int):
        if self._loading_ui:
            return
        # auto count == "generate even shelves" for THIS segment
        # (user can still edit after generation)
        try:
            innerH = max(1, self.h.value() - self.posT.value() - self.posB.value())
            self._shelves_by_seg[self._selected_seg] = self._even_shelves(innerH, int(n))
            self._refresh_shelves_ui()
            self._recalc()
        except Exception:
            pass

    def _equalize_current(self):
        innerH = max(1, self.h.value() - self.posT.value() - self.posB.value())
        n = int(self.autoShelfCount.value())
        self._shelves_by_seg[self._selected_seg] = self._even_shelves(innerH, n)
        self._refresh_shelves_ui()
        self._recalc()

    def _clear_current(self):
        self._shelves_by_seg[self._selected_seg] = []
        self._refresh_shelves_ui()
        self._recalc()

    def _add_extra(self):
        innerH = max(1, self.h.value() - self.posT.value() - self.posB.value())
        y = int(self.extraY.value())
        y = max(1, min(innerH - 1, y))
        arr = list(self._shelves_by_seg.get(self._selected_seg, []))
        arr.append(y)
        self._shelves_by_seg[self._selected_seg] = sorted(set(arr))
        self._refresh_shelves_ui()
        self._recalc()

    # ---------------- main recalc/draw ----------------
    def _recalc(self):
        try:
            W, H, D = self.w.value(), self.h.value(), self.d.value()
            L, R, T, B = self.posL.value(), self.posR.value(), self.posT.value(), self.posB.value()

            innerW = max(1, W - L - R)
            innerH = max(1, H - T - B)

            self._segments = self._compute_segments(innerW)
            if not self._segments:
                self._segments = [Segment(0, innerW)]
            if self._selected_seg >= len(self._segments):
                self._selected_seg = 0

            self._ensure_current_shelves(innerH)

            seg = self._segments[self._selected_seg]
            self.segInfo.setText(f"Segment: {self._selected_seg+1}/{len(self._segments)}  |  szerokość: {seg.w} mm")

            # keep extraY range sensible
            self.extraY.setRange(1, max(1, innerH - 1))

            # draw
            self.scene.clear()
            scale = 0.65
            ow = innerW * scale
            oh = innerH * scale

            outer = QtCore.QRectF(0, 0, ow, oh)
            self.scene.addRect(outer, QtGui.QPen(QtGui.QColor(30, 30, 30), 2.2))

            # segments
            for i, s in enumerate(self._segments):
                x0 = s.x0 * scale
                x1 = s.x1 * scale
                r = QtCore.QRectF(x0, 0, max(1.0, x1 - x0), oh)
                it = _SegRect(i, r, self._pick_segment)
                it.sync_style(i == self._selected_seg)
                self.scene.addItem(it)

                # dashed mid line (except last)
                if i < len(self._segments) - 1:
                    x = x1
                    self.scene.addLine(x, 0, x, oh, QtGui.QPen(QtGui.QColor(120, 120, 120), 1.2, QtCore.Qt.DashLine))

            # shelves in selected segment
            shelves = self._shelves_by_seg.get(self._selected_seg, [])
            if shelves:
                x0 = seg.x0 * scale
                x1 = seg.x1 * scale
                pen = QtGui.QPen(QtGui.QColor(60, 60, 60), 1.6)
                for y_mm in shelves:
                    y_mm = max(1, min(innerH - 1, int(y_mm)))
                    y_scene = (innerH - y_mm) * scale  # y is from bottom
                    self.scene.addLine(x0, y_scene, x1, y_scene, pen)

            self.scene.setSceneRect(outer.adjusted(-30, -30, 30, 30))

            # BOM
            shelves_str = ", ".join(str(x) for x in self._shelves_by_seg.get(self._selected_seg, [])) or "—"
            txt = []
            txt.append(f"W/H/D: {W} / {H} / {D}")
            txt.append(f"Offsets L/R/T/B: {L} / {R} / {T} / {B}")
            txt.append(f"Inner W/H: {innerW} / {innerH}")
            txt.append(f"Segments: {len(self._segments)} (selected: {self._selected_seg+1}, width={seg.w}mm)")
            txt.append(f"Shelves in selected seg (mm od dołu): {shelves_str}")
            txt.append("")
            txt.append("NEXT: drag mid panels + drag shelves (MVP), then extra shelves list per-segment.")
            self.bom.setPlainText("\n".join(txt))

            # refresh list only when safe
            if not self._loading_ui:
                self._refresh_shelves_ui()

            self._set_ok(True)
        except Exception:
            import traceback
            self._set_ok(False, traceback.format_exc())