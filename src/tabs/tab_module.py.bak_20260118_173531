from __future__ import annotations
import inspect
from PySide6 import QtCore, QtWidgets

from .module_db_panel import ModuleDbPanel

def _pick_qwidget_class(mod):
    cands = []
    for name, obj in inspect.getmembers(mod, inspect.isclass):
        try:
            if issubclass(obj, QtWidgets.QWidget) and obj is not QtWidgets.QWidget:
                cands.append((name, obj))
        except Exception:
            pass
    # prefer names that look like a tab/widget
    prio = []
    for name, cls in cands:
        n = name.lower()
        score = 0
        if "tab" in n: score += 3
        if "module" in n: score += 3
        if "widget" in n: score += 2
        prio.append((score, name, cls))
    prio.sort(reverse=True, key=lambda x: x[0])
    return prio[0][2] if prio else None

def _make_legacy_widget(ctx):
    # Prefer web tab -> proto tab -> raw ModuleProtoWidget
    try:
        from . import tab_module_web as m
        cls = _pick_qwidget_class(m)
        if cls is not None:
            return cls(ctx)
    except Exception:
        pass

    try:
        from . import tab_module_proto as m
        cls = _pick_qwidget_class(m)
        if cls is not None:
            return cls(ctx)
    except Exception:
        pass

    try:
        from .module_proto_widget import ModuleProtoWidget
        return ModuleProtoWidget(ctx)
    except Exception:
        pass

    # last resort
    w = QtWidgets.QLabel("Brak legacy widget (tab_module_web/proto).")
    w.setAlignment(QtCore.Qt.AlignCenter)
    return w

class ModuleTab(QtWidgets.QWidget):
    """
    MODUL = legacy konstruktor + panel DB na dole.
    Nie psujemy starego UI — tylko dokładamy zapis/odczyt.
    """
    def __init__(self, ctx=None, parent=None):
        super().__init__(parent)
        self.ctx = ctx

        self.core = _make_legacy_widget(ctx)
        self.db_panel = ModuleDbPanel(self.core, ctx=ctx)

        splitter = QtWidgets.QSplitter(QtCore.Qt.Vertical)
        splitter.addWidget(self.core)
        splitter.addWidget(self.db_panel)
        splitter.setStretchFactor(0, 10)
        splitter.setStretchFactor(1, 0)

        lay = QtWidgets.QVBoxLayout(self)
        lay.setContentsMargins(6,6,6,6)
        lay.addWidget(splitter)
