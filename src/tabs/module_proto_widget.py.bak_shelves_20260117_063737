        # demo items; later we wire to real library
        self.moduleGroup.clear()
        self.moduleGroup.addItems(["Base", "Góra", "Słupek", "Custom"])

        mats = ["Płyta 18", "Płyta 16", "MDF 18", "Sklejka 15"]
        for cb in (self.midMat, self.mid2Mat, self.backMat, self.frontMat, self.drawerBottomMat, self.drawerBackMat, self.drawerWoodMat):
            cb.clear()
            cb.addItems(["—"] + mats)

        self.hingeType.clear()
        self.hingeType.addItems(["—", "Blum ClipTop", "Hettich Sensys"])
        self.runnerType.clear()
        self.runnerType.addItems(["—", "Blum Tandem", "Blum Movento", "Hettich Quadro"])

    def _wire(self):
        # live update -> recalc
        spin_widgets = [
            self.w, self.h, self.d,
            self.anchorDX, self.anchorDY,
            self.posL, self.posR, self.posT, self.posB,
            self.midX, self.midOffT, self.midOffB,
            self.mid2X, self.mid2OffT, self.mid2OffB,
            self.autoShelfCount, self.extraShelfY,
            self.frontInset, self.frontCount, self.frontGap,
            self.mountCount, self.legsH, self.drawerClear
        ]
        for sp in spin_widgets:
            sp.valueChanged.connect(self._recalc)

        combo_widgets = [
            self.anchor, self.sideMode,
            self.moduleGroup, self.backEnabled, self.backMat,
            self.frontMode, self.frontMat, self.frontHeightMode,
            self.drawerSystem, self.hingeType, self.runnerType, self.mountType,
            self.drawerBottomMat, self.drawerBackMat, self.drawerWoodMat,
            self.midMat, self.mid2Mat
        ]
        for cb in combo_widgets:
            cb.currentIndexChanged.connect(self._recalc)

        check_widgets = [
            self.hasLeft, self.hasRight, self.hasTop, self.hasBottom, self.hasBack, self.hasFront,
            self.midEnabled, self.mid2Enabled, self.cornerFront, self.drawerEstimate
        ]
        for c in check_widgets:
            c.stateChanged.connect(self._recalc)

        self.moduleName.textChanged.connect(self._recalc)
        self.drawerHeights.textChanged.connect(self._recalc)

        # buttons
        self.btnZero.clicked.connect(self._zero)
        self.btnLR.clicked.connect(self._lr_same)
        self.btnTB.clicked.connect(self._tb_same)
        self.btnShelvesClear.clicked.connect(self._shelves_clear)
        self.btnShelvesEqual.clicked.connect(self._shelves_equal)
        self.btnAddExtraShelf.clicked.connect(self._add_extra_shelf)
        self.btnRemoveExtra.clicked.connect(self._remove_extra_shelf)

        # show/hide wrappers
        self.midEnabled.toggled.connect(self.midWrap.setVisible)
        self.mid2Enabled.toggled.connect(self.mid2Wrap.setVisible)

    def _zero(self):
        self.posL.setValue(0); self.posR.setValue(0); self.posT.setValue(0); self.posB.setValue(0)

    def _lr_same(self):
        self.posR.setValue(self.posL.value())

    def _tb_same(self):
        self.posB.setValue(self.posT.value())

    def _shelves_clear(self):
        self.autoShelfCount.setValue(0)

    def _shelves_equal(self):
        # set equal positions for existing shelf spinboxes (simple)
        spins = self.shelfListWrap.findChildren(QtWidgets.QSpinBox)
        if not spins:
            return
        H = self.h.value()
        T = self.posT.value()
        B = self.posB.value()
        opening = max(1, H - T - B)
        n = len(spins)
        for i, sp in enumerate(spins, start=1):
            sp.blockSignals(True)
            sp.setValue(int(i * opening / (n + 1)))
            sp.blockSignals(False)
        self._recalc()

    def _add_extra_shelf(self):
        y = int(self.extraShelfY.value())
        self.extra_shelves.append(ExtraShelf(y_mm=y))
        self._refresh_extra_list()
        self._recalc()

    def _remove_extra_shelf(self):
        row = self.extraList.currentRow()
        if row >= 0 and row < len(self.extra_shelves):
            self.extra_shelves.pop(row)
            self._refresh_extra_list()
            self._recalc()

    def _refresh_extra_list(self):
        self.extraList.clear()
        for s in self.extra_shelves:
            self.extraList.addItem(f"Extra shelf @ {s.y_mm} mm")

    def _rebuild_shelves_ui(self):
        # clear
        while self.shelfListLay.count():
            it = self.shelfListLay.takeAt(0)
            w = it.widget()
            if w:
                w.deleteLater()

        n = int(self.autoShelfCount.value())
        if n <= 0:
            lab = QtWidgets.QLabel("— brak półek auto —")
            lab.setStyleSheet("color:#6b7280;")
            self.shelfListLay.addWidget(lab)
            return

        # default equal
        H = self.h.value()
        T = self.posT.value()
        B = self.posB.value()
        opening = max(1, H - T - B)

        for i in range(1, n + 1):
            row = QtWidgets.QHBoxLayout()
            row.setContentsMargins(0, 0, 0, 0)
            row.setSpacing(8)
            lab = QtWidgets.QLabel(f"Półka #{i} (mm od dołu)")
            sp = QtWidgets.QSpinBox()
            sp.setRange(1, 5000)
            sp.setValue(int(i * opening / (n + 1)))
            sp.valueChanged.connect(self._recalc)
            row.addWidget(lab, 1)
            row.addWidget(sp, 0)
            w = QtWidgets.QWidget()
            w.setLayout(row)
            self.shelfListLay.addWidget(w)

    def _set_ok(self, ok: bool, msg: str = "OK"):
        if ok:
            self.status.setText("OK")
            self.status.setStyleSheet(
                "QLabel{padding:4px 10px;border-radius:10px;background:#d7ffe1;color:#000;font-weight:700;}"
            )
        else:
            self.status.setText("ERR")
            self.status.setStyleSheet(
                "QLabel{padding:4px 10px;border-radius:10px;background:#ffd6d6;color:#000;font-weight:700;}"
            )
            self.bom.setPlainText(msg)

    def _recalc(self):
        try:
            # show drawer row only if mode=drawers
            mode = self.frontMode.currentText()
            is_drawers = (mode.lower().startswith("szuf"))
            self.drawerRow.setVisible(is_drawers)
            self.drawerMatWrap.setVisible(bool(self.drawerEstimate.isChecked()))

            # shelves UI rebuild (cheap enough)
            self._rebuild_shelves_ui()
            self._refresh_extra_list()

            W, H, D = self.w.value(), self.h.value(), self.d.value()
            L, R, T, B = self.posL.value(), self.posR.value(), self.posT.value(), self.posB.value()

            # view: simple opening rect
            self.scene.clear()
            scale = 0.60
            ow = max(1, (W - L - R)) * scale
            oh = max(1, (H - T - B)) * scale
            rect = QtCore.QRectF(0, 0, ow, oh)
            self.scene.addRect(rect, QtGui.QPen(QtGui.QColor(40, 40, 40), 2))
            self.scene.setSceneRect(rect.adjusted(-20, -20, 20, 20))

            # details (proto)
            parts_txt = []
            parts_txt.append("PROTO parts list (dummy):")
            parts_txt.append(f"- carcass opening: {max(1,W-L-R)} x {max(1,H-T-B)}")
            parts_txt.append(f"- elements: L={self.hasLeft.isChecked()} R={self.hasRight.isChecked()} T={self.hasTop.isChecked()} B={self.hasBottom.isChecked()}")
            parts_txt.append(f"- back={self.hasBack.isChecked()} front={self.hasFront.isChecked()}")
            self.parts.setPlainText("\n".join(parts_txt))

            # BOM (proto summary)
            bom = []
            bom.append(f"Group/Name: {self.moduleGroup.currentText()} / {self.moduleName.text().strip() or '—'}")
            bom.append(f"W/H/D: {W} / {H} / {D}")
            bom.append(f"Offsets L/R/T/B: {L} / {R} / {T} / {B}    mode: {self.sideMode.currentText()}")
            bom.append(f"Anchor: {self.anchor.currentText()}  dx/dy: {self.anchorDX.value()} / {self.anchorDY.value()}")
            bom.append("")
            bom.append("Elements:")
            bom.append(f"  Left:{self.hasLeft.isChecked()} Right:{self.hasRight.isChecked()} Top:{self.hasTop.isChecked()} Bottom:{self.hasBottom.isChecked()}")
            bom.append(f"  Back:{self.hasBack.isChecked()} (enabled={self.backEnabled.currentText()} mat={self.backMat.currentText()})")
            bom.append(f"  Front:{self.hasFront.isChecked()} (mode={self.frontMode.currentText()} count={self.frontCount.value()} mat={self.frontMat.currentText()})")
            bom.append("")
            bom.append("Mid panels:")
            bom.append(f"  midA: {self.midEnabled.isChecked()} x={self.midX.value()} mat={self.midMat.currentText()}")
            bom.append(f"  midB: {self.mid2Enabled.isChecked()} x={self.mid2X.value()} mat={self.mid2Mat.currentText()}")
            bom.append("")
            bom.append(f"Shelves auto: {self.autoShelfCount.value()} | extra: {len(self.extra_shelves)}")
            bom.append("")
            bom.append("NEXT: зробимо drag та “віконечко” для редагування як у вебі, але по 1 фічі.")

            self.bom.setPlainText("\n".join(bom))
            self._set_ok(True)

        except Exception:
            import traceback
            self._set_ok(False, traceback.format_exc())