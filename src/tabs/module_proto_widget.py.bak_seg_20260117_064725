    SAFE proto UI based on web mock (NO dependency on core/module_widget logic).
    Step now: PÓŁKI: draw + drag in view.
    """
    def __init__(self, ctx=None, parent=None):
        super().__init__(parent)
        self.ctx = ctx

        # shelves state
        self.auto_shelves: List[int] = []         # y_mm from bottom (in opening)
        self.extra_shelves: List[ExtraShelf] = [] # y_mm from bottom

        # selection state
        self.sel: Optional[Tuple[str, int]] = None  # ("auto"/"extra", idx)

        # view state
        self._scale = 0.60
        self._opening_w_mm = 1
        self._opening_h_mm = 1
