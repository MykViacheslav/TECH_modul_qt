    def _fill_demo_data(self):
        # initial auto shelves
        if not self.auto_shelves:
            self.auto_shelves = [200]

    def _wire(self):
        # recalc triggers
        for sp in (self.w, self.h, self.d, self.anchorDX, self.anchorDY, self.posL, self.posR, self.posT, self.posB, self.autoShelfCount, self.extraShelfY):
            sp.valueChanged.connect(self._recalc)
        self.anchor.currentIndexChanged.connect(self._recalc)

        # buttons
        self.btnZero.clicked.connect(self._zero)
        self.btnLR.clicked.connect(self._lr_same)
        self.btnTB.clicked.connect(self._tb_same)
        self.btnShelvesClear.clicked.connect(self._shelves_clear)
        self.btnShelvesEqual.clicked.connect(self._shelves_equal)
        self.btnAddExtraShelf.clicked.connect(self._add_extra_shelf)
        self.btnRemoveExtra.clicked.connect(self._remove_extra_shelf)

        # list selection (extra)
        self.extraList.currentRowChanged.connect(self._select_extra_from_list)

    def _zero(self):
        self.posL.setValue(0); self.posR.setValue(0); self.posT.setValue(0); self.posB.setValue(0)

    def _lr_same(self):
        self.posR.setValue(self.posL.value())

    def _tb_same(self):
        self.posB.setValue(self.posT.value())

    def _shelves_clear(self):
        self.autoShelfCount.setValue(0)

    def _shelves_equal(self):
        # equal distribution for auto shelves in opening
        n = int(self.autoShelfCount.value())
        if n <= 0:
            self.auto_shelves = []
            self._recalc()
            return
        opening = max(2, int(self._opening_h_mm))
        self.auto_shelves = [int(round(i * opening / (n + 1))) for i in range(1, n + 1)]
        self._recalc()

    def _add_extra_shelf(self):
        y = int(self.extraShelfY.value())
        self.extra_shelves.append(ExtraShelf(y_mm=y))
        self._refresh_extra_list()
        # select newly added
        self.sel = ("extra", len(self.extra_shelves) - 1)
        self._recalc()

    def _remove_extra_shelf(self):
        row = self.extraList.currentRow()
        if row >= 0 and row < len(self.extra_shelves):
            self.extra_shelves.pop(row)
            self.sel = None
            self._refresh_extra_list()
            self._recalc()

    def _refresh_extra_list(self):
        self.extraList.blockSignals(True)
        self.extraList.clear()
        for s in self.extra_shelves:
            self.extraList.addItem(f"Extra shelf @ {s.y_mm} mm")
        self.extraList.blockSignals(False)

    def _select_extra_from_list(self, row: int):
        if row >= 0 and row < len(self.extra_shelves):
            self.sel = ("extra", row)
            self._recalc()

    def _ensure_auto_shelves_len(self):
        n = int(self.autoShelfCount.value())
        n = max(0, min(12, n))
        opening = max(2, int(self._opening_h_mm))

        if n == 0:
            self.auto_shelves = []
            return

        if len(self.auto_shelves) < n:
            # extend with equal positions
            base = [int(round(i * opening / (n + 1))) for i in range(1, n + 1)]
            for i in range(len(self.auto_shelves), n):
                self.auto_shelves.append(base[i])
        elif len(self.auto_shelves) > n:
            self.auto_shelves = self.auto_shelves[:n]

        # clamp to 1..opening-1
        self.auto_shelves = [max(1, min(opening - 1, int(v))) for v in self.auto_shelves]

    def _rebuild_shelves_ui(self):
        # clear UI list
        while self.shelfListLay.count():
            it = self.shelfListLay.takeAt(0)
            w = it.widget()
            if w:
                w.deleteLater()

        n = int(self.autoShelfCount.value())
        if n <= 0:
            lab = QtWidgets.QLabel("— brak półek auto —")
            lab.setStyleSheet("color:#6b7280;")
            self.shelfListLay.addWidget(lab)
            return

        # build spinboxes bound to auto_shelves
        for i in range(n):
            row = QtWidgets.QHBoxLayout()
            row.setContentsMargins(0, 0, 0, 0)
            row.setSpacing(8)
            lab = QtWidgets.QLabel(f"Półka #{i+1} (mm od dołu)")
            sp = QtWidgets.QSpinBox()
            sp.setRange(1, 5000)
            sp.setValue(int(self.auto_shelves[i]))
            sp.valueChanged.connect(lambda val, idx=i: self._auto_spin_changed(idx, val))
            selBtn = QtWidgets.QPushButton("Select")
            selBtn.clicked.connect(lambda _=False, idx=i: self._select_shelf("auto", idx))
            row.addWidget(lab, 1)
            row.addWidget(sp, 0)
            row.addWidget(selBtn, 0)
            w = QtWidgets.QWidget()
            w.setLayout(row)
            self.shelfListLay.addWidget(w)

    def _auto_spin_changed(self, idx: int, val: int):
        if 0 <= idx < len(self.auto_shelves):
            opening = max(2, int(self._opening_h_mm))
            self.auto_shelves[idx] = max(1, min(opening - 1, int(val)))
            self.sel = ("auto", idx)
            self._recalc()

    def _select_shelf(self, kind: str, idx: int):
        self.sel = (kind, int(idx))
        if kind == "extra":
            self.extraList.setCurrentRow(int(idx))
        self._recalc()

    def _set_ok(self, ok: bool, msg: str = "OK"):
        if ok:
            self.status.setText("OK")
            self.status.setStyleSheet("QLabel{padding:4px 10px;border-radius:10px;background:#d7ffe1;color:#000;font-weight:700;}")
        else:
            self.status.setText("ERR")
            self.status.setStyleSheet("QLabel{padding:4px 10px;border-radius:10px;background:#ffd6d6;color:#000;font-weight:700;}")
            self.bom.setPlainText(msg)

    # --- view helpers ---
    def _on_shelf_drag(self, kind: str, idx: int, y_mm_from_bottom: int):
        opening = max(2, int(self._opening_h_mm))
        y_mm_from_bottom = max(1, min(opening - 1, int(y_mm_from_bottom)))

        if kind == "auto" and 0 <= idx < len(self.auto_shelves):
            self.auto_shelves[idx] = y_mm_from_bottom
            self.sel = ("auto", idx)
            self._recalc()
            return

        if kind == "extra" and 0 <= idx < len(self.extra_shelves):
            self.extra_shelves[idx].y_mm = y_mm_from_bottom
            self.sel = ("extra", idx)
            self._refresh_extra_list()
            self.extraList.setCurrentRow(idx)
            self._recalc()
            return

    def _on_shelf_select(self, kind: str, idx: int):
        self._select_shelf(kind, idx)

    def _draw_opening_and_shelves(self):
        self.scene.clear()

        # opening rect
        rect = QtCore.QRectF(0, 0, float(self._opening_w_px), float(self._opening_h_px))
        self.scene.addRect(rect, QtGui.QPen(QtGui.QColor(40, 40, 40), 2))
        self.scene.setSceneRect(rect.adjusted(-30, -30, 30, 30))

        # helper convert y_mm_from_bottom -> y_px_from_top
        def ypx(y_mm_from_bottom: int) -> float:
            y_mm_from_bottom = max(1, min(self._opening_h_mm - 1, int(y_mm_from_bottom)))
            y_mm_from_top = self._opening_h_mm - y_mm_from_bottom
            return float(y_mm_from_top) * self._scale

        # draw auto shelves (solid)
        for i, y in enumerate(self.auto_shelves):
            dashed = False
            line = ShelfLine(
                width_px=self._opening_w_px,
                y_from_top_px=ypx(y),
                opening_h_mm=self._opening_h_mm,
                scale=self._scale,
                kind="auto",
                idx=i,
                on_change=self._on_shelf_drag,
                on_select=self._on_shelf_select,
                dashed=dashed,
            )
            if self.sel == ("auto", i):
                pen = line.pen()
                pen.setWidth(4)
                line.setPen(pen)
            self.scene.addItem(line)

            label = self.scene.addText(f"A{i+1}:{y}mm")
            label.setDefaultTextColor(QtGui.QColor(60, 60, 60))
            label.setPos(self._opening_w_px + 8, ypx(y) - 10)

        # draw extra shelves (dashed)
        for i, s in enumerate(self.extra_shelves):
            y = int(s.y_mm)
            line = ShelfLine(
                width_px=self._opening_w_px,
                y_from_top_px=ypx(y),
                opening_h_mm=self._opening_h_mm,
                scale=self._scale,
                kind="extra",
                idx=i,
                on_change=self._on_shelf_drag,
                on_select=self._on_shelf_select,
                dashed=True,
            )
            if self.sel == ("extra", i):
                pen = line.pen()
                pen.setWidth(4)
                line.setPen(pen)
            self.scene.addItem(line)

            label = self.scene.addText(f"E{i+1}:{y}mm")
            label.setDefaultTextColor(QtGui.QColor(90, 90, 90))
            label.setPos(self._opening_w_px + 8, ypx(y) - 10)

    def _recalc(self):
        try:
            W, H, D = self.w.value(), self.h.value(), self.d.value()
            L, R, T, B = self.posL.value(), self.posR.value(), self.posT.value(), self.posB.value()

            self._opening_w_mm = max(2, int(W - L - R))
            self._opening_h_mm = max(2, int(H - T - B))
            self._opening_w_px = float(self._opening_w_mm) * self._scale
            self._opening_h_px = float(self._opening_h_mm) * self._scale

            # keep auto shelves consistent with count and opening
            self._ensure_auto_shelves_len()

            # rebuild UI lists
            self._rebuild_shelves_ui()
            self._refresh_extra_list()
            if self.sel and self.sel[0] == "extra":
                self.extraList.setCurrentRow(self.sel[1])

            # draw
            self._draw_opening_and_shelves()

            # BOM text
            sel_txt = "—"
            if self.sel:
                kind, idx = self.sel
                if kind == "auto" and 0 <= idx < len(self.auto_shelves):
                    sel_txt = f"Auto #{idx+1} @ {self.auto_shelves[idx]} mm"
                elif kind == "extra" and 0 <= idx < len(self.extra_shelves):
                    sel_txt = f"Extra #{idx+1} @ {self.extra_shelves[idx].y_mm} mm"

            bom = []
            bom.append(f"Selected shelf: {sel_txt}")
            bom.append("")
            bom.append(f"W/H/D: {W} / {H} / {D}")
            bom.append(f"Offsets L/R/T/B: {L} / {R} / {T} / {B}")
            bom.append(f"Opening (mm): {self._opening_w_mm} x {self._opening_h_mm}")
            bom.append("")
            bom.append(f"Auto shelves: {len(self.auto_shelves)} -> {self.auto_shelves}")
            bom.append(f"Extra shelves: {len(self.extra_shelves)} -> {[s.y_mm for s in self.extra_shelves]}")
            bom.append("")
            bom.append("TIP: przeciągnij linię półki w widoku (pionowo).")
            self.bom.setPlainText("\n".join(bom))

            self._set_ok(True)
        except Exception:
            import traceback
            self._set_ok(False, traceback.format_exc())