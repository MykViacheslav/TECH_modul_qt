@dataclass
class ExtraShelf:
    y_mm: int


class ShelfLine(QtWidgets.QGraphicsLineItem):
    """
    Draggable horizontal shelf line constrained to X=0 and within opening height.
    It reports y_mm_from_bottom back to owner.
    """
    def __init__(
        self,
        width_px: float,
        y_from_top_px: float,
        opening_h_mm: int,
        scale: float,
        kind: str,   # "auto" | "extra"
        idx: int,
        on_change,
        on_select,
        dashed: bool = False,
    ):
        super().__init__(0.0, 0.0, float(width_px), 0.0)
        self._opening_h_mm = int(opening_h_mm)
        self._scale = float(scale)
        self.kind = kind
        self.idx = int(idx)
        self._on_change = on_change
        self._on_select = on_select

        self.setPos(0.0, float(y_from_top_px))
        self.setZValue(10)

        pen = QtGui.QPen(QtGui.QColor(40, 40, 40), 2)
        if dashed:
            pen.setStyle(QtCore.Qt.DashLine)
        self.setPen(pen)

        self.setFlag(QtWidgets.QGraphicsItem.ItemIsMovable, True)
        self.setFlag(QtWidgets.QGraphicsItem.ItemIsSelectable, True)
        self.setFlag(QtWidgets.QGraphicsItem.ItemSendsGeometryChanges, True)
        self.setAcceptHoverEvents(True)

    def hoverEnterEvent(self, ev):
        QtWidgets.QApplication.setOverrideCursor(QtCore.Qt.SizeVerCursor)
        super().hoverEnterEvent(ev)

    def hoverLeaveEvent(self, ev):
        QtWidgets.QApplication.restoreOverrideCursor()
        super().hoverLeaveEvent(ev)

    def mousePressEvent(self, ev):
        try:
            if callable(self._on_select):
                self._on_select(self.kind, self.idx)
        finally:
            super().mousePressEvent(ev)

    def itemChange(self, change, value):
        if change == QtWidgets.QGraphicsItem.ItemPositionChange:
            p = value
            if isinstance(p, QtCore.QPointF):
                # clamp x = 0
                x = 0.0
                # clamp y within [0 .. opening_h_px]
                opening_h_px = self._opening_h_mm * self._scale
                y = max(0.0, min(float(p.y()), float(opening_h_px)))
                return QtCore.QPointF(x, y)

        if change == QtWidgets.QGraphicsItem.ItemPositionHasChanged:
            try:
                y_from_top_px = float(self.pos().y())
                y_mm_from_bottom = int(round(self._opening_h_mm - (y_from_top_px / self._scale)))
                # keep in sensible bounds
                y_mm_from_bottom = max(1, min(self._opening_h_mm - 1, y_mm_from_bottom))
                if callable(self._on_change):
                    self._on_change(self.kind, self.idx, y_mm_from_bottom)
            except Exception:
                pass

        return super().itemChange(change, value)


