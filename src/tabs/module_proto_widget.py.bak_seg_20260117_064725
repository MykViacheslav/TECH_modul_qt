        self._fill_demo_data()
        self._wire()
        self._recalc()

    # ---- CollapsibleSection compatibility layer ----
    def _sec_add(self, sec: QtWidgets.QWidget, w: QtWidgets.QWidget) -> None:
        fn = getattr(sec, "addWidget", None)
        if callable(fn):
            try:
                fn(w)
                return
            except Exception:
                pass

        for name in ("contentLayout", "content_layout", "innerLayout", "bodyLayout", "containerLayout"):
            lay = getattr(sec, name, None)
            if isinstance(lay, QtWidgets.QLayout):
                lay.addWidget(w)
                return

        for name in ("content", "container", "body", "panel", "frame"):
            cw = getattr(sec, name, None)
            if isinstance(cw, QtWidgets.QWidget):
                lay = cw.layout()
                if lay is None:
                    lay = QtWidgets.QVBoxLayout(cw)
                    lay.setContentsMargins(0, 0, 0, 0)
                lay.addWidget(w)
                return

        lay = sec.layout()
        if lay is None:
            lay = QtWidgets.QVBoxLayout(sec)
            lay.setContentsMargins(0, 0, 0, 0)
        lay.addWidget(w)

