from __future__ import annotations

from dataclasses import dataclass
from typing import Dict, List, Tuple

from PySide6 import QtCore, QtWidgets, QtGui

from widgets.collapsible import CollapsibleSection


@dataclass
class Segment:
    key: str
    label: str
    x0: int  # mm
    x1: int  # mm


class ModuleProtoWidget(QtWidgets.QWidget):
    """
    SAFE proto UI based on web mock (NO dependency on core/module_widget logic).
    Goal: stable never-empty tab, step-by-step porting.

    This step adds:
      - mid panels (midA/midB) with X positions
      - shelves per segment (L->A, A->B, B->R etc)
      - drawing mid lines + shelves in view
    """

    def __init__(self, ctx=None, parent=None):
        super().__init__(parent)
        self.ctx = ctx

        # runtime state for shelves counts per segment key
        self._shelf_counts: Dict[str, int] = {}
        self._seg_spins: Dict[str, QtWidgets.QSpinBox] = {}
        self._seg_equal_btns: Dict[str, QtWidgets.QPushButton] = {}

        self._build_ui()
        self._wire()
        self._rebuild_shelves_ui()
        self._recalc()

    # ---------- UI helpers ----------
    def _sec_layout(self, sec: CollapsibleSection) -> QtWidgets.QVBoxLayout:
        """
        Defensive: some earlier versions of CollapsibleSection did not have contentLayout.
        This guarantees we have a layout to add widgets to.
        """
        lay = getattr(sec, "contentLayout", None)
        if lay is not None:
            return lay

        content = getattr(sec, "content", None)
        if content is None:
            # last resort: create content widget under section
            content = QtWidgets.QWidget(sec)
            sec_layout = sec.layout()
            if sec_layout is None:
                sec_layout = QtWidgets.QVBoxLayout(sec)
                sec_layout.setContentsMargins(0, 0, 0, 0)
            sec_layout.addWidget(content)

            sec.content = content  # type: ignore

        lay2 = content.layout()
        if lay2 is None:
            lay2 = QtWidgets.QVBoxLayout(content)
            lay2.setContentsMargins(0, 0, 0, 0)
            lay2.setSpacing(6)

        sec.contentLayout = lay2  # type: ignore
        return lay2  # type: ignore

    # ---------- build UI ----------
    def _build_ui(self):
        root = QtWidgets.QVBoxLayout(self)
        root.setContentsMargins(8, 8, 8, 8)
        root.setSpacing(8)

        # status pill
        top = QtWidgets.QHBoxLayout()
        top.addStretch(1)
        self.status = QtWidgets.QLabel("OK")
        self.status.setAlignment(QtCore.Qt.AlignCenter)
        self.status.setFixedWidth(60)
        self.status.setStyleSheet(
            "QLabel{padding:4px 10px;border-radius:10px;background:#d7ffe1;color:#000;font-weight:700;}"
        )
        top.addWidget(self.status)
        root.addLayout(top)

        self.split = QtWidgets.QSplitter(QtCore.Qt.Horizontal)
        root.addWidget(self.split, 1)

        # LEFT
        leftWrap = QtWidgets.QWidget()
        leftLay = QtWidgets.QVBoxLayout(leftWrap)
        leftLay.setContentsMargins(0, 0, 0, 0)
        leftLay.setSpacing(10)

        # --- DIMS ---
        self.secDims = CollapsibleSection("Wymiary + Anchor")
        dims = QtWidgets.QWidget()
        g = QtWidgets.QGridLayout(dims)
        g.setContentsMargins(0, 0, 0, 0)
        g.setHorizontalSpacing(10)
        g.setVerticalSpacing(6)

        self.w = QtWidgets.QSpinBox(); self.w.setRange(50, 5000); self.w.setValue(600)
        self.h = QtWidgets.QSpinBox(); self.h.setRange(50, 5000); self.h.setValue(720)
        self.d = QtWidgets.QSpinBox(); self.d.setRange(50, 2000); self.d.setValue(560)

        self.anchor = QtWidgets.QComboBox()
        self.anchor.addItems(["NONE", "LT", "RT", "LB", "RB"])

        g.addWidget(QtWidgets.QLabel("W (mm)"), 0, 0); g.addWidget(self.w, 0, 1)
        g.addWidget(QtWidgets.QLabel("H (mm)"), 1, 0); g.addWidget(self.h, 1, 1)
        g.addWidget(QtWidgets.QLabel("D (mm)"), 2, 0); g.addWidget(self.d, 2, 1)
        g.addWidget(QtWidgets.QLabel("Anchor"), 3, 0); g.addWidget(self.anchor, 3, 1)

        self._sec_layout(self.secDims).addWidget(dims)
        leftLay.addWidget(self.secDims)

        # --- OFFSETS ---
        self.secPos = CollapsibleSection("Przesunięcia (offset)")
        pos = QtWidgets.QWidget()
        g2 = QtWidgets.QGridLayout(pos)
        g2.setContentsMargins(0, 0, 0, 0)
        g2.setHorizontalSpacing(10)
        g2.setVerticalSpacing(6)

        self.posL = QtWidgets.QSpinBox(); self.posL.setRange(0, 2000); self.posL.setValue(0)
        self.posR = QtWidgets.QSpinBox(); self.posR.setRange(0, 2000); self.posR.setValue(0)
        self.posT = QtWidgets.QSpinBox(); self.posT.setRange(0, 2000); self.posT.setValue(0)
        self.posB = QtWidgets.QSpinBox(); self.posB.setRange(0, 2000); self.posB.setValue(0)

        self.btnZero = QtWidgets.QPushButton("Zeruj")

        g2.addWidget(QtWidgets.QLabel("Left"), 0, 0);   g2.addWidget(self.posL, 0, 1)
        g2.addWidget(QtWidgets.QLabel("Right"), 1, 0);  g2.addWidget(self.posR, 1, 1)
        g2.addWidget(QtWidgets.QLabel("Top"), 2, 0);    g2.addWidget(self.posT, 2, 1)
        g2.addWidget(QtWidgets.QLabel("Bottom"), 3, 0); g2.addWidget(self.posB, 3, 1)
        g2.addWidget(self.btnZero, 4, 0, 1, 2)

        self._sec_layout(self.secPos).addWidget(pos)
        leftLay.addWidget(self.secPos)

        # --- MID PANELS ---
        self.secMid = CollapsibleSection("Piony środkowe (mid)")
        mid = QtWidgets.QWidget()
        gm = QtWidgets.QGridLayout(mid)
        gm.setContentsMargins(0, 0, 0, 0)
        gm.setHorizontalSpacing(10)
        gm.setVerticalSpacing(6)

        self.midA_on = QtWidgets.QCheckBox("Pion #1 (midA)")
        self.midA_x  = QtWidgets.QSpinBox(); self.midA_x.setRange(1, 4999); self.midA_x.setValue(300)

        self.midB_on = QtWidgets.QCheckBox("Pion #2 (midB)")
        self.midB_x  = QtWidgets.QSpinBox(); self.midB_x.setRange(1, 4999); self.midB_x.setValue(420)

        gm.addWidget(self.midA_on, 0, 0, 1, 2)
        gm.addWidget(QtWidgets.QLabel("X (mm)"), 1, 0); gm.addWidget(self.midA_x, 1, 1)

        line = QtWidgets.QFrame(); line.setFrameShape(QtWidgets.QFrame.HLine); line.setFrameShadow(QtWidgets.QFrame.Sunken)
        gm.addWidget(line, 2, 0, 1, 2)

        gm.addWidget(self.midB_on, 3, 0, 1, 2)
        gm.addWidget(QtWidgets.QLabel("X2 (mm)"), 4, 0); gm.addWidget(self.midB_x, 4, 1)

        hint = QtWidgets.QLabel("Półki będą liczone w segmentach: L→midA→midB→R")
        hint.setWordWrap(True)
        hint.setStyleSheet("color: #9aa0a6;")
        gm.addWidget(hint, 5, 0, 1, 2)

        self._sec_layout(self.secMid).addWidget(mid)
        leftLay.addWidget(self.secMid)

        # --- SHELVES (segments) ---
        self.secShelves = CollapsibleSection("Półki (segmenty) — między bokami i mid")
        self.shelvesBox = QtWidgets.QWidget()
        self.shelvesLay = QtWidgets.QVBoxLayout(self.shelvesBox)
        self.shelvesLay.setContentsMargins(0, 0, 0, 0)
        self.shelvesLay.setSpacing(8)

        self._sec_layout(self.secShelves).addWidget(self.shelvesBox)
        leftLay.addWidget(self.secShelves)

        leftLay.addStretch(1)

        leftScroll = QtWidgets.QScrollArea()
        leftScroll.setWidgetResizable(True)
        leftScroll.setWidget(leftWrap)

        # CENTER (view)
        center = QtWidgets.QWidget()
        cLay = QtWidgets.QVBoxLayout(center)
        cLay.setContentsMargins(0, 0, 0, 0)
        title = QtWidgets.QLabel("Widok (proto)")
        title.setStyleSheet("font-weight:800;")
        cLay.addWidget(title)

        self.scene = QtWidgets.QGraphicsScene(self)
        self.view = QtWidgets.QGraphicsView(self.scene)
        self.view.setRenderHint(QtGui.QPainter.Antialiasing, True)
        cLay.addWidget(self.view, 1)

        # RIGHT (BOM)
        right = QtWidgets.QWidget()
        rLay = QtWidgets.QVBoxLayout(right)
        rLay.setContentsMargins(0, 0, 0, 0)
        rTitle = QtWidgets.QLabel("BOM (proto)")
        rTitle.setStyleSheet("font-weight:800;")
        self.bom = QtWidgets.QPlainTextEdit()
        self.bom.setReadOnly(True)
        rLay.addWidget(rTitle)
        rLay.addWidget(self.bom, 1)

        self.split.addWidget(leftScroll)
        self.split.addWidget(center)
        self.split.addWidget(right)
        self.split.setStretchFactor(0, 0)
        self.split.setStretchFactor(1, 1)
        self.split.setStretchFactor(2, 0)
        self.split.setSizes([360, 720, 340])

    def _wire(self):
        for sp in (self.w, self.h, self.d, self.posL, self.posR, self.posT, self.posB, self.midA_x, self.midB_x):
            sp.valueChanged.connect(self._on_geom_changed)
        self.anchor.currentIndexChanged.connect(self._recalc)
        self.btnZero.clicked.connect(self._zero)

        self.midA_on.toggled.connect(self._on_geom_changed)
        self.midB_on.toggled.connect(self._on_geom_changed)

    def _on_geom_changed(self):
        self._rebuild_shelves_ui()
        self._recalc()

    def _zero(self):
        self.posL.setValue(0)
        self.posR.setValue(0)
        self.posT.setValue(0)
        self.posB.setValue(0)

    def _set_ok(self, ok: bool, msg: str = "OK"):
        if ok:
            self.status.setText("OK")
            self.status.setStyleSheet(
                "QLabel{padding:4px 10px;border-radius:10px;background:#d7ffe1;color:#000;font-weight:700;}"
            )
        else:
            self.status.setText("ERR")
            self.status.setStyleSheet(
                "QLabel{padding:4px 10px;border-radius:10px;background:#ffd6d6;color:#000;font-weight:700;}"
            )
            self.bom.setPlainText(msg)

    # ---------- segments & shelves ----------
    def _segments(self) -> List[Segment]:
        W = self.w.value()
        L = self.posL.value()
        R = self.posR.value()

        x_left = L
        x_right = max(L + 1, W - R)

        mids: List[Tuple[str, int]] = []
        if self.midA_on.isChecked():
            mids.append(("A", self.midA_x.value()))
        if self.midB_on.isChecked():
            mids.append(("B", self.midB_x.value()))

        # clamp and sort by x
        cleaned: List[Tuple[str, int]] = []
        for name, x in mids:
            x = max(x_left + 1, min(x_right - 1, x))
            cleaned.append((name, x))
        cleaned.sort(key=lambda t: t[1])

        # if A and B overlap, separate minimally
        if len(cleaned) == 2 and cleaned[0][1] >= cleaned[1][1]:
            cleaned[1] = (cleaned[1][0], cleaned[0][1] + 1)

        pts = [("L", x_left)] + cleaned + [("R", x_right)]

        out: List[Segment] = []
        for i in range(len(pts) - 1):
            a, ax = pts[i]
            b, bx = pts[i + 1]
            if bx <= ax:
                continue
            key = f"{a}-{b}"
            label = f"{a} → {b}"
            out.append(Segment(key=key, label=label, x0=ax, x1=bx))
        return out

    def _rebuild_shelves_ui(self):
        # clear old UI
        while self.shelvesLay.count():
            it = self.shelvesLay.takeAt(0)
            w = it.widget()
            if w:
                w.deleteLater()

        segs = self._segments()

        note = QtWidgets.QLabel(
            "Każdy segment ma własną ilość półek (auto, równo).\n"
            "To jest dokładnie: półki między bokami i mid-panelami."
        )
        note.setWordWrap(True)
        note.setStyleSheet("color:#9aa0a6;")
        self.shelvesLay.addWidget(note)

        self._seg_spins.clear()
        self._seg_equal_btns.clear()

        for seg in segs:
            row = QtWidgets.QWidget()
            lay = QtWidgets.QHBoxLayout(row)
            lay.setContentsMargins(0, 0, 0, 0)
            lay.setSpacing(10)

            lbl = QtWidgets.QLabel(f"Segment {seg.label}  ({seg.x1 - seg.x0} mm)")
            lbl.setMinimumWidth(180)

            sp = QtWidgets.QSpinBox()
            sp.setRange(0, 12)
            sp.setValue(self._shelf_counts.get(seg.key, 0))

            btn = QtWidgets.QPushButton("Równo")
            btn.setFixedWidth(70)

            def _mk_handlers(k: str, spin: QtWidgets.QSpinBox):
                def on_change(_v: int):
                    self._shelf_counts[k] = spin.value()
                    self._recalc()
                return on_change

            sp.valueChanged.connect(_mk_handlers(seg.key, sp))
            btn.clicked.connect(self._recalc)

            lay.addWidget(lbl, 1)
            lay.addWidget(QtWidgets.QLabel("Ilość:"), 0)
            lay.addWidget(sp, 0)
            lay.addWidget(btn, 0)

            self._seg_spins[seg.key] = sp
            self._seg_equal_btns[seg.key] = btn

            self.shelvesLay.addWidget(row)

        self.shelvesLay.addStretch(1)

    # ---------- draw + BOM ----------
    def _recalc(self):
        try:
            W, H, D = self.w.value(), self.h.value(), self.d.value()
            L, R, T, B = self.posL.value(), self.posR.value(), self.posT.value(), self.posB.value()

            innerW = max(1, W - L - R)
            innerH = max(1, H - T - B)

            # view scale
            scale = 0.60
            ow = innerW * scale
            oh = innerH * scale

            # prepare scene
            self.scene.clear()
            pen_frame = QtGui.QPen(QtGui.QColor(60, 60, 60), 2)
            pen_mid = QtGui.QPen(QtGui.QColor(120, 120, 120), 2, QtCore.Qt.DashLine)
            pen_shelf = QtGui.QPen(QtGui.QColor(160, 160, 160), 2)

            rect = QtCore.QRectF(0, 0, ow, oh)
            self.scene.addRect(rect, pen_frame)
            self.scene.setSceneRect(rect.adjusted(-20, -20, 20, 20))

            # draw mid lines
            def x_to_px(x_mm: int) -> float:
                # x_mm is absolute from left outer; opening starts at L
                return (x_mm - L) * scale

            if self.midA_on.isChecked():
                xA = max(L + 1, min(W - R - 1, self.midA_x.value()))
                self.scene.addLine(x_to_px(xA), 0, x_to_px(xA), oh, pen_mid)

            if self.midB_on.isChecked():
                xB = max(L + 1, min(W - R - 1, self.midB_x.value()))
                self.scene.addLine(x_to_px(xB), 0, x_to_px(xB), oh, pen_mid)

            # draw shelves by segments
            segs = self._segments()
            shelves_total = 0
            for seg in segs:
                n = int(self._shelf_counts.get(seg.key, 0))
                if n <= 0:
                    continue

                # equal distribution (from bottom)
                for i in range(n):
                    y_mm = (i + 1) * (innerH / (n + 1))  # height from bottom
                    y_px = oh - (y_mm * scale)

                    x0_px = (seg.x0 - L) * scale
                    x1_px = (seg.x1 - L) * scale
                    self.scene.addLine(x0_px, y_px, x1_px, y_px, pen_shelf)
                    shelves_total += 1

            # BOM
            txt = []
            txt.append(f"W/H/D: {W} / {H} / {D}")
            txt.append(f"Offsets L/R/T/B: {L} / {R} / {T} / {B}")
            txt.append(f"Anchor: {self.anchor.currentText()}")
            txt.append("")
            txt.append("MID:")
            txt.append(f"  midA: {'ON' if self.midA_on.isChecked() else 'OFF'}  X={self.midA_x.value()}")
            txt.append(f"  midB: {'ON' if self.midB_on.isChecked() else 'OFF'}  X={self.midB_x.value()}")
            txt.append("")
            txt.append("SHELVES (segments):")
            for seg in segs:
                n = int(self._shelf_counts.get(seg.key, 0))
                txt.append(f"  {seg.label}  ({seg.x1 - seg.x0}mm): {n}")
            txt.append("")
            txt.append(f"TOTAL shelves drawn: {shelves_total}")
            txt.append("")
            txt.append("NEXT (small steps): mid panel height + cap shelf/dno (left/right) -> manual shelf drag -> real BOM.")

            self.bom.setPlainText("\n".join(txt))
            self._set_ok(True)

        except Exception:
            import traceback
            self._set_ok(False, traceback.format_exc())