function defaultEdgesForKind(kind){
  if (kind==="front") return {L:"abs2",R:"abs2",T:"abs2",B:"abs2"};
  return {L:null,R:null,T:null,B:null};
}
function mkPart(id,name,kind,mat,dimW,dimH,meta={}){
  return { id,name,kind,mat,dimW,dimH, edges: defaultEdgesForKind(kind), meta };
}

function parseHeightsList(s){
  const arr = String(s||"").split(",").map(x=>Number(x.trim())).filter(x=>Number.isFinite(x) && x>0);
  return arr;
}

// __COMPAT_MID__
(function ensureCompatModel(){
  try{
    const m = state && state.model ? state.model : null;
    if (!m) return;

    // BACK compat
    if (!m.back) m.back = { enabled:true, mat:"hdf3" };

    // MID compat (stare UI/boot oczekuje m.mid.enabled)
    if (!m.mid) {
      if (m.midA) m.mid = { ...m.midA };
      else m.mid = { enabled:false, x:300, mat:"pb18", offT:0, offB:0 };
    } else {
      // jeśli istnieje, dopnij brakujące pola
      if (m.mid.offT == null) m.mid.offT = 0;
      if (m.mid.offB == null) m.mid.offB = 0;
    }

    // drugi pion jako mid2 (na razie bez UI – ale niech istnieje)
    if (!m.mid2) {
      if (m.midB) m.mid2 = { ...m.midB };
      else m.mid2 = { enabled:false, x:420, mat:"pb18", offT:0, offB:0 };
    } else {
      if (m.mid2.offT == null) m.mid2.offT = 0;
      if (m.mid2.offB == null) m.mid2.offB = 0;
    }
  }catch(e){
    console.warn("ensureCompatModel failed", e);
  }
})();
