/* If missing, provide safe default hinge count per door height (mm) */
function computeHingesPerDoor(doorH, hingeType){
  try{
    const h = Math.max(0, Math.round(Number(doorH)||0));
    // very safe heuristic (can refine later)
    if(h <= 900) return 2;
    if(h <= 1500) return 3;
    return 4;
  }catch(e){
    return 2;
  }
}
