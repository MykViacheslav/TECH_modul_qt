  function loadGroups(){
    try{
      const g = JSON.parse(localStorage.getItem(KEY_GROUP) || "null");
      if (Array.isArray(g) && g.length) return g;
    }catch{}
    localStorage.setItem(KEY_GROUP, JSON.stringify(defaultGroups));
    return [...defaultGroups];
  }
