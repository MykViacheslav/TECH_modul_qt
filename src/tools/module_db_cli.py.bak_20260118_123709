import argparse, json, os, sqlite3
from datetime import datetime

SCHEMA_VERSION = 1

def now_iso():
    return datetime.utcnow().replace(microsecond=0).isoformat() + "Z"

def connect(db_path: str):
    os.makedirs(os.path.dirname(db_path), exist_ok=True)
    con = sqlite3.connect(db_path)
    con.row_factory = sqlite3.Row
    return con

def table_exists(con: sqlite3.Connection, name: str) -> bool:
    row = con.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name=?",
        (name,)
    ).fetchone()
    return row is not None

def table_cols(con: sqlite3.Connection, name: str):
    return [r["name"] for r in con.execute(f"PRAGMA table_info({name})").fetchall()]

def create_modules(con: sqlite3.Connection):
    con.execute("""
    CREATE TABLE IF NOT EXISTS modules (
        anchor TEXT PRIMARY KEY,
        payload_json TEXT NOT NULL,
        schema_version INTEGER NOT NULL,
        created_at TEXT NOT NULL,
        updated_at TEXT NOT NULL
    )
    """)

def create_modules_history(con: sqlite3.Connection):
    con.execute("""
    CREATE TABLE IF NOT EXISTS modules_history (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        anchor TEXT NOT NULL,
        payload_json TEXT NOT NULL,
        schema_version INTEGER NOT NULL,
        saved_at TEXT NOT NULL
    )
    """)

def migrate_modules(con: sqlite3.Connection):
    expected = {"anchor","payload_json","schema_version","created_at","updated_at"}
    if not table_exists(con, "modules"):
        create_modules(con)
        return

    cols = set(table_cols(con, "modules"))
    if cols == expected:
        return

    legacy = f"modules_legacy_{datetime.utcnow().strftime('%Y%m%d_%H%M%S')}"
    con.execute(f'ALTER TABLE "modules" RENAME TO "{legacy}"')
    create_modules(con)

    lcols = set(table_cols(con, legacy))
    anchor_expr = "anchor" if "anchor" in lcols else ("name" if "name" in lcols else ("('LEGACY_' || id)" if "id" in lcols else "'LEGACY'"))
    payload_expr = "payload_json" if "payload_json" in lcols else ("payload" if "payload" in lcols else "'{}'")
    schema_expr  = "schema_version" if "schema_version" in lcols else str(SCHEMA_VERSION)
    created_expr = "created_at" if "created_at" in lcols else f"'{now_iso()}'"
    updated_expr = "updated_at" if "updated_at" in lcols else f"'{now_iso()}'"

    con.execute(f"""
        INSERT OR REPLACE INTO modules(anchor, payload_json, schema_version, created_at, updated_at)
        SELECT
            TRIM(COALESCE({anchor_expr}, '')),
            COALESCE({payload_expr}, '{{}}'),
            COALESCE({schema_expr}, {SCHEMA_VERSION}),
            COALESCE({created_expr}, '{now_iso()}'),
            COALESCE({updated_expr}, '{now_iso()}')
        FROM {legacy}
        WHERE TRIM(COALESCE({anchor_expr}, '')) <> ''
    """)

def migrate_modules_history(con: sqlite3.Connection):
    expected = {"id","anchor","payload_json","schema_version","saved_at"}
    if not table_exists(con, "modules_history"):
        create_modules_history(con)
        return

    cols = set(table_cols(con, "modules_history"))
    if cols == expected:
        return

    legacy = f"modules_history_legacy_{datetime.utcnow().strftime('%Y%m%d_%H%M%S')}"
    con.execute(f'ALTER TABLE "modules_history" RENAME TO "{legacy}"')
    create_modules_history(con)

    lcols = set(table_cols(con, legacy))
    # heurystyki dla starych schematow
    anchor_expr = (
        "anchor" if "anchor" in lcols else
        ("module_anchor" if "module_anchor" in lcols else
         ("name" if "name" in lcols else "'LEGACY'"))
    )
    payload_expr = "payload_json" if "payload_json" in lcols else ("payload" if "payload" in lcols else "'{}'")
    schema_expr  = "schema_version" if "schema_version" in lcols else str(SCHEMA_VERSION)
    saved_expr   = (
        "saved_at" if "saved_at" in lcols else
        ("created_at" if "created_at" in lcols else
         ("updated_at" if "updated_at" in lcols else f"'{now_iso()}'"))
    )

    con.execute(f"""
        INSERT INTO modules_history(anchor, payload_json, schema_version, saved_at)
        SELECT
            TRIM(COALESCE({anchor_expr}, '')),
            COALESCE({payload_expr}, '{{}}'),
            COALESCE({schema_expr}, {SCHEMA_VERSION}),
            COALESCE({saved_expr}, '{now_iso()}')
        FROM {legacy}
        WHERE TRIM(COALESCE({anchor_expr}, '')) <> ''
    """)

def ensure_schema(con: sqlite3.Connection):
    # migrate if needed, then ensure tables exist
    migrate_modules(con)
    migrate_modules_history(con)
    create_modules(con)
    create_modules_history(con)
    con.commit()

def upsert(con: sqlite3.Connection, payload: dict, overwrite: bool, history: bool):
    ensure_schema(con)
    anchor = str(payload.get("anchor") or "").strip()
    if not anchor:
        raise SystemExit("ERROR: anchor is required")

    row = con.execute("SELECT anchor, created_at FROM modules WHERE anchor = ?", (anchor,)).fetchone()
    created_at = row["created_at"] if row else now_iso()
    updated_at = now_iso()

    payload = dict(payload)
    payload["anchor"] = anchor
    payload["schema_version"] = SCHEMA_VERSION

    payload_json = json.dumps(payload, ensure_ascii=False)

    if row and not overwrite:
        return anchor, False, True

    con.execute("""
        INSERT INTO modules(anchor, payload_json, schema_version, created_at, updated_at)
        VALUES(?,?,?,?,?)
        ON CONFLICT(anchor) DO UPDATE SET
            payload_json=excluded.payload_json,
            schema_version=excluded.schema_version,
            updated_at=excluded.updated_at
    """, (anchor, payload_json, SCHEMA_VERSION, created_at, updated_at))

    if history:
        con.execute("""
            INSERT INTO modules_history(anchor, payload_json, schema_version, saved_at)
            VALUES(?,?,?,?)
        """, (anchor, payload_json, SCHEMA_VERSION, updated_at))

    con.commit()
    return anchor, True, False

def cmd_init(args):
    con = connect(args.db)
    ensure_schema(con)
    print(f"OK: DB initialized: {args.db}")
    return 0

def cmd_save(args):
    con = connect(args.db)
    payload = {
        "anchor": args.anchor,
        "name": args.name,
        "width": args.width,
        "height": args.height,
        "depth": args.depth,
        "materials": args.materials,
    }
    payload = {k:v for k,v in payload.items() if v is not None and v != ""}

    anchor, saved, existed_no_overwrite = upsert(
        con, payload,
        overwrite=bool(args.overwrite),
        history=not bool(args.no_history)
    )

    if existed_no_overwrite:
        print(f"ERROR: '{anchor}' already exists. Use --overwrite.")
        return 2

    if saved and args.overwrite:
        print(f"OK: saved '{anchor}' (overwritten)")
    else:
        print(f"OK: saved '{anchor}'")
    return 0

def cmd_get(args):
    con = connect(args.db)
    ensure_schema(con)
    row = con.execute("SELECT payload_json FROM modules WHERE anchor = ?", (args.anchor,)).fetchone()
    if not row:
        print("ERROR: not found")
        return 4
    obj = json.loads(row["payload_json"])
    print(json.dumps(obj, ensure_ascii=False, indent=2))
    return 0

def cmd_list(args):
    con = connect(args.db)
    ensure_schema(con)
    limit = int(args.limit) if args.limit is not None else 200
    if limit <= 0:
        limit = 200
    rows = con.execute(
        "SELECT payload_json FROM modules ORDER BY updated_at DESC LIMIT ?",
        (limit,)
    ).fetchall()
    out = [json.loads(r["payload_json"]) for r in rows]
    print(json.dumps(out, ensure_ascii=False, indent=2))
    return 0

def cmd_delete(args):
    con = connect(args.db)
    ensure_schema(con)
    cur = con.execute("DELETE FROM modules WHERE anchor = ?", (args.anchor,))
    con.commit()
    if cur.rowcount:
        print(f"OK: deleted '{args.anchor}'")
        return 0
    print("OK: not found")
    return 0

def build_parser():
    p = argparse.ArgumentParser(prog="module_db_cli")
    p.add_argument("--db", required=True)

    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("init")
    s.set_defaults(fn=cmd_init)

    s = sub.add_parser("save")
    s.add_argument("--anchor", required=True)
    s.add_argument("--name", default="")
    s.add_argument("--width", type=float)
    s.add_argument("--height", type=float)
    s.add_argument("--depth", type=float)
    s.add_argument("--materials", default="")
    s.add_argument("--overwrite", action="store_true")
    s.add_argument("--no-history", action="store_true")
    s.set_defaults(fn=cmd_save)

    s = sub.add_parser("get")
    s.add_argument("--anchor", required=True)
    s.set_defaults(fn=cmd_get)

    s = sub.add_parser("list")
    s.add_argument("--limit", type=int, default=200)
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("delete")
    s.add_argument("--anchor", required=True)
    s.set_defaults(fn=cmd_delete)

    return p

def main(argv=None):
    p = build_parser()
    args = p.parse_args(argv)
    return args.fn(args)

if __name__ == "__main__":
    raise SystemExit(main())
