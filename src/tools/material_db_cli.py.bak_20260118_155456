import argparse, json, os, sqlite3
from datetime import datetime

SCHEMA_VERSION = 1

def now_iso():
    return datetime.utcnow().replace(microsecond=0).isoformat() + "Z"

def connect(db_path: str):
    os.makedirs(os.path.dirname(db_path), exist_ok=True)
    con = sqlite3.connect(db_path)
    con.row_factory = sqlite3.Row
    return con

def table_cols(con, name):
    return [r["name"] for r in con.execute(f"PRAGMA table_info({name})").fetchall()]

def ensure_schema(con: sqlite3.Connection):
    con.execute("""
    CREATE TABLE IF NOT EXISTS materials (
        anchor TEXT PRIMARY KEY,
        name TEXT NOT NULL,
        kind TEXT NOT NULL,
        thickness_mm REAL NOT NULL DEFAULT 0,
        payload_json TEXT NOT NULL,
        schema_version INTEGER NOT NULL,
        created_at TEXT NOT NULL,
        updated_at TEXT NOT NULL
    )
    """)
    con.execute("""
    CREATE TABLE IF NOT EXISTS materials_history (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        anchor TEXT NOT NULL,
        payload_json TEXT NOT NULL,
        schema_version INTEGER NOT NULL,
        saved_at TEXT NOT NULL
    )
    """)
    con.commit()

def _ensure_history_schema(con: sqlite3.Connection):
    cols = table_cols(con, "materials_history")
    if "saved_at" not in cols:
        legacy = "materials_history_legacy_" + datetime.utcnow().strftime("%Y%m%d_%H%M%S")
        con.execute(f"ALTER TABLE materials_history RENAME TO {legacy}")
        con.execute("""
        CREATE TABLE IF NOT EXISTS materials_history (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            anchor TEXT NOT NULL,
            payload_json TEXT NOT NULL,
            schema_version INTEGER NOT NULL,
            saved_at TEXT NOT NULL
        )
        """)
        legacy_cols = table_cols(con, legacy)
        if set(["anchor","payload_json","schema_version"]).issubset(set(legacy_cols)):
            saved_col = None
            for cand in ("saved_at","created_at","updated_at","ts","time"):
                if cand in legacy_cols:
                    saved_col = cand
                    break
            if saved_col:
                con.execute(
                    f"INSERT INTO materials_history(anchor,payload_json,schema_version,saved_at) "
                    f"SELECT anchor,payload_json,schema_version,{saved_col} FROM {legacy}"
                )
            else:
                now = now_iso()
                rows = con.execute(f"SELECT anchor,payload_json,schema_version FROM {legacy}").fetchall()
                for r in rows:
                    con.execute(
                        "INSERT INTO materials_history(anchor,payload_json,schema_version,saved_at) VALUES(?,?,?,?)",
                        (r["anchor"], r["payload_json"], r["schema_version"], now)
                    )
        con.commit()

def upsert(con: sqlite3.Connection, payload: dict, overwrite: bool, history: bool):
    ensure_schema(con)
    _ensure_history_schema(con)

    anchor = str(payload.get("anchor") or "").strip()
    if not anchor:
        raise SystemExit("ERROR: anchor is required")

    row = con.execute("SELECT anchor, created_at FROM materials WHERE anchor = ?", (anchor,)).fetchone()
    created_at = row["created_at"] if row else now_iso()
    updated_at = now_iso()

    payload = dict(payload)
    payload["anchor"] = anchor
    payload["schema_version"] = SCHEMA_VERSION

    # normalize
    name = str(payload.get("name") or "").strip()
    kind = str(payload.get("kind") or "").strip()
    thick = payload.get("thickness_mm")
    if thick is None:
        thick = 0.0
    try:
        thick = float(thick)
    except Exception:
        thick = 0.0

    if not name:
        name = anchor
        payload["name"] = name
    if not kind:
        kind = "UNKNOWN"
        payload["kind"] = kind
    payload["thickness_mm"] = thick

    payload_json = json.dumps(payload, ensure_ascii=False)

    if row and not overwrite:
        return anchor, False, True

    con.execute("""
        INSERT INTO materials(anchor, name, kind, thickness_mm, payload_json, schema_version, created_at, updated_at)
        VALUES(?,?,?,?,?,?,?,?)
        ON CONFLICT(anchor) DO UPDATE SET
            name=excluded.name,
            kind=excluded.kind,
            thickness_mm=excluded.thickness_mm,
            payload_json=excluded.payload_json,
            schema_version=excluded.schema_version,
            updated_at=excluded.updated_at
    """, (anchor, name, kind, thick, payload_json, SCHEMA_VERSION, created_at, updated_at))

    if history:
        con.execute("""
            INSERT INTO materials_history(anchor, payload_json, schema_version, saved_at)
            VALUES(?,?,?,?)
        """, (anchor, payload_json, SCHEMA_VERSION, updated_at))

    con.commit()
    return anchor, True, False

def cmd_init(args):
    con = connect(args.db)
    ensure_schema(con)
    _ensure_history_schema(con)
    print(f"OK: materials DB initialized: {args.db}")
    return 0

def cmd_save(args):
    con = connect(args.db)
    payload = {
        "anchor": args.anchor,
        "name": args.name,
        "kind": args.kind,
        "thickness_mm": args.thickness,
        "notes": args.notes or "",
    }
    # optional: composite layers JSON
    if args.layers_json:
        try:
            payload["layers"] = json.loads(args.layers_json)
        except Exception:
            raise SystemExit("ERROR: --layers-json must be valid JSON")

    payload = {k:v for k,v in payload.items() if v is not None and v != ""}

    anchor, saved, existed_no_overwrite = upsert(
        con, payload, overwrite=bool(args.overwrite), history=not bool(args.no_history)
    )
    if existed_no_overwrite:
        print(f"ERROR: '{anchor}' already exists. Use --overwrite.")
        return 2

    if saved and args.overwrite:
        print(f"OK: saved material '{anchor}' (overwritten)")
    else:
        print(f"OK: saved material '{anchor}'")
    return 0

def cmd_get(args):
    con = connect(args.db)
    ensure_schema(con)
    _ensure_history_schema(con)
    row = con.execute("SELECT payload_json FROM materials WHERE anchor = ?", (args.anchor,)).fetchone()
    if not row:
        print("ERROR: not found")
        return 4
    obj = json.loads(row["payload_json"])
    print(json.dumps(obj, ensure_ascii=False, indent=2))
    return 0

def cmd_list(args):
    con = connect(args.db)
    ensure_schema(con)
    _ensure_history_schema(con)
    limit = int(args.limit) if args.limit is not None else 200
    if limit <= 0:
        limit = 200
    rows = con.execute(
        "SELECT anchor, name, kind, thickness_mm, payload_json FROM materials ORDER BY updated_at DESC LIMIT ?",
        (limit,)
    ).fetchall()
    out = []
    for r in rows:
        obj = json.loads(r["payload_json"])
        # ensure quick fields exist
        obj.setdefault("anchor", r["anchor"])
        obj.setdefault("name", r["name"])
        obj.setdefault("kind", r["kind"])
        obj.setdefault("thickness_mm", r["thickness_mm"])
        out.append(obj)
    print(json.dumps(out, ensure_ascii=False, indent=2))
    return 0

def cmd_delete(args):
    con = connect(args.db)
    ensure_schema(con)
    _ensure_history_schema(con)
    cur = con.execute("DELETE FROM materials WHERE anchor = ?", (args.anchor,))
    con.commit()
    if cur.rowcount:
        print(f"OK: deleted material '{args.anchor}'")
    else:
        print("OK: not found")
    return 0

def _score(q_tokens, anchor, name):
    a = (anchor or "").upper()
    n = (name or "").upper()
    score = 0
    for t in q_tokens:
        if not t:
            continue
        if a == t:
            score += 100
        if a.startswith(t):
            score += 50
        if t in a:
            score += 25
        if t in n:
            score += 20
    return score

def cmd_suggest(args):
    con = connect(args.db)
    ensure_schema(con)
    _ensure_history_schema(con)

    q = (args.q or "").strip()
    if not q:
        print("[]")
        return 0
    q_tokens = [t.strip().upper() for t in q.replace(",", " ").split() if t.strip()]

    rows = con.execute("SELECT anchor, name, kind, thickness_mm FROM materials").fetchall()
    scored = []
    for r in rows:
        sc = _score(q_tokens, r["anchor"], r["name"])
        if sc > 0:
            scored.append((sc, r))
    scored.sort(key=lambda x: (-x[0], str(x[1]["anchor"])))

    limit = int(args.limit) if args.limit else 10
    if limit <= 0:
        limit = 10

    out = []
    for idx, (sc, r) in enumerate(scored[:limit], start=1):
        out.append({
            "idx": idx,
            "anchor": r["anchor"],
            "name": r["name"],
            "kind": r["kind"],
            "thickness_mm": r["thickness_mm"],
            "score": sc
        })
    print(json.dumps(out, ensure_ascii=False, indent=2))
    return 0

def build_parser():
    p = argparse.ArgumentParser(prog="material_db_cli")
    p.add_argument("--db", required=True)

    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("init")
    s.set_defaults(fn=cmd_init)

    s = sub.add_parser("save")
    s.add_argument("--anchor", required=True)
    s.add_argument("--name", default="")
    s.add_argument("--kind", default="UNKNOWN")
    s.add_argument("--thickness", type=float, default=0.0)
    s.add_argument("--notes", default="")
    s.add_argument("--layers-json", default="")
    s.add_argument("--overwrite", action="store_true")
    s.add_argument("--no-history", action="store_true")
    s.set_defaults(fn=cmd_save)

    s = sub.add_parser("get")
    s.add_argument("--anchor", required=True)
    s.set_defaults(fn=cmd_get)

    s = sub.add_parser("list")
    s.add_argument("--limit", type=int, default=200)
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("delete")
    s.add_argument("--anchor", required=True)
    s.set_defaults(fn=cmd_delete)

    s = sub.add_parser("suggest")
    s.add_argument("--q", required=True)
    s.add_argument("--limit", type=int, default=10)
    s.set_defaults(fn=cmd_suggest)

    return p

def main(argv=None):
    p = build_parser()
    args = p.parse_args(argv)
    return args.fn(args)

if __name__ == "__main__":
    raise SystemExit(main())
